package views

import "fmt"

// Page identifies what the SSE stream should render.
type Page struct {
	View        string // "home" | "thread" | "settings" | "usage"
	ThreadID    string
	Theme       string
	UsageDays   int
	UsageMetric string
}

func (p Page) streamURL() string {
	if p.View == "thread" {
		return fmt.Sprintf("/events?view=thread&id=%s", p.ThreadID)
	}
	if p.View == "settings" {
		return "/events?view=settings"
	}
	if p.View == "usage" {
		return fmt.Sprintf("/events?view=usage&days=%d&metric=%s", p.UsageDays, p.UsageMetric)
	}
	return "/events?view=home"
}

templ Layout(title string, p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ p.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			@PageTitle(title)
			<link rel="icon" href={ asset("/static/favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ asset("/static/app.css") }/>
			<script type="module" src={ asset("/static/datastar.js") }></script>
			if p.View == "thread" {
				<link rel="stylesheet" href={ asset("/static/xterm.css") }/>
				<script defer src={ asset("/static/xterm.js") }></script>
				<script defer src={ asset("/static/xterm-addon-fit.js") }></script>
				<script defer src={ asset("/static/term.js") }></script>
			}
		</head>
		<body
			data-signals={ fmt.Sprintf(`{nav: false, git: %t && innerWidth > 1100, term: false, theme: %q, prompt: '', path: '', q: '', addproj: false, panelTab: 'changes', gitPath: '', gitEdit: false, file: '', upload: [], attach: [], _hb: 0}`, p.View == "thread", p.Theme) }
			data-attr:data-theme="$theme"
			data-init={ fmt.Sprintf("@get('%s', {openWhenHidden: true, retryMaxCount: 1000})", p.streamURL()) }
		>
			<div class="shell">
				<aside id="sidebar" data-class:open="$nav">
					<div class="dim pad">loading…</div>
				</aside>
				<div class="backdrop" data-show="$nav || $git" data-on:click="$nav = false; $git = false"></div>
				<div class="mid">
					<main id="main">
						<div class="dim pad">connecting…</div>
					</main>
					if p.View == "thread" {
						@TermPanel(p.ThreadID)
					}
				</div>
				<aside id="gitpanel" data-class:open="$git"></aside>
			</div>
			<div id="toast"></div>
			<datalist id="project-paths"></datalist>
			// Keep the transcript pinned to the bottom while it streams, but
			// only if the reader has not scrolled up to look at something.
			<script>
				(() => {
					const near = (m) => m.scrollHeight - m.scrollTop - m.clientHeight < 160;
					let stick = true;
					document.addEventListener('scroll', (e) => {
						if (e.target && e.target.id === 'items') stick = near(e.target);
					}, true);
					new MutationObserver(() => {
						const m = document.getElementById('items');
						if (m && stick) m.scrollTop = m.scrollHeight;
					}).observe(document.body, { childList: true, subtree: true, characterData: true });
				})();
			</script>
			// Pasting or dropping files on a composer adds them to its attach
			// input (merged with what is already picked) and fires a change
			// event so the Datastar binding lifts them into the signal.
			<script>
				(() => {
					const addFiles = (target, files) => {
						const form = target instanceof Element && target.closest('form.composer');
						const input = form && form.querySelector('input[type=file]');
						if (!input || !files.length) return false;
						const merged = new DataTransfer();
						for (const f of input.files) merged.items.add(f);
						for (const f of files) merged.items.add(f);
						input.files = merged.files;
						input.dispatchEvent(new Event('change', { bubbles: true }));
						return true;
					};
					document.addEventListener('paste', (e) => {
						if (e.target instanceof HTMLTextAreaElement && e.target.classList.contains('prompt')
							&& e.clipboardData && addFiles(e.target, e.clipboardData.files)) e.preventDefault();
					});
					// The strip above the composer row: one removable item per
					// picked file, rebuilt from the input on every change
					// (picker, paste, and drop all end in one).
					const removeFile = (input, index) => {
						const kept = new DataTransfer();
						[...input.files].forEach((f, i) => { if (i !== index) kept.items.add(f); });
						input.files = kept.files;
						input.dispatchEvent(new Event('change', { bubbles: true }));
					};
					const renderStrip = (input) => {
						const box = input.closest('form.composer')?.querySelector('.attach-thumbs');
						if (!box) return;
						box.replaceChildren(...[...input.files].map((f, i) => {
							const item = document.createElement('div');
							if (f.type.startsWith('image/')) {
								item.className = 'attach-item';
								const img = document.createElement('img');
								img.src = URL.createObjectURL(f);
								img.onload = () => URL.revokeObjectURL(img.src);
								img.alt = img.title = f.name;
								item.append(img);
							} else {
								item.className = 'attach-item file';
								item.append(Object.assign(document.createElement('span'), { className: 'ellipsis', textContent: f.name }));
							}
							const x = Object.assign(document.createElement('button'), {
								type: 'button', className: 'attach-remove', title: 'Remove ' + f.name, textContent: '×',
							});
							x.addEventListener('click', () => removeFile(input, i));
							item.append(x);
							return item;
						}));
					};
					document.addEventListener('change', (e) => {
						if (e.target instanceof HTMLInputElement && e.target.type === 'file') renderStrip(e.target);
					});
					// A morphed composer comes back with an empty strip while
					// the input still holds files; refill it.
					new MutationObserver(() => {
						for (const input of document.querySelectorAll('form.composer input[type=file]')) {
							const box = input.closest('form.composer').querySelector('.attach-thumbs');
							if (box && !box.childElementCount && input.files.length) renderStrip(input);
						}
					}).observe(document.body, { childList: true, subtree: true });
					document.addEventListener('dragover', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (c && e.dataTransfer && e.dataTransfer.types.includes('Files')) {
							e.preventDefault();
							c.classList.add('dropping');
						}
					});
					document.addEventListener('dragleave', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (c && !(e.relatedTarget instanceof Node && c.contains(e.relatedTarget))) c.classList.remove('dropping');
					});
					document.addEventListener('drop', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (!c) return;
						c.classList.remove('dropping');
						if (e.dataTransfer && addFiles(e.target, e.dataTransfer.files)) e.preventDefault();
					});
				})();
			</script>
			<script>
				(() => {
					let timer, controller;
					const update = (input) => {
						clearTimeout(timer);
						timer = setTimeout(async () => {
							controller?.abort();
							controller = new AbortController();
							try {
								const response = await fetch('/api/project-paths?path=' + encodeURIComponent(input.value), { signal: controller.signal });
								if (!response.ok) return;
								const paths = await response.json();
								const list = document.getElementById('project-paths');
								list.replaceChildren(...paths.map((path) => Object.assign(document.createElement('option'), { value: path })));
							} catch (error) {
								if (error.name !== 'AbortError') console.warn('project path completion failed', error);
							}
						}, 100);
					};
					document.addEventListener('input', (event) => {
						if (event.target instanceof HTMLInputElement && event.target.classList.contains('project-path')) update(event.target);
					});
					document.addEventListener('focusin', (event) => {
						if (event.target instanceof HTMLInputElement && event.target.classList.contains('project-path')) update(event.target);
					});
				})();
			</script>
			if p.View == "usage" {
				// The usage view is replaced by the live stream, so chart events are
				// delegated from the document instead of bound to one render.
				<script>
					(() => {
						const chartHit = (target) => target instanceof Element && target.closest('.usage-chart-hit');
						const hide = (chart) => {
							if (!chart) return;
							const cursor = chart.querySelector('.usage-chart-cursor');
							if (cursor) cursor.hidden = true;
							for (const tip of chart.querySelectorAll('.usage-chart-tip')) tip.hidden = true;
						};
						const hideAll = () => {
							for (const chart of document.querySelectorAll('.usage-chart')) hide(chart);
						};
						const show = (hit) => {
							const chart = hit.closest('.usage-chart');
							if (!chart || !chart.clientWidth) return;
							const index = hit.dataset.usageIndex;
							const svgX = Number(hit.dataset.usageX);
							const left = svgX / 800 * chart.clientWidth;
							const cursor = chart.querySelector('.usage-chart-cursor');
							if (cursor) {
								cursor.style.left = left + 'px';
								cursor.hidden = false;
							}
							for (const item of chart.querySelectorAll('.usage-chart-tip')) item.hidden = true;
							const tip = [...chart.querySelectorAll('.usage-chart-tip')]
								.find((item) => item.dataset.usageTip === index);
							if (!tip) return;
							tip.hidden = false;
							const half = tip.offsetWidth / 2 + 7;
							tip.style.left = Math.max(half, Math.min(chart.clientWidth - half, left)) + 'px';
						};
						document.addEventListener('pointerover', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
						});
						document.addEventListener('pointerout', (event) => {
							const hit = chartHit(event.target);
							if (!hit) return;
							const target = hit.closest('.usage-chart-target');
							if (!(event.relatedTarget instanceof Node && target.contains(event.relatedTarget))) {
								hide(hit.closest('.usage-chart'));
							}
						});
						document.addEventListener('focusin', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
						});
						document.addEventListener('focusout', (event) => {
							const hit = chartHit(event.target);
							if (hit && !(event.relatedTarget instanceof Node && hit.closest('.usage-chart-target').contains(event.relatedTarget))) {
								hide(hit.closest('.usage-chart'));
							}
						});
						document.addEventListener('click', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
							else hideAll();
						});
						document.addEventListener('keydown', (event) => {
							const hit = chartHit(event.target);
							if (hit && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
								const hits = [...hit.closest('.usage-chart').querySelectorAll('.usage-chart-hit')];
								const direction = event.key === 'ArrowLeft' ? -1 : 1;
								const next = hits[Math.max(0, Math.min(hits.length - 1, hits.indexOf(hit) + direction))];
								next?.focus();
								event.preventDefault();
							} else if (event.key === 'Escape') {
								hideAll();
								hit?.blur();
							}
						});
					})();
				</script>
			}
		</body>
	</html>
}

templ PageTitle(title string) {
	<title id="page-title">{ title } · starcode</title>
}

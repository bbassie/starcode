package views

import (
	"encoding/json"
	"fmt"
	"os"
	"os/user"
	"starcode/internal/store"
	"sync"
)

// Page identifies what the SSE stream should render.
type Page struct {
	View        string // "home" | "thread" | "prs" | "settings" | "appearance" | "usage" | "providers" | "keys"
	ThreadID    string
	Theme       string
	UsageDays   int
	UsageMetric string
	ProviderSel string
	ProviderTab string
	// Draft is the saved composer text for this page (thread or home),
	// the initial value of the prompt signal.
	Draft string
	// GitPath and GitEdit are the side panel's open diff or file, read
	// from the page's signals when its stream (re)connects, so the redraw
	// on connect puts the detail back instead of clearing it.
	GitPath string
	GitEdit bool
	// PanelTab is the side panel's tab the same way; with the tree open
	// the redraw carries the root listing instead of an empty tree.
	PanelTab string
	// Full is whether the page had loaded the whole transcript, so a
	// redraw keeps it instead of cutting it again (see views.SplitTail).
	Full bool
	// PairURL is the settings page's sign-in link for a phone.
	PairURL string
	// Sidebar is the sidebar layout, "inbox" or "project"; Dense its
	// one-line rows.
	Sidebar string
	Dense   bool
}

// draftJSON is the draft as a JS string literal for the signals object.
func draftJSON(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// runUser is the account starcode runs as. Opening a thread in VS Code
// over SSH logs in as that account by default, since the folders are its.
var runUser = sync.OnceValue(func() string {
	if u, err := user.Current(); err == nil {
		return u.Username
	}
	return os.Getenv("USER")
})

// streamURL carries the asset version the page was served with, so a
// stream that reconnects to a rebuilt server can tell the page to reload
// instead of morphing new markup into old CSS.
// streamOpen is the expression that opens the page's stream. The request
// resolves when the stream ends, which is when streamEnded (layout script)
// schedules the next one.
func streamOpen(p Page) string {
	return fmt.Sprintf("@get('%s', {openWhenHidden: true, retryMaxCount: 1000}).then(() => streamEnded(), () => streamEnded())", p.streamURL())
}

func (p Page) streamURL() string {
	url := "/events?view=home"
	switch p.View {
	case "thread":
		url = fmt.Sprintf("/events?view=thread&id=%s", p.ThreadID)
	case "settings":
		url = "/events?view=settings"
	case "appearance":
		url = "/events?view=appearance"
	case "prs":
		url = "/events?view=prs"
	case "keys":
		url = "/events?view=keys"
	case "providers":
		url = fmt.Sprintf("/events?view=providers&sel=%s&tab=%s", p.ProviderSel, p.ProviderTab)
	case "usage":
		url = fmt.Sprintf("/events?view=usage&days=%d&metric=%s", p.UsageDays, p.UsageMetric)
	}
	return url + "&v=" + assetVersion
}

// Parts are the regions the page handler renders into the document. A nil
// part leaves a placeholder for the stream to fill.
type Parts struct {
	Sidebar templ.Component
	Main    templ.Component
	Git     templ.Component
	Update  templ.Component
	// Thread is the data behind Main on the thread view.
	Thread *ThreadData
	// Projects, in sidebar order, for the hotkeys of pages without a
	// thread.
	Projects []store.Project
}

templ Layout(title string, p Page, parts Parts) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ p.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content"/>
			<meta name="color-scheme" content="dark light"/>
			// Installable from a phone's "add to home screen": the manifest
			// asks for a standalone window and the theme-color script below
			// keeps the system bars in the current theme's background.
			<meta name="theme-color" content="#08090b"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<meta name="apple-mobile-web-app-title" content="starcode"/>
			<link rel="manifest" href={ asset("/static/manifest.webmanifest") }/>
			@PageTitle(title)
			<link rel="icon" href={ asset("/static/favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ asset("/static/app.css") }/>
			<script type="module" src={ asset("/static/datastar.js") }></script>
			// Copying out of a rendered reply or PR body yields markdown.
			<script defer src={ asset("/static/mdcopy.js") }></script>
			<script defer src={ asset("/static/slash.js") }></script>
			if p.View == "thread" {
				<link rel="stylesheet" href={ asset("/static/xterm.css") }/>
				<script defer src={ asset("/static/xterm.js") }></script>
				<script defer src={ asset("/static/xterm-addon-fit.js") }></script>
				<script defer src={ asset("/static/term.js") }></script>
				<script defer src={ asset("/static/highlight.js") }></script>
			}
		</head>
		<body
			data-signals={ fmt.Sprintf(`{nav: false, git: %t && innerWidth > 1100, term: false, theme: %q, prompt: %s, path: '', q: '', addproj: false, panelTab: 'changes', gitPath: '', gitEdit: false, _file: '', _upload: [], _attach: [], pick: '', pickq: '', rename: false, title: '', palette: false, pq: '', help: false, navhide: false, wide: localStorage.getItem('panel-wide') === '1', updir: '', pr: 0, prsel: 0, prproject: '', more: false, stat: false, full: false, mainv: '', sidev: '', settledAll: false, tid: %q, _hb: 0}`, p.View == "thread", p.Theme, draftJSON(p.Draft), p.ThreadID) }
			data-attr:data-theme="$theme"
			data-class:nav-collapsed="$navhide"
			data-class:panel-wide="$wide"
			data-init={ streamOpen(p) }
			data-on:stream__window={ streamOpen(p) }
			data-effect="$_hb; streamAlive()"
		>
			// The icon sprite first, so every <use> below finds its symbol
			// as the page paints.
			@templ.Raw(SpriteInline())
			<div class="shell">
				if parts.Sidebar != nil {
					@parts.Sidebar
				} else {
					<aside id="sidebar" data-class:open="$nav" data-preserve-attr="style">
						<div class="dim pad">loading…</div>
					</aside>
				}
				if section := settingsSection(p.View); section != "" {
					@SettingsSidebar(section)
				}
				<div class="backdrop" data-show="$nav || $git" data-preserve-attr="style" style="display: none" data-on:click="$nav = false; $git = false"></div>
				<div class="mid">
					if parts.Update != nil {
						@parts.Update
					} else {
						<div id="update"></div>
					}
					if parts.Main != nil {
						@parts.Main
					} else {
						<main id="main">
							<div class="dim pad">connecting…</div>
						</main>
					}
					if p.View == "thread" {
						@TermPanel(p.ThreadID)
					}
				</div>
				if parts.Git != nil {
					@parts.Git
				} else {
					<aside id="gitpanel" class={ templ.KV("closed", p.View != "thread") } data-class:open="$git" data-class:closed="!$git" data-preserve-attr="style"></aside>
				}
			</div>
			<div id="toast"></div>
			// The sidebar rows' hover card (see views.rowTip), one for the page.
			<div id="hovertip" class="hovertip" hidden></div>
			<datalist id="project-paths"></datalist>
			{{ keys := Hotkeys(p, parts) }}
			@Palette(p)
			@ShortcutHelp(keys)
			@HotkeyButtons(keys)
			// The visible height as a CSS variable. iOS Safari does not resize
			// the layout viewport when the keyboard opens (interactive-widget
			// is Chrome's), so a page sized with dvh keeps its composer under
			// the keys. The body takes --vvh instead, and the page is held at
			// the top, since iOS also scrolls it to bring the field into view.
			<script>
				(() => {
					const vv = window.visualViewport;
					if (!vv) return;
					const apply = () => {
						document.documentElement.style.setProperty('--vvh', Math.round(vv.height) + 'px');
						if (vv.offsetTop > 0) window.scrollTo(0, 0);
					};
					vv.addEventListener('resize', apply);
					vv.addEventListener('scroll', apply);
					apply();
				})();
			</script>
			// One MutationObserver for every script that watches the page.
			// Datastar patches the DOM many times a second while a turn
			// streams, and each watcher used to observe the whole body on
			// its own; here they run together once per animation frame, so
			// a burst of patches costs one pass and one layout.
			<script>
				window.onDOM = (() => {
					const fns = [];
					let queued = false;
					new MutationObserver(() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(() => {
							queued = false;
							for (const f of fns) f();
						});
					}).observe(document.documentElement, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['class'] });
					return (f) => fns.push(f);
				})();
			</script>
			// Stream keepalive. Datastar retries a stream that fails, but one
			// that ends cleanly (starcode restarted, a proxy timed out, a
			// phone came back from the background) just stops, and the page
			// goes stale. streamEnded reopens it when the request finishes;
			// the watchdog reopens it when heartbeats (_hb, every 20s) stop
			// or the tab becomes visible after a long gap. Reopening fires
			// the "stream" event handled on <body>.
			<script>
				(() => {
					let last = Date.now();
					let wait = 1000;
					let timer;
					const reopen = () => {
						clearTimeout(timer);
						timer = setTimeout(() => window.dispatchEvent(new Event('stream')), wait);
					};
					window.streamAlive = () => {
						last = Date.now();
						wait = 1000;
					};
					window.streamEnded = () => {
						reopen();
						wait = Math.min(wait * 2, 15000);
					};
					const stale = (ms) => Date.now() - last > ms;
					setInterval(() => { if (stale(45000)) { last = Date.now(); reopen(); } }, 5000);
					document.addEventListener('visibilitychange', () => {
						if (document.visibilityState === 'visible' && stale(25000)) { last = Date.now(); wait = 1000; reopen(); }
					});
					window.addEventListener('online', () => { wait = 1000; reopen(); });
				})();
			</script>
			// Keep the transcript pinned to the bottom while it streams, but
			// only if the reader has not scrolled up to look at something. The
			// body class shows the "jump to latest" button while they are.
			<script>
				(() => {
					const near = (m) => m.scrollHeight - m.scrollTop - m.clientHeight < 160;
					let stick = true;
					// A link into the transcript (search results, the message
					// rail) lands on its row instead of the bottom.
					// A row the page did not load (the transcript starts at the
					// last stretch, see views.Thread) is fetched through the
					// "earlier" button first; the watcher below jumps once it is in.
					let wantRow = '';
					const jumpToHash = () => {
						if (!location.hash.startsWith('#it-')) return;
						const id = location.hash.slice(1);
						const row = document.getElementById(id);
						if (!row) {
							const more = document.querySelector('.load-earlier');
							if (more) { wantRow = id; more.click(); }
							return;
						}
						wantRow = '';
						stick = false;
						document.body.classList.add('scrolled-up');
						row.scrollIntoView({ block: 'center' });
					};
					window.addEventListener('DOMContentLoaded', () => setTimeout(jumpToHash, 50));
					window.addEventListener('hashchange', jumpToHash);
					const track = (m) => {
						stick = near(m);
						document.body.classList.toggle('scrolled-up', !stick);
					};
					document.addEventListener('scroll', (e) => {
						if (e.target && e.target.id === 'items') track(e.target);
					}, true);
					// loadEarlier remembers where the reader was, so the rows
					// that land above do not move what is on screen (Safari
					// has no scroll anchoring).
					let anchor = null;
					window.loadEarlier = (btn) => {
						const m = document.getElementById('items');
						if (m) anchor = { h: m.scrollHeight, top: m.scrollTop };
						btn.disabled = true;
					};
					onDOM(() => {
						const m = document.getElementById('items');
						if (!m) return;
						if (anchor && !document.querySelector('.load-earlier')) {
							m.scrollTop = anchor.top + (m.scrollHeight - anchor.h);
							anchor = null;
						}
						if (wantRow && document.getElementById(wantRow)) { jumpToHash(); return; }
						if (stick) m.scrollTop = m.scrollHeight;
						else document.body.classList.toggle('scrolled-up', !near(m));
					});
				})();
			</script>
			// Composer helpers shared by the thread and home pages.
			// sendKey: Enter sends on a hardware keyboard, Shift+Enter breaks
			// the line. On a touch screen Enter is the only way to get a
			// newline, so there it breaks the line and the send button (or
			// Ctrl/Cmd+Enter, on a paired keyboard) sends. Enter pressed to
			// pick an IME candidate never sends.
			// autoGrow: the prompt box follows its text up to the CSS
			// max-height; runs on input and, through data-effect, when the
			// signal is cleared after a send.
			<script>
				window.sendKey = (evt) => evt.key === 'Enter' && !evt.isComposing
					&& (evt.ctrlKey || evt.metaKey || (!evt.shiftKey && !matchMedia('(pointer: coarse)').matches));
				// copyText puts text on the clipboard and flashes the button
				// that asked. The clipboard API needs a secure context; the
				// selection-based fallback covers plain http on a LAN.
				window.copyText = async (text, btn) => {
					let ok = false;
					try {
						if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(text); ok = true; }
					} catch (e) {}
					if (!ok) {
						const ta = document.createElement('textarea');
						ta.value = text;
						ta.style.position = 'fixed';
						ta.style.opacity = '0';
						document.body.append(ta);
						ta.focus();
						ta.select();
						try { ok = document.execCommand('copy'); } catch (e) {}
						ta.remove();
					}
					if (btn) {
						btn.classList.add(ok ? 'copied' : 'copy-failed');
						setTimeout(() => btn.classList.remove('copied', 'copy-failed'), 1200);
					}
				};
				// promptSet replaces the composer text (after a check when
				// something is already typed) and focuses it.
				window.promptSet = (text) => {
					const ta = document.querySelector('form.composer .prompt');
					if (!ta) return;
					if (ta.value.trim() && ta.value !== text && !confirm('Replace what is in the composer?')) return;
					ta.value = text;
					ta.dispatchEvent(new Event('input', { bubbles: true }));
					ta.focus();
					ta.setSelectionRange(text.length, text.length);
				};
				window.renameFocus = () => setTimeout(() => {
					const box = document.querySelector('form.rename input');
					if (box) { box.focus(); box.select(); }
				});
				// Prompt history: ArrowUp in an empty composer brings back the
				// last sent prompt, again for the one before; ArrowDown walks
				// forward and past the newest restores what was typed. Reads
				// the prompts on the page (the transcript's user rows).
				document.addEventListener('keydown', (e) => {
					const ta = e.target;
					if (!(ta instanceof HTMLTextAreaElement) || !ta.classList.contains('prompt') || e.isComposing) return;
					if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
					if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return;
					const hist = [...document.querySelectorAll('.item.user .bubble')].map((b) => b.textContent);
					if (!hist.length) return;
					let i = Number(ta.dataset.hist ?? hist.length);
					const atEntry = i < hist.length && ta.value === hist[i];
					if (e.key === 'ArrowUp') {
						// Only from an empty box, or while already walking, and
						// only with the caret on the first line.
						if (!(ta.value === '' || atEntry) || ta.value.slice(0, ta.selectionStart).includes('\n')) return;
						if (i === 0) return;
						if (i === hist.length) ta.dataset.draft = ta.value;
						i--;
					} else {
						if (!atEntry) return;
						i++;
					}
					e.preventDefault();
					ta.dataset.hist = i;
					ta.value = i < hist.length ? hist[i] : (ta.dataset.draft || '');
					if (i === hist.length) delete ta.dataset.hist;
					ta.dispatchEvent(new Event('input', { bubbles: true }));
					ta.setSelectionRange(ta.value.length, ta.value.length);
				});
				window.autoGrow = (el) => queueMicrotask(() => {
					el.style.height = 'auto';
					el.style.height = el.scrollHeight + 'px';
				});
				// optKey walks a list of .opt rows with the arrow keys and
				// picks the first on Enter in a search box; the palette and
				// the setting pickers share it. True when it handled the key.
				window.optKey = (e, opts) => {
					if (!opts.length) return false;
					if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
						e.preventDefault();
						const i = opts.indexOf(document.activeElement);
						const n = i < 0 ? (e.key === 'ArrowDown' ? 0 : opts.length - 1) : (e.key === 'ArrowDown' ? (i + 1) % opts.length : (i - 1 + opts.length) % opts.length);
						opts[n].focus();
						opts[n].scrollIntoView({ block: 'nearest' });
						return true;
					}
					if (e.key === 'Enter' && e.target instanceof HTMLInputElement) {
						e.preventDefault();
						opts[0].click();
						return true;
					}
					return false;
				};
			</script>
			// Keyboard. Shortcuts are the hidden #hotkeys buttons: the server
			// lists what each page offers (see views.Hotkeys) and the handler
			// clicks the one whose combo matches, "mod" being Ctrl or, on a
			// Mac, Cmd. Inside the terminal only the keys marked data-term
			// apply; the shell owns the rest. Escape closes the palette or
			// help, then an open side panel or setting menu. A printable key
			// pressed with nothing focused goes to the composer. Keys on a
			// focused control (Space on a button, arrows in a select) are
			// left alone. A menu whose own keydown handler saw the Escape
			// has closed already; one that lost focus closes through a click
			// on the body, which its outside-click handler answers.
			<script>
				(() => {
					const mac = /Mac|iPhone|iPad/.test(navigator.platform);
					if (mac) document.documentElement.classList.add('mac');
					const combo = (e) => {
						const parts = [];
						if (mac ? e.metaKey : e.ctrlKey) parts.push('mod');
						if (e.altKey) parts.push('alt');
						if (e.shiftKey) parts.push('shift');
						let k = e.key.toLowerCase();
						if (k === 'arrowup') k = 'up';
						if (k === 'arrowdown') k = 'down';
						if (k === 'arrowleft') k = 'left';
						if (k === 'arrowright') k = 'right';
						if (k === ' ') k = 'space';
						if (k === 'dead' || k === '~') k = '`';
						if (e.code === 'Backquote') k = '`';
						if (e.code === 'Comma') k = ',';
						if (e.code === 'Slash') k = '/';
						if (k.length === 1 && e.code.startsWith('Key')) k = e.code.slice(3).toLowerCase();
						parts.push(k);
						return parts.join('+');
					};
					window.hotkeyCombo = combo;
					window.runHotkey = (c, inTerm) => {
						const b = document.querySelector(`#hotkeys [data-hotkey="${c}"]`);
						if (!b || (inTerm && !b.hasAttribute('data-term'))) return false;
						b.click();
						return true;
					};
					window.hotkeyInTerm = (e) => {
						const c = combo(e);
						const b = document.querySelector(`#hotkeys [data-hotkey="${c}"]`);
						return !!(b && b.hasAttribute('data-term'));
					};
					document.addEventListener('keydown', (e) => {
						const t = e.target instanceof Element ? e.target : null;
						const inTerm = !!(t && t.closest('#termpanel'));
						// A combo without a modifier (a bound "y") only counts
						// while no text box has the keys.
						const typing = !!(t && t.closest('input, textarea, select, [contenteditable]'));
						if ((e.ctrlKey || e.metaKey || e.altKey || !typing) && !e.repeat && runHotkey(combo(e), inTerm)) {
							e.preventDefault();
							e.stopPropagation();
							return;
						}
						if (inTerm) return;
						if (e.key === 'Escape') {
							if (document.querySelector('#palette:not([style*="none"]), #help:not([style*="none"])')) document.querySelector('#palette:not([style*="none"]), #help:not([style*="none"])').click();
							else if (document.querySelector('#sidebar.open, #gitpanel.open')) document.querySelector('.backdrop')?.click();
							else if (document.querySelector('.chip.open') && !(t && t.closest('.pick'))) document.body.click();
							return;
						}
						if (e.ctrlKey || e.metaKey || e.altKey || e.key.length !== 1 || e.key === ' ') return;
						if (t && t.closest('button, a, summary, input, textarea, select, [contenteditable], [tabindex]')) return;
						document.querySelector('form.composer .prompt')?.focus();
					});
					window.promptFocus = () => document.querySelector('form.composer .prompt')?.focus();
					// threadStep moves to the previous or next thread in the
					// sidebar, in the order shown; from a page without a
					// current thread it opens the first or last one.
					window.threadStep = (dir) => {
						// Rows the filter box hides are skipped; a collapsed sidebar
						// (Ctrl+B) still counts, so the keys work without it.
						const rows = [...document.querySelectorAll('#sidebar .thread-row')].filter((r) => r.style.display !== 'none');
						if (!rows.length) return;
						const i = rows.findIndex((r) => r.classList.contains('current'));
						const next = i < 0 ? (dir > 0 ? rows[0] : rows[rows.length - 1]) : rows[(i + dir + rows.length) % rows.length];
						next.querySelector('a')?.click();
					};
					// Palette: the box gets focus on open; arrows walk the
					// rows, Enter in the box picks the first row, Escape and
					// a picked row close it (paletteKey answers true to close).
					window.paletteFocus = () => setTimeout(() => document.querySelector('#palette input')?.focus());
					window.paletteKey = (e, root) => {
						if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); return true; }
						const opts = [...root.querySelectorAll('.opt')];
						if (optKey(e, opts)) return false;
						// A printable key on a row goes back to the search box.
						if (opts.length && e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey && !(e.target instanceof HTMLInputElement)) root.querySelector('input')?.focus();
						return false;
					};
				})();
			</script>
			// Tab title count: the server marks rows unread (see
			// views.ThreadRow, from the seen table); this only counts them.
			<script>
				(() => {
					const apply = () => {
						const unread = document.querySelectorAll('#sidebar .thread-row.unread').length;
						const t = document.getElementById('page-title');
						if (!t) return;
						const base = t.textContent.replace(/^\(\d+\) /, '');
						const want = (unread ? `(${unread}) ` : '') + base;
						if (t.textContent !== want) t.textContent = want;
					};
					onDOM(apply);
					apply();
				})();
			</script>
			// Clock: relative ages in thread rows ([data-ago], same rules as
			// views.ago) and the busy row's elapsed time tick without a
			// server round trip; the busy word changes every few seconds.
			<script>
				(() => {
					const ago = (t) => {
						const s = Math.max(0, (Date.now() - t) / 1000);
						if (s < 60) return 'now';
						if (s < 3600) return Math.floor(s / 60) + 'm';
						if (s < 86400) return Math.floor(s / 3600) + 'h';
						if (s < 14 * 86400) return Math.floor(s / 86400) + 'd';
						return Math.floor(s / 7 / 86400) + 'w';
					};
					// Same shape as views.elapsedText: "12s", "1m 05s", "1h 02m 05s".
					const elapsed = (t) => {
						const s = Math.max(0, Math.round((Date.now() - t) / 1000));
						const two = (n) => String(n).padStart(2, '0');
						if (s < 60) return s + 's';
						if (s < 3600) return Math.floor(s / 60) + 'm ' + two(s % 60) + 's';
						return Math.floor(s / 3600) + 'h ' + two(Math.floor(s / 60) % 60) + 'm ' + two(s % 60) + 's';
					};
					const words = ['Working', 'Thinking', 'Reading', 'Considering', 'Tinkering', 'Pondering', 'Mulling', 'Wrangling', 'Sifting', 'Brewing', 'Puzzling', 'Poking around'];
					let tick = 0;
					setInterval(() => {
						tick++;
						for (const el of document.querySelectorAll('[data-since]')) el.textContent = elapsed(Date.parse(el.dataset.since));
						if (tick % 30 === 0) for (const el of document.querySelectorAll('[data-ago]')) el.textContent = ago(Date.parse(el.dataset.ago));
						if (tick % 4 === 0) for (const el of document.querySelectorAll('[data-busy-word]')) el.textContent = words[Math.floor(Math.random() * words.length)] + '…';
					}, 1000);
				})();
			</script>
			// theme-color follows the theme: the phone's status and address
			// bars take the page background instead of a fixed colour.
			<script>
				(() => {
					const meta = document.querySelector('meta[name="theme-color"]');
					const apply = () => {
						const bg = getComputedStyle(document.body).getPropertyValue('--bg').trim();
						if (bg) meta.content = bg;
					};
					apply();
					new MutationObserver(apply).observe(document.body, { attributeFilter: ['data-theme'] });
				})();
			</script>
			// VS Code. vscodeOpen hands a folder of this machine to VS Code on
			// the reader's machine through its URL handler. starcode mostly
			// runs somewhere else, so the link goes through the Remote-SSH
			// extension: to the host set for this browser in Settings >
			// General (localStorage, since every client has its own ssh
			// config), or else to the account starcode runs as at the address
			// in the address bar. A page on localhost with no host set opens
			// the folder locally.
			@templ.JSONScript("run-user", runUser())
			<script>
				(() => {
					const key = 'vscode-host';
					const user = JSON.parse(document.getElementById('run-user').textContent);
					window.vscodeHost = () => localStorage.getItem(key) || '';
					window.vscodeHostSet = (v) => { v = v.trim(); if (v) localStorage.setItem(key, v); else localStorage.removeItem(key); };
					window.vscodeLocal = () => ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
					window.vscodeDefaultHost = () => (user ? user + '@' : '') + location.hostname;
					window.vscodeURL = (dir) => {
						const path = dir.split('/').map(encodeURIComponent).join('/');
						const host = vscodeHost();
						if (!host && vscodeLocal()) return 'vscode://file' + path;
						return 'vscode://vscode-remote/ssh-remote+' + encodeURIComponent(host || vscodeDefaultHost()).replaceAll('%40', '@') + path;
					};
					// The browser runs beforeunload for a link it hands to another
					// app, though the page stays; linkOut tells the editor's
					// unsaved-changes guard to let this one through.
					window.vscodeOpen = (dir) => {
						window.linkOut = true;
						setTimeout(() => { window.linkOut = false; }, 1000);
						location.assign(vscodeURL(dir));
					};
				})();
			</script>
			// Notifications. Once allowed (Settings > Appearance) a thread
			// that ends a turn or asks for an approval while this page is
			// hidden posts a system notification, which is what a phone in a
			// pocket needs. The signals are what the server already renders:
			// a row turning unread in the sidebar (any thread, any page) and
			// the status pill of the thread on screen. Notifications go
			// through the service worker (static/sw.js), since Android
			// Chrome has no other way to show one, and they need a secure
			// context, which the login page explains.
			<script>
				(() => {
					const key = 'notify';
					window.notifyWanted = () => localStorage.getItem(key) === '1' && 'Notification' in window && Notification.permission === 'granted';
					const reg = () => 'serviceWorker' in navigator ? navigator.serviceWorker.register('/sw.js').catch(() => null) : Promise.resolve(null);
					if (window.notifyWanted()) reg();
					// notifyEnable is the settings button: asks for permission
					// on this device and turns the watcher on; returns the state
					// word the button shows.
					window.notifyEnable = async () => {
						if (iosTab) return 'ios-tab';
						if (!('Notification' in window) || !('serviceWorker' in navigator)) return 'unsupported';
						if (!window.isSecureContext) return 'insecure';
						const perm = await Notification.requestPermission();
						if (perm !== 'granted') return perm;
						const r = await reg();
						if (!r) return 'no-worker';
						localStorage.setItem(key, '1');
						return 'on';
					};
					window.notifyDisable = () => { localStorage.removeItem(key); return 'off'; };
					window.notifyWord = (st) => ({
						on: 'on for this device (turn off)',
						off: 'turn on for this device',
						denied: 'blocked in the browser settings',
						insecure: 'needs https (install the certificate)',
						unsupported: 'not supported by this browser',
						'ios-tab': 'add starcode to the home screen first (share, add to home screen)',
						'no-worker': 'the browser refused the service worker (certificate not trusted?)',
					})[st] || st;
					// iOS only has notifications in the app on the home screen.
					const iosTab = /iPhone|iPad|iPod/.test(navigator.userAgent) && !navigator.standalone && !matchMedia('(display-mode: standalone)').matches;
					window.notifyState = () => {
						if (iosTab) return 'ios-tab';
						if (!('Notification' in window) || !('serviceWorker' in navigator)) return 'unsupported';
						if (!window.isSecureContext) return 'insecure';
						if (Notification.permission === 'denied') return 'denied';
						return window.notifyWanted() ? 'on' : 'off';
					};
					const post = async (title, body, url, tag) => {
						if (!window.notifyWanted() || !document.hidden) return;
						const r = await navigator.serviceWorker.getRegistration('/');
						if (!r) return;
						r.showNotification(title, { body, tag, data: { url }, icon: '/static/icon-maskable.svg' }).catch(() => {});
					};
					// Sidebar: a row that turns unread since the last look.
					let unread = null;
					const rows = () => new Map([...document.querySelectorAll('#sidebar .thread-row.unread')].map((r) => [r.dataset.id, r]));
					// Status pill of the thread on screen.
					let status = null;
					const pill = () => document.querySelector('#mainhead .status-pill')?.className.match(/\bst-(\w+)/)?.[1] || null;
					const watch = () => {
						const now = rows();
						if (unread) {
							for (const [id, r] of now) {
								if (unread.has(id)) continue;
								const title = r.querySelector('.thread-text > .ellipsis')?.textContent.trim() || 'thread';
								post(title, 'finished', '/threads/' + id, 'thread-' + id);
							}
						}
						unread = now;
						const st = pill();
						if (status && st && st !== status) {
							const title = document.querySelector('#mainhead .crumb-title')?.textContent.trim() || 'thread';
							if (st === 'awaiting_approval') post(title, 'needs approval', location.pathname, 'status-' + location.pathname);
							else if (status === 'running' && (st === 'idle' || st === 'error')) post(title, st === 'error' ? 'stopped with an error' : 'finished', location.pathname, 'status-' + location.pathname);
						}
						if (st) status = st;
					};
					onDOM(watch);
					watch();
				})();
			</script>
			// Hover card for sidebar rows: the pointer on a row's agent mark
			// shows the row's hidden tip beside the sidebar, fixed so the
			// list's scrolling and clipping do not cut it. Pointer devices
			// only; a phone has the thread page for the same facts.
			<script>
				(() => {
					if (!matchMedia('(hover: hover)').matches) return;
					const tip = document.getElementById('hovertip');
					let timer;
					const hide = () => { clearTimeout(timer); tip.hidden = true; };
					document.addEventListener('mouseover', (e) => {
						const mark = e.target instanceof Element && e.target.closest('.thread-row .row-mark');
						if (!mark) return;
						const src = mark.closest('.thread-row')?.querySelector('.row-tip');
						if (!src) return;
						clearTimeout(timer);
						timer = setTimeout(() => {
							tip.innerHTML = src.innerHTML;
							const r = mark.getBoundingClientRect();
							const side = document.getElementById('sidebar')?.getBoundingClientRect();
							tip.hidden = false;
							const w = tip.offsetWidth, h = tip.offsetHeight;
							let x = (side ? side.right : r.right) + 6;
							if (x + w > innerWidth - 8) x = Math.max(8, r.left - w - 6);
							let y = r.top - 6;
							if (y + h > innerHeight - 8) y = Math.max(8, innerHeight - 8 - h);
							tip.style.left = x + 'px';
							tip.style.top = y + 'px';
						}, 150);
					});
					document.addEventListener('mouseout', (e) => {
						if (e.target instanceof Element && e.target.closest('.thread-row .row-mark')) hide();
					});
					document.addEventListener('scroll', hide, true);
					document.addEventListener('click', hide, true);
				})();
			</script>
			// Banner rows hidden with "later" stay hidden in this browser until
			// what they announce changes: each row carries a key (the build's
			// path and time, the home binary's time, the commit count), and
			// dismissed keys are kept in localStorage.
			<script>
				(() => {
					const key = 'banner-dismissed';
					const read = () => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
					window.bannerDismiss = (el) => {
						const row = el.closest('[data-dismiss]');
						if (!row) return;
						localStorage.setItem(key, JSON.stringify([...new Set([...read(), row.dataset.dismiss])].slice(-50)));
						row.hidden = true;
					};
					const apply = () => {
						const gone = new Set(read());
						for (const row of document.querySelectorAll('#update [data-dismiss]')) row.hidden = gone.has(row.dataset.dismiss);
					};
					onDOM(apply);
					apply();
				})();
			</script>
			// Phone swipes: the thread list and the changes panel follow the
			// finger. With nothing open, a swipe right pulls the thread list in
			// and a swipe left pulls the changes panel in; with one open, the
			// swipe the other way pushes it out. Letting go past a third of the
			// panel, or with a flick, finishes the move; anything less springs
			// back. A swipe that starts in the terminal, or on something that
			// still has room to scroll that way (a wide code block, the chips
			// row), is left to that element. A finger that rested before it
			// moved is selecting text, not swiping, and so is one that moves
			// while a selection is on screen; both are left alone too. A
			// start at the screen edge is the phone's own back/forward
			// gesture, which iOS runs in a home screen app as well and which
			// no page can cancel, so the edge is ignored everywhere, home
			// screen app included, and the pull starts just inside it.
			// The drag only moves the panel; the open state itself is set by
			// pressing the panel's own button at the end, so the Datastar
			// signals stay the single source of truth.
			<script>
				(() => {
					const narrow = matchMedia('(max-width: 900px)');
					const mid = matchMedia('(max-width: 1100px)');
					const edge = 48;
					const lock = 10;
					// A swipe moves within this many ms of touching down; a long
					// press for text selection holds still for longer. A thumb
					// that lands and settles first takes a good part of that.
					const hold = 400;
					let touch = null;
					let drag = null;
					const leavesTo = (el, dir) => {
						for (; el && el !== document.body; el = el.parentElement) {
							if (el.id === 'termpanel') return true;
							const o = getComputedStyle(el).overflowX;
							if (o !== 'auto' && o !== 'scroll') continue;
							if (dir > 0 ? el.scrollLeft > 0 : el.scrollLeft + el.clientWidth < el.scrollWidth - 1) return true;
						}
						return false;
					};
					// pick names the panel a move of dx would drag, or nothing.
					const pick = (dx) => {
						const side = document.getElementById('sidebar');
						const git = document.getElementById('gitpanel');
						const navOpen = narrow.matches && side?.classList.contains('open');
						const gitOpen = mid.matches && git?.classList.contains('open');
						if (navOpen) return dx < 0 ? { panel: side, sign: -1, open: true, toggle: '.backdrop' } : null;
						if (gitOpen) return dx > 0 ? { panel: git, sign: 1, open: true, toggle: '.backdrop' } : null;
						if (dx > 0 && narrow.matches && side && document.querySelector('.navtoggle')) return { panel: side, sign: -1, open: false, toggle: '.navtoggle' };
						if (dx < 0 && mid.matches && git && document.querySelector('.gittoggle')) return { panel: git, sign: 1, open: false, toggle: '.gittoggle' };
						return null;
					};
					// The backdrop's display is owned by data-show, which puts back
					// what it wants the moment anything else touches the style, so
					// the drag dims through a scrim of its own and hides the real
					// backdrop underneath while it lasts.
					const scrim = document.createElement('div');
					scrim.className = 'swipe-scrim';
					// Moves are applied once per frame, not once per touch event.
					const place = (d, x) => {
						d.at1 = Date.now();
						d.x1 = x;
						if (d.raf) return;
						d.raf = requestAnimationFrame(() => {
							d.raf = 0;
							d.panel.style.transform = d.x1 ? `translateX(${d.x1}px)` : 'none';
							d.dim = 1 - Math.abs(d.x1) / d.w;
							scrim.style.opacity = String(d.dim);
						});
					};
					document.addEventListener('touchstart', (e) => {
						touch = null;
						if (e.touches.length !== 1) return;
						// A drag still live at a fresh touch lost its end; drop it.
						if (drag) release(true);
						if (!narrow.matches && !mid.matches) return;
						if (document.querySelector('#palette:not([style*="none"]), #help:not([style*="none"])')) return;
						const t = e.touches[0];
						if (t.clientX < edge || t.clientX > innerWidth - edge) return;
						touch = { x: t.clientX, y: t.clientY, target: e.target, at: Date.now() };
					}, { passive: true });
					document.addEventListener('touchmove', (e) => {
						const t = e.touches[0];
						if (drag) {
							e.preventDefault();
							const x = Math.max(-drag.w, Math.min(drag.w, drag.from + (t.clientX - drag.x)));
							drag.x0 = x;
							place(drag, drag.sign < 0 ? Math.min(0, x) : Math.max(0, x));
							return;
						}
						if (!touch) return;
						const dx = t.clientX - touch.x;
						const dy = t.clientY - touch.y;
						if (Math.abs(dx) < lock && Math.abs(dy) < lock) return;
						if (Date.now() - touch.at > hold || !(document.getSelection()?.isCollapsed ?? true)) { touch = null; return; }
						const horizontal = Math.abs(dx) > Math.abs(dy) * 1.5;
						const d = horizontal && !leavesTo(touch.target, dx) ? pick(dx) : null;
						const touch0 = touch.target;
						touch = null;
						if (!d) return;
						d.w = d.panel.offsetWidth;
						d.from = d.open ? 0 : d.sign * d.w;
						d.x = t.clientX;
						d.at = Date.now();
						// The backdrop only shows on a phone; a tablet's changes
						// drawer has none to fade.
						d.backdrop = narrow.matches ? document.querySelector('.backdrop') : null;
						d.dim = d.open ? 1 : 0;
						if (d.backdrop) {
							d.backdrop.style.transition = 'none';
							d.backdrop.style.opacity = '0';
							scrim.style.opacity = String(d.dim);
							d.backdrop.parentNode.insertBefore(scrim, d.backdrop.nextSibling);
						}
						d.panel.style.transition = 'none';
						drag = d;
						e.preventDefault();
						// Touch events keep going to the element the finger landed
						// on, so a stream update that replaces it mid-swipe would
						// take the end of the gesture with it. Finish from the last
						// known spot when that happens.
						d.target = touch0;
						const watch = () => {
							if (drag !== d) return;
							if (document.contains(d.target)) requestAnimationFrame(watch); else release(false);
						};
						requestAnimationFrame(watch);
					}, { passive: false });
					const release = (cancel) => {
						const d = drag;
						drag = null;
						if (!d) return;
						const moved = (d.x0 ?? d.from) - d.from;
						const quick = Date.now() - d.at < 300 && Math.abs(moved) > 30;
						const toward = d.open ? Math.sign(moved) === d.sign : Math.sign(moved) === -d.sign;
						const crossed = !cancel && toward && (quick || Math.abs(moved) > d.w / 3);
						if (d.raf) { cancelAnimationFrame(d.raf); d.raf = 0; }
						// The panel slides on from where the finger left it, at the
						// pace it was going: the transition comes back first, sized
						// to the distance left, then the class flips.
						const x = d.x1 ?? d.from;
						const left = crossed ? Math.abs(x - (d.open ? d.sign * d.w : 0)) : Math.abs(x - d.from);
						const ms = Math.round(Math.max(60, Math.min(220, 220 * left / d.w)));
						d.panel.style.transition = `transform ${ms}ms ease-out`;
						setTimeout(() => { if (drag?.panel !== d.panel) d.panel.style.transition = ''; }, ms + 50);
						if (d.backdrop) d.backdrop.style.opacity = String(d.dim);
						scrim.remove();
						void d.panel.offsetWidth;
						if (crossed) document.querySelector(d.toggle)?.click();
						d.panel.style.transform = '';
						if (!d.backdrop) return;
						// The real backdrop takes over at the scrim's level and
						// fades the rest of the way with the panel.
						void d.backdrop.offsetWidth;
						d.backdrop.style.transition = '';
						d.backdrop.style.opacity = '';
					};
					document.addEventListener('touchend', () => { touch = null; release(false); }, { passive: true });
					document.addEventListener('touchcancel', () => { touch = null; release(true); }, { passive: true });
				})();
			</script>
			// Setting pickers (views.Chips). A pick is a chip button plus a
			// menu of .opt buttons; the open one is named by the pick signal.
			// pickLabel gives the chip the text of the row whose value the
			// signal holds (its data-short when set), or the raw value for
			// an id typed in by hand, so the home composer needs no round
			// trip. pickFocus lands in the search box on a keyboard machine
			// and nowhere on a phone, where that would raise the keyboard.
			// pickKey moves through the visible rows with the arrow keys,
			// picks the first match on Enter in the search box, and answers
			// true for Escape so the caller can close the menu.
			<script>
				window.pickLabel = (el, value) => {
					const menu = el.closest('.pick')?.querySelector('.pick-menu');
					const opt = menu && [...menu.querySelectorAll('.opt[data-value]')].find((o) => o.dataset.value === String(value ?? ''));
					if (!opt) return value || '';
					return opt.dataset.short || opt.querySelector('.opt-name')?.textContent.trim() || value;
				};
				// pickOf finds the picker of a kind for an agent in the form
				// around el, for the rows in the model sheet that show the
				// effort and mode chips' labels while those chips are hidden.
				window.pickOf = (el, kind, agent) => [...el.closest('form').querySelectorAll('.pick-' + kind)].find((p) => p.dataset.agent === agent) || el;
				window.pickFocus = (el) => setTimeout(() => {
					// After a rail switch the open menu is another agent's, so
					// look for the one that is actually on screen.
					const menu = [...el.closest('form').querySelectorAll('.pick-menu')].find((m) => m.getClientRects().length);
					if (!menu || matchMedia('(pointer: coarse)').matches) return;
					(menu.querySelector('input') || menu.querySelector('.opt.sel') || menu.querySelector('.opt'))?.focus();
				});
				window.pickKey = (e, root) => {
					const menu = root.querySelector('.pick-menu');
					if (!menu || getComputedStyle(menu).display === 'none') return false;
					if (e.key === 'Escape') {
						e.preventDefault();
						e.stopPropagation();
						root.querySelector('.chip')?.focus();
						return true;
					}
					// Enter in an empty search box closes the menu instead.
					if (e.key === 'Enter' && e.target instanceof HTMLInputElement && !e.target.value.trim()) {
						e.preventDefault();
						return true;
					}
					optKey(e, [...menu.querySelectorAll('.opt')].filter((o) => getComputedStyle(o).display !== 'none'));
					return false;
				};
			</script>
			// Pasting or dropping files on a composer adds them to its attach
			// input (merged with what is already picked) and fires a change
			// event so the Datastar binding lifts them into the signal.
			<script>
				(() => {
					const addFiles = (target, files) => {
						const form = target instanceof Element && target.closest('form.composer');
						const input = form && form.querySelector('input[type=file]');
						if (!input || !files.length) return false;
						const merged = new DataTransfer();
						for (const f of input.files) merged.items.add(f);
						for (const f of files) merged.items.add(f);
						input.files = merged.files;
						input.dispatchEvent(new Event('change', { bubbles: true }));
						return true;
					};
					document.addEventListener('paste', (e) => {
						if (e.target instanceof HTMLTextAreaElement && e.target.classList.contains('prompt')
							&& e.clipboardData && addFiles(e.target, e.clipboardData.files)) e.preventDefault();
					});
					// The strip above the composer row: one removable item per
					// picked file, rebuilt from the input on every change
					// (picker, paste, and drop all end in one).
					const removeFile = (input, index) => {
						const kept = new DataTransfer();
						[...input.files].forEach((f, i) => { if (i !== index) kept.items.add(f); });
						input.files = kept.files;
						input.dispatchEvent(new Event('change', { bubbles: true }));
					};
					const renderStrip = (input) => {
						const box = input.closest('form.composer')?.querySelector('.attach-thumbs');
						if (!box) return;
						box.replaceChildren(...[...input.files].map((f, i) => {
							const item = document.createElement('div');
							if (f.type.startsWith('image/')) {
								item.className = 'attach-item';
								const img = document.createElement('img');
								img.src = URL.createObjectURL(f);
								img.onload = () => URL.revokeObjectURL(img.src);
								img.alt = img.title = f.name;
								item.append(img);
							} else {
								item.className = 'attach-item file';
								item.append(Object.assign(document.createElement('span'), { className: 'ellipsis', textContent: f.name }));
							}
							const x = Object.assign(document.createElement('button'), {
								type: 'button', className: 'attach-remove', title: 'Remove ' + f.name, textContent: '×',
							});
							x.addEventListener('click', () => removeFile(input, i));
							item.append(x);
							return item;
						}));
					};
					document.addEventListener('change', (e) => {
						if (e.target instanceof HTMLInputElement && e.target.type === 'file') renderStrip(e.target);
					});
					// A morphed composer comes back with an empty strip while
					// the input still holds files; refill it.
					onDOM(() => {
						for (const input of document.querySelectorAll('form.composer input[type=file]')) {
							const box = input.closest('form.composer').querySelector('.attach-thumbs');
							if (box && !box.childElementCount && input.files.length) renderStrip(input);
						}
					});
					document.addEventListener('dragover', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (c && e.dataTransfer && e.dataTransfer.types.includes('Files')) {
							e.preventDefault();
							c.classList.add('dropping');
						}
					});
					document.addEventListener('dragleave', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (c && !(e.relatedTarget instanceof Node && c.contains(e.relatedTarget))) c.classList.remove('dropping');
					});
					document.addEventListener('drop', (e) => {
						const c = e.target instanceof Element && e.target.closest('form.composer');
						if (!c) return;
						c.classList.remove('dropping');
						if (e.dataTransfer && addFiles(e.target, e.dataTransfer.files)) e.preventDefault();
					});
				})();
			</script>
			<script>
				(() => {
					let timer, controller;
					const update = (input) => {
						clearTimeout(timer);
						timer = setTimeout(async () => {
							controller?.abort();
							controller = new AbortController();
							try {
								const response = await fetch('/api/project-paths?path=' + encodeURIComponent(input.value), { signal: controller.signal });
								if (!response.ok) return;
								const paths = await response.json();
								const list = document.getElementById('project-paths');
								list.replaceChildren(...paths.map((path) => Object.assign(document.createElement('option'), { value: path })));
							} catch (error) {
								if (error.name !== 'AbortError') console.warn('project path completion failed', error);
							}
						}, 100);
					};
					document.addEventListener('input', (event) => {
						if (event.target instanceof HTMLInputElement && event.target.classList.contains('project-path')) update(event.target);
					});
					document.addEventListener('focusin', (event) => {
						if (event.target instanceof HTMLInputElement && event.target.classList.contains('project-path')) update(event.target);
					});
				})();
			</script>
			if p.View == "thread" {
				// Side panel width: the panel's left edge drags it wider or
				// narrower, the width is kept in localStorage and set as the
				// --gitpanel-w variable on the body, which beats the unfold
				// button's class; that button clears the dragged width.
				<script>
					(() => {
						const key = 'panel-w';
						const apply = (w) => document.body.style.setProperty('--gitpanel-w', w + 'px');
						window.panelWidthReset = () => { localStorage.removeItem(key); document.body.style.removeProperty('--gitpanel-w'); };
						const saved = Number(localStorage.getItem(key));
						if (saved > 0) apply(saved);
						document.addEventListener('pointerdown', (e) => {
							const drag = e.target instanceof Element && e.target.closest('.panel-drag');
							if (!drag) return;
							e.preventDefault();
							const panel = document.getElementById('gitpanel');
							const startX = e.clientX;
							const startW = panel.getBoundingClientRect().width;
							let w = startW;
							document.body.classList.add('panel-dragging');
							drag.setPointerCapture(e.pointerId);
							const move = (ev) => {
								w = Math.round(Math.min(Math.max(startW + (startX - ev.clientX), 280), innerWidth * 0.8));
								apply(w);
							};
							const up = () => {
								drag.removeEventListener('pointermove', move);
								drag.removeEventListener('pointerup', up);
								drag.removeEventListener('pointercancel', up);
								document.body.classList.remove('panel-dragging');
								localStorage.setItem(key, String(w));
							};
							drag.addEventListener('pointermove', move);
							drag.addEventListener('pointerup', up);
							drag.addEventListener('pointercancel', up);
						});
						document.addEventListener('dblclick', (e) => {
							if (e.target instanceof Element && e.target.closest('.panel-drag')) panelWidthReset();
						});
					})();
				</script>
				// File tree (views.FileExplorer): the open folders are kept in
				// sessionStorage per thread, so a morphed or reloaded tree
				// opens them again; their placeholders then load the children.
				<script>
					(() => {
						const key = 'tree:' + location.pathname;
						let open = new Set();
						try { open = new Set(JSON.parse(sessionStorage.getItem(key) || '[]')); } catch {}
						const save = () => sessionStorage.setItem(key, JSON.stringify([...open]));
						document.addEventListener('toggle', (e) => {
							const d = e.target;
							if (!(d instanceof HTMLDetailsElement) || !d.classList.contains('tree-dir')) return;
							if (d.open) open.add(d.dataset.path); else open.delete(d.dataset.path);
							save();
						}, true);
						window.treeRestore = (el) => { if (open.has(el.dataset.path)) el.open = true; };
					})();
				</script>
				// File editor (views.GitDetail): line numbers, a highlighted
				// copy of the text behind the transparent textarea, Tab and
				// Enter that keep the indentation, Ctrl+S to save, and an
				// unsaved marker with a warning before the page is left. The
				// form is server rendered and morphed, so each editor is set
				// up when it appears and the state lives on the element.
				<script>
					(() => {
						const seen = new WeakSet();
						const lang = (ed) => ed.dataset.lang && window.hljs && hljs.getLanguage(ed.dataset.lang) ? ed.dataset.lang : '';
						const paint = (ed, ta) => {
							const code = ed.querySelector('.editor-hl code');
							const text = ta.value;
							const l = lang(ed);
							// A trailing newline needs a visible last line so the
							// layers stay the same height.
							const shown = text.endsWith('\n') ? text + ' ' : text;
							if (l && text.length < 200000) {
								code.innerHTML = hljs.highlight(shown, { language: l, ignoreIllegals: true }).value;
							} else {
								code.textContent = shown;
							}
							const lines = text.split('\n').length;
							const g = ed.querySelector('.editor-gutter');
							if (Number(g.dataset.lines) !== lines) {
								g.dataset.lines = lines;
								g.textContent = Array.from({ length: lines }, (_, i) => i + 1).join('\n');
							}
						};
						const sync = (ed, ta) => {
							ed.querySelector('.editor-hl').style.transform = `translate(${-ta.scrollLeft}px, ${-ta.scrollTop}px)`;
							ed.querySelector('.editor-gutter').style.transform = `translateY(${-ta.scrollTop}px)`;
						};
						const indentUnit = (text) => /^\t/m.test(text) ? '\t' : (text.match(/^ +/m)?.[0].length % 4 === 0 ? '    ' : '  ');
						const edit = (ta, start, end, insert) => {
							ta.setRangeText(insert, start, end, 'end');
							ta.dispatchEvent(new Event('input', { bubbles: true }));
						};
						const keys = (ta) => (e) => {
							const v = ta.value;
							const s = ta.selectionStart;
							const en = ta.selectionEnd;
							if ((e.ctrlKey || e.metaKey) && e.key === 's') {
								e.preventDefault();
								ta.closest('form').requestSubmit();
								return;
							}
							if (e.key === 'Tab') {
								e.preventDefault();
								const unit = indentUnit(v);
								const lineStart = v.lastIndexOf('\n', s - 1) + 1;
								if (s !== en && v.slice(s, en).includes('\n')) {
									// Several lines: indent or outdent each.
									const lineEnd = v.indexOf('\n', en - 1) < 0 ? v.length : Math.max(en, v.indexOf('\n', en - 1));
									const block = v.slice(lineStart, lineEnd);
									const out = block.split('\n').map((l) => e.shiftKey ? l.replace(new RegExp('^(' + unit + '|\t| {1,' + unit.length + '})'), '') : (l ? unit + l : l)).join('\n');
									ta.setRangeText(out, lineStart, lineEnd, 'select');
									ta.dispatchEvent(new Event('input', { bubbles: true }));
								} else if (e.shiftKey) {
									const m = v.slice(lineStart).match(new RegExp('^(' + unit + '|\t| {1,' + unit.length + '})'));
									if (m) edit(ta, lineStart, lineStart + m[0].length, '');
								} else {
									edit(ta, s, en, unit);
								}
								return;
							}
							if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey && !e.isComposing) {
								e.preventDefault();
								const lineStart = v.lastIndexOf('\n', s - 1) + 1;
								const indent = v.slice(lineStart, s).match(/^[ \t]*/)[0];
								edit(ta, s, en, '\n' + indent);
							}
						};
						const setup = (ed) => {
							if (seen.has(ed)) return;
							seen.add(ed);
							const ta = ed.querySelector('textarea');
							const state = ed.closest('form').querySelector('.editor-state');
							let initial = null;
							let path = ed.dataset.path;
							const refresh = () => {
								// The first paint after Datastar has bound the text is
								// the baseline for the unsaved marker. A morph reuses
								// this element for the next file, and cancel empties
								// the buffer; both start a new baseline.
								if (ed.dataset.path !== path || ta.value === '') { path = ed.dataset.path; initial = null; }
								if (initial === null && ta.value !== '') initial = ta.value;
								paint(ed, ta);
								sync(ed, ta);
								const dirty = initial !== null && ta.value !== initial;
								ed.closest('form').classList.toggle('dirty', dirty);
								state.textContent = dirty ? 'unsaved changes' : '';
							};
							ta.addEventListener('input', refresh);
							ta.addEventListener('scroll', () => sync(ed, ta));
							ta.addEventListener('keydown', keys(ta));
							ed.closest('form').addEventListener('submit', () => { initial = ta.value; setTimeout(refresh); });
							// Datastar sets the value without an input event; watch for it.
							// A morph of the panel (the stream reconnecting, the same
							// file opened again) brings the server's empty layers back
							// under a textarea that kept its text, so an empty layer
							// under text is repainted as well.
							let last = ta.value;
							const tick = () => {
								if (!ed.isConnected) return;
								const bare = ta.value !== '' && !ed.querySelector('.editor-hl code').firstChild;
								if (ta.value !== last || bare) { last = ta.value; refresh(); }
								requestAnimationFrame(tick);
							};
							requestAnimationFrame(tick);
							refresh();
						};
						const scan = () => document.querySelectorAll('.editor').forEach(setup);
						onDOM(scan);
						scan();
						window.addEventListener('beforeunload', (e) => {
							if (!window.linkOut && document.querySelector('form.git-editor.dirty')) e.preventDefault();
						});
					})();
				</script>
			}
			if p.View == "keys" {
				// Recorder for Settings > Keys: change arms a row, the next key
				// press (not a bare modifier) becomes the combo, which goes to
				// the hidden bound box and out through the row's save button.
				// Escape or a click elsewhere cancels and redraws the section.
				<script>
					(() => {
						let row = null;
						const stop = () => { row?.classList.remove('recording'); row = null; };
						const cancel = () => { if (!row) return; stop(); document.getElementById('keys-refresh')?.click(); };
						document.addEventListener('click', (e) => {
							const b = e.target instanceof Element && e.target.closest('.key-change');
							if (b) { cancel(); row = b.closest('.key-row'); row.classList.add('recording'); b.blur(); return; }
							if (row && !(e.target instanceof Element && e.target.closest('.key-row.recording'))) cancel();
						});
						document.addEventListener('keydown', (e) => {
							if (!row) return;
							e.preventDefault();
							e.stopPropagation();
							if (['Control', 'Shift', 'Alt', 'Meta'].includes(e.key)) return;
							if (e.key === 'Escape' && !e.ctrlKey && !e.altKey && !e.metaKey) { cancel(); return; }
							const r = row;
							stop();
							const box = document.querySelector('.key-combo');
							box.value = hotkeyCombo(e);
							box.dispatchEvent(new Event('input', { bubbles: true }));
							r.querySelector('.key-save').click();
						}, true);
					})();
				</script>
			}
			if p.View == "usage" {
				// The usage view is replaced by the live stream, so chart events are
				// delegated from the document instead of bound to one render.
				<script>
					(() => {
						const chartHit = (target) => target instanceof Element && target.closest('.usage-chart-hit');
						const hide = (chart) => {
							if (!chart) return;
							const cursor = chart.querySelector('.usage-chart-cursor');
							if (cursor) cursor.hidden = true;
							for (const tip of chart.querySelectorAll('.usage-chart-tip')) tip.hidden = true;
						};
						const hideAll = () => {
							for (const chart of document.querySelectorAll('.usage-chart')) hide(chart);
						};
						const show = (hit) => {
							const chart = hit.closest('.usage-chart');
							if (!chart || !chart.clientWidth) return;
							const index = hit.dataset.usageIndex;
							const svgX = Number(hit.dataset.usageX);
							const left = svgX / 800 * chart.clientWidth;
							const cursor = chart.querySelector('.usage-chart-cursor');
							if (cursor) {
								cursor.style.left = left + 'px';
								cursor.hidden = false;
							}
							for (const item of chart.querySelectorAll('.usage-chart-tip')) item.hidden = true;
							const tip = [...chart.querySelectorAll('.usage-chart-tip')]
								.find((item) => item.dataset.usageTip === index);
							if (!tip) return;
							tip.hidden = false;
							const half = tip.offsetWidth / 2 + 7;
							tip.style.left = Math.max(half, Math.min(chart.clientWidth - half, left)) + 'px';
						};
						document.addEventListener('pointerover', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
						});
						document.addEventListener('pointerout', (event) => {
							const hit = chartHit(event.target);
							if (!hit) return;
							const target = hit.closest('.usage-chart-target');
							if (!(event.relatedTarget instanceof Node && target.contains(event.relatedTarget))) {
								hide(hit.closest('.usage-chart'));
							}
						});
						document.addEventListener('focusin', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
						});
						document.addEventListener('focusout', (event) => {
							const hit = chartHit(event.target);
							if (hit && !(event.relatedTarget instanceof Node && hit.closest('.usage-chart-target').contains(event.relatedTarget))) {
								hide(hit.closest('.usage-chart'));
							}
						});
						document.addEventListener('click', (event) => {
							const hit = chartHit(event.target);
							if (hit) show(hit);
							else hideAll();
						});
						document.addEventListener('keydown', (event) => {
							const hit = chartHit(event.target);
							if (hit && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
								const hits = [...hit.closest('.usage-chart').querySelectorAll('.usage-chart-hit')];
								const direction = event.key === 'ArrowLeft' ? -1 : 1;
								const next = hits[Math.max(0, Math.min(hits.length - 1, hits.indexOf(hit) + direction))];
								next?.focus();
								event.preventDefault();
							} else if (event.key === 'Escape') {
								hideAll();
								hit?.blur();
							}
						});
					})();
				</script>
			}
		</body>
	</html>
}

templ PageTitle(title string) {
	<title id="page-title">{ title } · starcode</title>
}

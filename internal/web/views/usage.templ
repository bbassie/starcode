package views

import (
	"fmt"
	"math"
	"strings"
	"time"
)

type UsagePoint struct {
	Date         time.Time
	CostUSD      float64
	InputTokens  int64
	OutputTokens int64
}

type UsageGroup struct {
	Name         string
	Agent        string
	Turns        int
	Threads      int
	CostUSD      float64
	InputTokens  int64
	OutputTokens int64
}

type UsageData struct {
	Days         int
	Metric       string
	Start        time.Time
	End          time.Time
	Turns        int
	Threads      int
	CostUSD      float64
	InputTokens  int64
	OutputTokens int64
	Daily        []UsagePoint
	Agents       []UsageGroup
	Models       []UsageGroup
}

func usageURL(days int, metric string) string {
	return fmt.Sprintf("/settings/usage?days=%d&metric=%s", days, metric)
}

func usageValue(p UsagePoint, metric string) float64 {
	if metric == "tokens" {
		return float64(p.InputTokens + p.OutputTokens)
	}
	return p.CostUSD
}

func usageGroupValue(g UsageGroup, metric string) float64 {
	if metric == "tokens" {
		return float64(g.InputTokens + g.OutputTokens)
	}
	return g.CostUSD
}

func usageChartPath(points []UsagePoint, metric string) string {
	if len(points) == 0 {
		return ""
	}
	max := 0.0
	for _, p := range points {
		max = math.Max(max, usageValue(p, metric))
	}
	if max == 0 {
		max = 1
	}
	var out strings.Builder
	for i, p := range points {
		x := 48.0
		if len(points) > 1 {
			x += float64(i) * 724 / float64(len(points)-1)
		}
		y := 222 - usageValue(p, metric)/max*184
		if i == 0 {
			fmt.Fprintf(&out, "M %.1f %.1f", x, y)
		} else {
			fmt.Fprintf(&out, " L %.1f %.1f", x, y)
		}
	}
	return out.String()
}

func usageAreaPath(points []UsagePoint, metric string) string {
	line := usageChartPath(points, metric)
	if line == "" {
		return ""
	}
	return line + " L 772 222 L 48 222 Z"
}

func usageChartMax(points []UsagePoint, metric string) string {
	max := 0.0
	for _, p := range points {
		max = math.Max(max, usageValue(p, metric))
	}
	if metric == "tokens" {
		return formatTokens(int64(max))
	}
	return formatCost(max)
}

func formatTokens(n int64) string {
	switch {
	case n >= 1_000_000_000:
		return fmt.Sprintf("%.2fB", float64(n)/1_000_000_000)
	case n >= 1_000_000:
		return fmt.Sprintf("%.2fM", float64(n)/1_000_000)
	case n >= 1_000:
		return fmt.Sprintf("%.1fK", float64(n)/1_000)
	default:
		return fmt.Sprintf("%d", n)
	}
}

func formatCost(n float64) string {
	if n == 0 {
		return "$0.00"
	}
	if n < 0.01 {
		return fmt.Sprintf("$%.4f", n)
	}
	return fmt.Sprintf("$%.2f", n)
}

func formatShare(g UsageGroup, total UsageData) string {
	denom := total.CostUSD
	if total.Metric == "tokens" {
		denom = float64(total.InputTokens + total.OutputTokens)
	}
	if denom == 0 {
		return "0.0%"
	}
	return fmt.Sprintf("%.1f%%", usageGroupValue(g, total.Metric)/denom*100)
}

func rangeName(days int) string {
	switch days {
	case 1:
		return "Past 24h"
	case 7:
		return "7 days"
	case 90:
		return "90 days"
	default:
		return "30 days"
	}
}

func usagePeriod(d UsageData) string {
	if d.Days == 1 {
		return "Past 24 hours"
	}
	return d.Start.Format("Jan 2") + " – " + d.End.Format("Jan 2")
}

func usageChartDate(t time.Time, days int) string {
	if days == 1 {
		return t.Format("15:04")
	}
	return strings.ToUpper(t.Format("Jan 2"))
}

templ AgentMark(agent string) {
	<span class={ "usage-agent-mark", "agent-" + agent }>
		if agent == "claude" {
			@Icon("sparkles", "ui-icon")
		} else {
			@Icon("bot", "ui-icon")
		}
	</span>
}

templ UsagePage(d UsageData) {
	<main id="main" class="settings-page usage-page">
		<header id="mainhead" class="mainhead">
			<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
			<nav class="crumbs"><span>Usage</span><span class="dim">/</span><span class="dim">{ usagePeriod(d) }</span></nav>
			<a class="btn icon ghost" href={ templ.SafeURL(usageURL(d.Days, d.Metric)) } title="Refresh usage" aria-label="Refresh usage">@Icon("refresh-cw", "ui-icon")</a>
		</header>
		<div class="settings-scroll">
			<div class="settings-shell usage-shell">
				@SettingsNav("usage")
				<div class="settings-content usage-content">
					<div class="usage-toolbar">
						<div class="segmented" aria-label="Usage metric">
							<a class={ templ.KV("current", d.Metric == "cost") } href={ templ.SafeURL(usageURL(d.Days, "cost")) }>Cost</a>
							<a class={ templ.KV("current", d.Metric == "tokens") } href={ templ.SafeURL(usageURL(d.Days, "tokens")) }>Tokens</a>
						</div>
						<div class="segmented" aria-label="Usage range">
							for _, days := range []int{1, 7, 30, 90} {
								<a class={ templ.KV("current", d.Days == days) } href={ templ.SafeURL(usageURL(days, d.Metric)) }>{ rangeName(days) }</a>
							}
						</div>
					</div>
					<div class="usage-overview">
						<section class="usage-summary">
							if d.Metric == "tokens" {
								<strong>{ formatTokens(d.InputTokens + d.OutputTokens) }</strong>
								<span class="dim">processed tokens</span>
							} else {
								<strong>{ formatCost(d.CostUSD) }</strong>
								<span class="dim">reported cost</span>
							}
							<span class="dim usage-session-count">{ fmt.Sprintf("%d turns across %d threads", d.Turns, d.Threads) }</span>
							<ul class="usage-agents">
								for _, group := range d.Agents {
									<li>
										@AgentMark(group.Agent)
										<span>{ group.Name } <small class="dim">{ fmt.Sprintf("%d turns", group.Turns) }</small></span>
										<strong>{ formatTokens(group.InputTokens + group.OutputTokens) }</strong>
										<small class="dim">{ formatCost(group.CostUSD) }</small>
									</li>
								}
							</ul>
						</section>
						<section class="usage-chart-wrap">
							<h2>Daily { d.Metric }</h2>
							<div class="usage-chart">
								<svg viewBox="0 0 800 250" role="img" aria-label={ "Daily " + d.Metric + " chart" } preserveAspectRatio="none">
									<line x1="48" y1="38" x2="772" y2="38" class="chart-grid"></line>
									<line x1="48" y1="130" x2="772" y2="130" class="chart-grid"></line>
									<line x1="48" y1="222" x2="772" y2="222" class="chart-grid"></line>
									<path d={ usageAreaPath(d.Daily, d.Metric) } class="chart-area"></path>
									<path d={ usageChartPath(d.Daily, d.Metric) } class="chart-line"></path>
								</svg>
								<span class="chart-max">{ usageChartMax(d.Daily, d.Metric) }</span>
								<span class="chart-zero">0</span>
								<span class="chart-start">{ usageChartDate(d.Start, d.Days) }</span>
								<span class="chart-end">{ usageChartDate(d.End, d.Days) }</span>
							</div>
						</section>
					</div>
					<section class="usage-totals">
						<h2>Totals</h2>
						<div>
							<dl><dt>Processed tokens</dt><dd>{ formatTokens(d.InputTokens + d.OutputTokens) }</dd></dl>
							<dl><dt>Input</dt><dd>{ formatTokens(d.InputTokens) }</dd></dl>
							<dl><dt>Output</dt><dd>{ formatTokens(d.OutputTokens) }</dd></dl>
							<dl><dt>Reported cost</dt><dd>{ formatCost(d.CostUSD) }</dd></dl>
							<dl><dt>Turns</dt><dd>{ fmt.Sprintf("%d", d.Turns) }</dd></dl>
						</div>
					</section>
					<section class="usage-breakdown">
						<h2>Breakdown</h2>
						<div class="usage-table-wrap">
							<table>
								<thead><tr><th>Model</th><th>Cost</th><th>Share</th><th>Tokens</th></tr></thead>
								<tbody>
									for _, group := range d.Models {
										<tr>
											<td><span class="usage-model"><span>@AgentMark(group.Agent)</span>{ group.Name }</span></td>
											<td>{ formatCost(group.CostUSD) }</td>
											<td class="dim">{ formatShare(group, d) }</td>
											<td class="dim">{ formatTokens(group.InputTokens + group.OutputTokens) }</td>
										</tr>
									}
									if len(d.Models) == 0 {
										<tr><td colspan="4" class="dim usage-empty">No completed turns in this period.</td></tr>
									}
								</tbody>
							</table>
						</div>
						<p class="dim usage-note">Costs are values reported by the agent. Codex currently reports token counts without a dollar cost.</p>
					</section>
				</div>
			</div>
		</div>
	</main>
}

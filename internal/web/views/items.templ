package views

import (
	"encoding/json"
	"net/url"
	pathpkg "path"
	"regexp"
	"starcode/internal/domain"
	"starcode/internal/store"
	"strings"
)

type toolMeta struct {
	Input   json.RawMessage `json:"input"`
	Summary string          `json:"summary"`
}

func meta(it store.Item) toolMeta {
	var m toolMeta
	json.Unmarshal(it.Meta, &m)
	return m
}

// toolSummary is the one-line label next to the tool name. Command tools
// carry a human-written description ("Run the test suite") that reads better
// than the command itself, which stays visible in the expanded input block.
func toolSummary(name string, m toolMeta) string {
	n := strings.ToLower(name)
	if strings.Contains(n, "bash") || strings.Contains(n, "command") || strings.Contains(n, "shell") {
		var in struct {
			Description string `json:"description"`
		}
		if json.Unmarshal(m.Input, &in) == nil && strings.TrimSpace(in.Description) != "" {
			return strings.TrimSpace(in.Description)
		}
	}
	return m.Summary
}

// attachmentRef is one "[Attached image "x" is saved at: /path]" line from a
// user message, split off the prompt so it renders as a legend instead.
type attachmentRef struct {
	Kind string // "image" | "file"
	Name string
	Path string
}

var attachLine = regexp.MustCompile(`^\[Attached (image|file) "(.+)" is saved at: (.+)\]$`)

// splitAttachments peels trailing attachment lines off a user message.
func splitAttachments(body string) (string, []attachmentRef) {
	lines := strings.Split(body, "\n")
	i := len(lines)
	var atts []attachmentRef
	for i > 0 {
		m := attachLine.FindStringSubmatch(strings.TrimSpace(lines[i-1]))
		if m == nil {
			break
		}
		atts = append([]attachmentRef{{Kind: m[1], Name: m[2], Path: m[3]}}, atts...)
		i--
	}
	return strings.TrimRight(strings.Join(lines[:i], "\n"), "\n"), atts
}

// attachmentURL serves the file through the attachments endpoint; the last
// two path segments are the thread id and the stored file name.
func attachmentURL(p string) string {
	p = strings.ReplaceAll(p, "\\", "/")
	return "/api/attachments/" + url.PathEscape(pathpkg.Base(pathpkg.Dir(p))) + "/" + url.PathEscape(pathpkg.Base(p))
}

templ Item(it store.Item) {
	switch it.Kind {
		case domain.KindUser:
			{{ text, atts := splitAttachments(it.Body) }}
			<div id={ "it-" + it.ID } class="item user">
				<div class="user-msg">
					if text != "" {
						<pre class="wrap bubble">{ text }</pre>
					}
					if len(atts) > 0 {
						<div class="attach-legend">
							for _, a := range atts {
								if a.Kind == "image" {
									<a href={ templ.SafeURL(attachmentURL(a.Path)) } target="_blank" title={ a.Name }><img class="attach-thumb" src={ attachmentURL(a.Path) } alt={ a.Name } loading="lazy"/></a>
								} else {
									<a class="attach-chip" href={ templ.SafeURL(attachmentURL(a.Path)) } target="_blank">
										@Icon("paperclip", "ui-icon")
										<span class="ellipsis">{ a.Name }</span>
									</a>
								}
							}
						</div>
					}
				</div>
			</div>
		case domain.KindAssistant:
			<div id={ "it-" + it.ID } class={ "item", "assistant", "md", templ.KV("streaming", it.Status == domain.ItemRunning) }>
				@templ.Raw(Markdown(it.Body))
			</div>
		case domain.KindThinking:
			<details id={ "it-" + it.ID } class="item thinking" data-preserve-attr="open">
				<summary><span class="tag">thinking</span> <span class="dim ellipsis">{ firstLine(it.Body) }</span></summary>
				<pre class="wrap dim">{ it.Body }</pre>
			</details>
		case domain.KindTool:
			@Tool(it)
		case domain.KindResult:
			<div id={ "it-" + it.ID } class={ "item", "result", "st-" + it.Status }>
				<span class="tag">@ItemIcon(it.Status) { it.Status }</span>
				<pre class="wrap dim">{ it.Body }</pre>
			</div>
		case domain.KindError:
			<div id={ "it-" + it.ID } class="item error">
				<span class="tag err">error</span>
				<pre class="wrap">{ it.Body }</pre>
			</div>
		default:
			<div id={ "it-" + it.ID } class="item system">
				<span class="tag dim">system</span>
				<pre class="wrap dim">{ it.Body }</pre>
			</div>
	}
}

templ Tool(it store.Item) {
	{{ m := meta(it) }}
	{{ input := PrettyJSON(m.Input) }}
	<details id={ "it-" + it.ID } class={ "item", "tool", "st-" + it.Status } open?={ it.Status == domain.ItemRunning } data-preserve-attr="open">
		<summary>
			<span class={ "glyph", "st-" + it.Status }>@ItemIcon(it.Status)</span>
			<span class="tag">{ it.ToolName }</span>
			<span class="ellipsis mono">{ toolSummary(it.ToolName, m) }</span>
		</summary>
		if input != "" {
			<pre class="block input">{ input }</pre>
		}
		if it.Output != "" {
			<pre class="block output">{ clip(it.Output, 20000) }</pre>
		}
	</details>
}

templ Approval(a store.Approval) {
	<div id={ "ap-" + a.ID } class="item approval">
		<div class="approval-head">
			<span class="tag warn">approval</span>
			<span class="mono">{ a.ToolName }</span>
			<span class="dim ellipsis">{ a.Description }</span>
		</div>
		{{ input := PrettyJSON(a.Input) }}
		if input != "" {
			<pre class="block input">{ clip(input, 4000) }</pre>
		}
		<div class="approval-actions">
			<button class="btn primary" data-on:click={ approveURL(a, domain.DecisionAllow) }>allow</button>
			<button class="btn" data-on:click={ approveURL(a, domain.DecisionAllowSession) }>allow for session</button>
			<button class="btn warn" data-on:click={ approveURL(a, domain.DecisionDeny) }>deny</button>
		</div>
	</div>
}

templ ApprovalResolved(a store.Approval) {
	<div id={ "ap-" + a.ID } class={ "item", "approval", "resolved", "d-" + a.Decision }>
		<span class="tag dim">approval</span>
		<span class="mono">{ a.ToolName }</span>
		<span class="dim">{ decisionLabel(a.Decision) }</span>
	</div>
}

func approveURL(a store.Approval, decision string) string {
	return "@post('/api/threads/" + a.ThreadID + "/approvals/" + a.ID + "/" + decision + "')"
}

func decisionLabel(d string) string {
	switch d {
	case domain.DecisionAllow:
		return "allowed"
	case domain.DecisionAllowSession:
		return "allowed for session"
	case domain.DecisionDeny:
		return "denied"
	}
	return d
}

func firstLine(s string) string {
	for i, r := range s {
		if r == '\n' {
			return s[:i]
		}
		if i > 120 {
			return s[:i] + "…"
		}
	}
	return s
}

func clip(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "\n… (truncated)"
}

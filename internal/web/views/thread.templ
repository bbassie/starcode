package views

import (
	"fmt"
	"starcode/internal/agent"
	"starcode/internal/domain"
	"starcode/internal/store"
	"strings"
	"time"
)

type ThreadData struct {
	Thread    store.Thread
	Project   store.Project
	Items     []store.Item
	Queued    []store.QueuedPrompt
	Approvals []store.Approval // every approval of the thread, oldest first
	Rules     []string
	Settings  SettingsData
	Branch    string
}

func busy(t store.Thread) bool {
	return t.Status == domain.StatusRunning || t.Status == domain.StatusAwaitingApproval
}

// Block is one row of the transcript: either a single item or a run of
// agent activity (thinking, tools, notices) folded into a "worked for"
// section.
type Block struct {
	Item *store.Item
	Work []store.Item
}

func IsWork(kind string) bool {
	switch kind {
	case domain.KindThinking, domain.KindTool, domain.KindSystem:
		return true
	}
	return false
}

// GroupItems folds consecutive work items into blocks.
func GroupItems(items []store.Item) []Block {
	var out []Block
	for i := range items {
		it := items[i]
		if IsWork(it.Kind) && len(out) > 0 && out[len(out)-1].Item == nil {
			out[len(out)-1].Work = append(out[len(out)-1].Work, it)
			continue
		}
		if IsWork(it.Kind) {
			out = append(out, Block{Work: []store.Item{it}})
			continue
		}
		out = append(out, Block{Item: &items[i]})
	}
	return out
}

// WorkState summarizes a work block for its header.
// pendingApprovals is the subset that still wants an answer.
func pendingApprovals(aps []store.Approval) []store.Approval {
	var out []store.Approval
	for _, a := range aps {
		if a.Decision == "" {
			out = append(out, a)
		}
	}
	return out
}

// WorkState sums up a work block: whether it is still going, how many
// tool calls it holds, and how long the agent spent on it. Time the turn
// stood still waiting for an approval is left out, since nothing was
// being worked on then.
func WorkState(items []store.Item, aps []store.Approval) (running bool, steps int, dur time.Duration) {
	first, last := items[0].CreatedAt, items[0].UpdatedAt
	for _, it := range items {
		if it.Status == domain.ItemRunning {
			running = true
		}
		if it.Kind == domain.KindTool {
			steps++
		}
		if it.UpdatedAt.After(last) {
			last = it.UpdatedAt
		}
	}
	if running {
		last = time.Now()
	}
	return running, steps, last.Sub(first) - waited(first, last, aps)
}

// waited is how much of the span from..to went by with an approval open.
// An approval still pending counts up to now; one answered before the
// store recorded answer times (or never, in a thread that ended without
// one) counts for nothing.
func waited(from, to time.Time, aps []store.Approval) time.Duration {
	var total time.Duration
	for _, a := range aps {
		start, end := a.CreatedAt, a.ResolvedAt
		if a.Decision == "" {
			end = time.Now()
		} else if end.IsZero() {
			continue
		}
		if start.Before(from) {
			start = from
		}
		if end.After(to) {
			end = to
		}
		if end.After(start) {
			total += end.Sub(start)
		}
	}
	return total
}

templ Thread(d ThreadData) {
	<main id="main" class="thread">
		@MainHead(d)
		@MessageRail(d.Items)
		<div id="items" class="items">
			<div class="items-inner">
				for _, b := range GroupItems(d.Items) {
					if b.Item != nil {
						@Item(*b.Item)
					} else {
						@Work(b.Work, d.Approvals)
					}
				}
				for _, a := range pendingApprovals(d.Approvals) {
					@Approval(a)
				}
			</div>
		</div>
		@BusyBar(d)
		// Shown by the layout's scroll script once the reader has scrolled
		// up; the transcript stops following the stream at that point.
		<div class="jump-wrap">
			<button class="btn round jump" type="button" title="Jump to latest" aria-label="Jump to latest" onclick="document.getElementById('items').scrollTo({ top: 1e9, behavior: 'smooth' })">@Icon("arrow-down", "ui-icon")</button>
		</div>
		@Composer(d)
	</main>
}

// BusyBar sits between the transcript and the composer while a turn runs.
// Streaming already shows movement; this covers the quiet stretches (the
// model thinking, a long tool call) with a shimmering word that the
// layout's clock script rotates, and the time the turn has been working.
// The bar hides while an approval is open, and the time it shows leaves
// those waits out: it counts from the turn's start moved forward by the
// time spent waiting, so the clock script can keep ticking from one
// timestamp.
templ BusyBar(d ThreadData) {
	<div id="busybar" class={ "busybar", templ.KV("on", d.Thread.Status == domain.StatusRunning) }>
		if d.Thread.Status == domain.StatusRunning {
			{{ since := workingSince(d) }}
			<span class="shimmer" data-busy-word>Working…</span>
			<span class="dim tiny-text" data-since={ since.UTC().Format(time.RFC3339) }>{ elapsedText(time.Since(since)) }</span>
		}
	</div>
}

// workingSince is the moment the running turn would have started had it
// never waited for an approval.
func workingSince(d ThreadData) time.Time {
	start := turnStartedAt(d)
	return start.Add(waited(start, time.Now(), d.Approvals))
}

// elapsedText matches the clock script's format: "12s", "1m 05s",
// "1h 02m 05s".
func elapsedText(d time.Duration) string {
	s := int(d.Round(time.Second).Seconds())
	if s < 0 {
		s = 0
	}
	switch {
	case s < 60:
		return fmt.Sprintf("%ds", s)
	case s < 3600:
		return fmt.Sprintf("%dm %02ds", s/60, s%60)
	}
	return fmt.Sprintf("%dh %02dm %02ds", s/3600, s%3600/60, s%60)
}

// turnStartedAt is when the running turn began: the last prompt's time,
// or the thread's last change when the transcript is empty.
func turnStartedAt(d ThreadData) time.Time {
	for i := len(d.Items) - 1; i >= 0; i-- {
		if d.Items[i].Kind == domain.KindUser {
			return d.Items[i].CreatedAt
		}
	}
	return d.Thread.UpdatedAt
}

// TabTitle is the browser tab text: the thread title with a marker in
// front while a turn runs or waits for an approval, so a thread left in
// another tab (or on the phone's home screen) shows when it needs a look.
func TabTitle(t store.Thread) string {
	switch t.Status {
	case domain.StatusAwaitingApproval:
		return "[!] " + t.Title
	case domain.StatusRunning:
		return "● " + t.Title
	}
	return t.Title
}

// MessageRail is a compact map of the prompts in this thread. Hovering a
// marker previews the message; activating it jumps to the corresponding row.
templ MessageRail(items []store.Item) {
	<nav id="message-rail" class="message-rail" aria-label="Sent messages">
		for _, it := range items {
			if it.Kind == domain.KindUser {
				{{ preview := promptPreview(it.Body) }}
				<a class="message-marker" href={ templ.SafeURL("#it-" + it.ID) } aria-label={ "Jump to message: " + promptSummary(it.Body) }>
					<span class="message-tick"></span>
					<span class="message-preview">{ preview }</span>
				</a>
			}
		}
	</nav>
}

// MainHead is the breadcrumb row; patched on rename and status change.
templ MainHead(d ThreadData) {
	<header id="mainhead" class="mainhead">
		<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
		<nav class="crumbs ellipsis">
			<a href="/">{ d.Project.Name }</a>
			<span class="dim">/</span>
			// The title is a button that swaps in the rename box; Enter or
			// the save button posts, Escape and blur put the title back.
			<button type="button" class="crumb-title ellipsis" title="Rename thread" data-show="!$rename" data-preserve-attr="style" data-on:click={ "$title = " + jsq(d.Thread.Title) + "; $rename = true; renameFocus()" }>{ d.Thread.Title }</button>
			<form class="rename" data-show="$rename" data-preserve-attr="style" style="display: none" data-on:submit={ "evt.preventDefault(); @post('/api/threads/" + d.Thread.ID + "/rename')" }>
				<input class="in" type="text" data-bind:title autocomplete="off" spellcheck="false" maxlength="200" data-on:keydown="evt.key === 'Escape' && (evt.preventDefault(), $rename = false)" data-on:blur="!el.form.contains(evt.relatedTarget) && ($rename = false)"/>
				// mousedown is stopped so the click does not blur the input
				// before the submit lands.
				<button class="btn icon tiny" type="submit" title="Save title" aria-label="Save title" data-on:mousedown="evt.preventDefault()">@Icon("check", "ui-icon")</button>
			</form>
		</nav>
		if d.Thread.Archived {
			<span class="status-pill st-idle" title="Archived: sending a message unarchives it">@Icon("archive", "ui-icon") <span>archived</span></span>
		}
		<span class={ "status-pill", "st-" + d.Thread.Status } title={ d.Thread.StatusDetail }>@StatusIcon(d.Thread.Status) <span>{ statusLabel(d.Thread.Status) }</span></span>
		<span class="dim tiny-text hide-sm ellipsis" title="Model reported by the agent">@Icon("bot", "ui-icon") <span class="ellipsis">{ modelShown(d.Thread) }</span></span>
		<span class="spacer"></span>
		if d.Branch != "" {
			<span class="dim tiny-text hide-sm">@Icon("git-branch", "ui-icon") <span>{ d.Branch }</span></span>
		}
		<button class="btn ghost" data-on:click="$term = !$term" title="Toggle terminal">@Icon("terminal", "ui-icon") <span class="hide-sm">terminal</span></button>
		<button class="btn ghost gittoggle" data-on:click="$git = !$git" title="Toggle changes panel">@Icon("git-compare-arrows", "ui-icon") <span class="hide-sm">changes</span></button>
		if d.Thread.Archived {
			<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/unarchive')" } title="Move this thread back into its project">@Icon("archive-restore", "ui-icon") <span class="hide-sm">unarchive</span></button>
		} else {
			<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/archive')" } title="Archive thread (hidden from the lists, kept in full)">@Icon("archive", "ui-icon") <span class="hide-sm">archive</span></button>
		}
		<button class="btn ghost dim" data-on:click={ "confirm('Delete this thread?') && @post('/api/threads/" + d.Thread.ID + "/delete')" } title="Delete thread"><span class="hide-sm">delete</span><span class="show-sm">@Icon("trash-2", "ui-icon")</span></button>
	</header>
}

func modelShown(t store.Thread) string {
	if t.ResolvedModel != "" {
		return t.ResolvedModel
	}
	if t.Model != "" {
		return t.Model
	}
	return "default model"
}

func statusLabel(s string) string {
	switch s {
	case domain.StatusAwaitingApproval:
		return "needs approval"
	}
	return s
}

// Work is a folded run of agent activity. Open while it is still going.
templ Work(items []store.Item, aps []store.Approval) {
	{{ running, _, _ := WorkState(items, aps) }}
	<details id={ "work-" + items[0].ID } class={ "work", templ.KV("running", running) } open?={ running } data-preserve-attr="open">
		@WorkSummary(items, aps)
		<div class="work-body">
			for _, it := range items {
				@Item(it)
			}
		</div>
	</details>
}

templ WorkSummary(items []store.Item, aps []store.Approval) {
	{{ running, steps, dur := WorkState(items, aps) }}
	<summary id={ "wsum-" + items[0].ID } class="work-head">
		if running {
			<span class="shimmer">Working…</span>
		} else {
			<span>Worked for { elapsedText(dur) }</span>
		}
		if steps > 0 {
			<span class="dim">· { fmt.Sprintf("%d %s", steps, plural(steps, "step", "steps")) }</span>
		}
	</summary>
}

templ PromptQueue(d ThreadData) {
	<div id="prompt-queue" class={ "prompt-queue", templ.KV("empty", len(d.Queued) == 0) }>
		if len(d.Queued) > 0 {
			<div class="queue-head">
				<span>@Icon("list-end", "ui-icon") <span>{ fmt.Sprintf("%d %s queued", len(d.Queued), plural(len(d.Queued), "message", "messages")) }</span></span>
			</div>
			<div class="queue-list">
				for i, q := range d.Queued {
					<div class="queue-item">
						<span class="queue-position">{ fmt.Sprintf("%d", i+1) }</span>
						<span class="ellipsis" title={ promptSummary(q.Body) }>{ promptSummary(q.Body) }</span>
						<button class="btn icon ghost" type="button" title="Remove queued message" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/remove')" }>@Icon("x", "ui-icon")</button>
					</div>
				}
			</div>
		}
	</div>
}

// draftPost saves the composer text on a pause in typing. Only the prompt
// signal travels: the attachments ride the signals as base64 and have no
// place in a draft.
func draftPost(key string) string {
	return "@post('/api/drafts/" + key + "', {filterSignals: {include: /^prompt$/}})"
}

// SessionRules is the strip of "allow for session" rules above the
// composer, each with a button that revokes it.
templ SessionRules(d ThreadData) {
	if len(d.Rules) > 0 {
		<div class="rules">
			<span class="dim tiny-text" title="Requests matching these are allowed without asking until revoked">@Icon("shield-check", "ui-icon") <span>allowed for session</span></span>
			for _, k := range d.Rules {
				<span class="rule-chip">
					<span class="mono">{ k }</span>
					<button type="button" class="rule-x" title={ "Revoke: ask again for " + k } aria-label={ "Revoke " + k } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/rules/revoke?key=" + urlQuery(k) + "')" }>@Icon("x", "ui-icon")</button>
				</span>
			}
		</div>
	}
}

func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

// AttachButton is the composer's paperclip: a hidden file input whose picks
// land base64-encoded in the $attach signal and ride along with the send.
templ AttachButton() {
	<label class="btn icon ghost" title="Attach files to the message">
		@Icon("paperclip", "ui-icon")
		// The value resets when $attach empties (clear button, sent turn) so
		// picking the same file again always fires a change event.
		<input type="file" multiple data-bind:attach data-on:click="el.value = ''" data-effect="$attach.length === 0 && (el.value = '')" style="display: none"/>
	</label>
}

// AttachStrip shows the picked files above the composer row. The layout's
// change listener renders one removable item per file into .attach-thumbs
// from the input, which is the source of truth; the strip hides when
// $attach empties, so stale items never show.
templ AttachStrip() {
	<div class="attachments" data-show="$attach.length > 0" data-preserve-attr="style" style="display: none">
		<div class="attach-thumbs"></div>
	</div>
}

// ContextMeter is the gauge next to the setting chips: a ring showing how
// much of the model's context window this conversation already takes up.
// It reads the last number the agent sent, so it is empty until the first
// turn and moves while one runs. Clicking it opens a card with the
// numbers, a button that compacts the conversation, and one that opens
// the model picker, since a bigger window is the other way out of a full
// one. The card is a pick like the setting menus, so the same signal,
// keys and outside-click rules apply.
templ ContextMeter(d ThreadData) {
	{{ t := d.Thread }}
	{{ used, window := t.ContextTokens, contextWindow(d) }}
	{{ pct := contextPct(used, window) }}
	<div id="context-meter" class={ "pick", "ctx", templ.KV("empty", used <= 0) } data-on:click__outside="$pick == 'context' && !evt.target.closest('.pick') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		if used > 0 {
			<button type="button" class={ "chip", "ctx-chip", contextLevel(pct) } title="Context window" data-on:click={ pickToggle("context") } data-class:open="$pick == 'context'">
				if window > 0 {
					@ContextRing(pct)
					<span class="chip-label">{ fmt.Sprintf("%d%%", pct) }</span>
				} else {
					@Icon("gauge", "ui-icon")
					<span class="chip-label">{ formatTokens(used) }</span>
				}
			</button>
			<div class="pick-menu pick-context" data-show="$pick == 'context'" data-preserve-attr="style" style="display: none">
				<div class="ctx-card">
					<div class="pick-head">Context window</div>
					<div class="ctx-figures">
						<span class="ctx-big">{ formatTokens(used) }</span>
						if window > 0 {
							<span class="dim">{ fmt.Sprintf("of %s tokens · %d%%", windowLabel(window), pct) }</span>
						} else {
							<span class="dim">tokens; this agent does not say how big the window is</span>
						}
					</div>
					if window > 0 {
						<div class={ "ctx-track", contextLevel(pct) }><span class="ctx-fill" style={ barWidth(pct) }></span></div>
					}
					<p class="dim tiny-text">{ contextModelLine(d, window) }</p>
					<p class="dim tiny-text">The last request's size: the cached prefix, the new input and the reply. Compacting folds the conversation so far into a summary the agent goes on from.</p>
					<div class="ctx-actions">
						<button type="button" class="btn" disabled?={ busy(t) } title={ compactTitle(t) } data-on:click={ "$pick = ''; @post('/api/threads/" + t.ID + "/compact')" }>@Icon("fold-vertical", "ui-icon") <span>Compact</span></button>
						<button type="button" class="btn ghost" title="Open the model picker" data-on:click="$pick = 'model'; pickFocus(el)">@Icon("bot", "ui-icon") <span>Switch model</span></button>
					</div>
				</div>
			</div>
		}
	</div>
}

// ContextRing is the donut in the chip: a track and an arc over pct of
// it. pathLength makes the dash lengths percentages, and the arc starts
// at the top.
templ ContextRing(pct int) {
	<svg class="ctx-ring" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
		<circle class="ctx-ring-track" cx="10" cy="10" r="7.5" pathLength="100"></circle>
		<circle class="ctx-ring-fill" cx="10" cy="10" r="7.5" pathLength="100" stroke-dasharray={ ringDash(pct) } transform="rotate(-90 10 10)"></circle>
	</svg>
}

// ringDash is the arc as a dash: pct long, then a gap that covers the
// rest. A sliver stays visible at the low end, as with the bar.
func ringDash(pct int) string {
	return fmt.Sprintf("%d 100", max(pct, 2))
}

// contextModelLine names the model the reading belongs to and its window.
func contextModelLine(d ThreadData, window int64) string {
	name := modelLabel(d.Settings.Caps[d.Thread.Agent], d.Thread.Model, d.Settings.CapsErrs[d.Thread.Agent])
	// The id the agent resolved the choice to, unless the label says it.
	if r := d.Thread.ResolvedModel; r != "" && r != d.Thread.Model && !strings.Contains(name, r) {
		name += " (" + r + ")"
	}
	if window > 0 {
		return name + " · " + windowLabel(window) + " window"
	}
	return name
}

func compactTitle(t store.Thread) string {
	if busy(t) {
		return "Wait for the current turn to finish"
	}
	return "Fold the conversation so far into a summary"
}

// contextWindow is what the thread is measured against: the limit the
// agent reported for the model that ran, or failing that the one the
// catalog gives the model now selected. 0 when neither knows.
func contextWindow(d ThreadData) int64 {
	if d.Thread.ContextWindow > 0 {
		return d.Thread.ContextWindow
	}
	return catalogWindow(d.Settings.Caps[d.Thread.Agent], d.Thread.Model)
}

// catalogWindow is a model's window as its agent's catalog states it. An
// empty id means the agent's default model.
func catalogWindow(c agent.Capabilities, id string) int64 {
	if id == "" {
		m, ok := defaultModel(c)
		if !ok {
			return 0
		}
		return m.ContextWindow
	}
	for _, m := range c.Models {
		if m.ID == id {
			return m.ContextWindow
		}
	}
	return 0
}

// contextPct rounds the fill up, so a window with anything in it never
// reads as 0% and a full one never as 99%.
func contextPct(used, window int64) int {
	if used <= 0 || window <= 0 {
		return 0
	}
	pct := int((used*100 + window - 1) / window)
	return min(pct, 100)
}

// contextLevel colours the bar. Agents start compacting somewhere past
// three quarters, so warn there and call it full close to the limit.
func contextLevel(pct int) string {
	switch {
	case pct >= 90:
		return "full"
	case pct >= 75:
		return "warn"
	}
	return ""
}

func barWidth(pct int) string {
	return fmt.Sprintf("width: %d%%", max(pct, 2))
}

// windowLabel writes a context size the way the model cards do: 200K, 1M.
// A size that is not round falls back to the usage page's format.
func windowLabel(n int64) string {
	switch {
	case n <= 0:
		return ""
	case n%1_000_000 == 0:
		return fmt.Sprintf("%dM", n/1_000_000)
	case n%1_000 == 0:
		return fmt.Sprintf("%dK", n/1_000)
	}
	return formatTokens(n)
}

// Composer is the prompt card. Its setting chips post on change, also
// while a turn runs: the permission mode reaches the running agent when it
// can take one, the rest applies from the next turn.
templ Composer(d ThreadData) {
	{{ t := d.Thread }}
	{{ locked := busy(t) }}
	<form
		id="composer"
		class={ "composer", templ.KV("busy", locked) }
		data-signals={ signalsJSON(t.Agent, t.Model, t.Effort, t.PermissionMode, "") }
		data-on:submit={ "evt.preventDefault(); @post('/api/threads/" + t.ID + "/send')" }
	>
		@SessionRules(d)
		@PromptQueue(d)
		<textarea
			class="prompt"
			rows="1"
			placeholder={ promptPlaceholder(d) }
			data-bind:prompt
			data-on:keydown={ "sendKey(evt) && (evt.preventDefault(), @post('/api/threads/" + t.ID + "/send'))" }
			data-on:input__debounce.600ms={ draftPost(t.ID) }
			data-effect="$prompt; autoGrow(el)"
			autocomplete="off"
			spellcheck="false"
		></textarea>
		@AttachStrip()
		<div class="composer-row">
			@AttachButton()
			@Chips(d.Settings, "@post('/api/threads/"+t.ID+"/settings')", len(d.Items) > 0)
			@ContextMeter(d)
			<span class="spacer"></span>
			if locked {
				<button class="btn round warn" type="button" data-on:click={ "@post('/api/threads/" + t.ID + "/interrupt')" } title="Stop">@Icon("square", "ui-icon")</button>
			}
			<button class="btn round primary" type="submit" title={ sendTitle(locked) }>@Icon("arrow-up", "ui-icon")</button>
		</div>
	</form>
}

func promptPlaceholder(d ThreadData) string {
	if d.Thread.Status == domain.StatusAwaitingApproval {
		return "Answer the approval above, or queue a follow-up…"
	}
	if busy(d.Thread) {
		return "Add a follow-up… (sent when this turn ends)"
	}
	if len(d.Items) == 0 {
		return "Describe what " + d.Thread.Agent + " should do in " + d.Project.Name + "…"
	}
	if d.Thread.Archived {
		return "Reply… (this moves the thread out of the archive)"
	}
	return "Reply…"
}

// sendTitle is the send button's tooltip. The key hint is only true on a
// hardware keyboard (see sendKey in layout.templ), which is also the only
// place a tooltip shows.
func sendTitle(queued bool) string {
	if queued {
		return "Queue message (Enter, or Ctrl+Enter)"
	}
	return "Send (Enter, or Ctrl+Enter)"
}

func promptSummary(body string) string {
	text, atts := splitAttachments(body)
	text = strings.TrimSpace(firstLine(text))
	if text == "" {
		if len(atts) == 1 {
			return atts[0].Name
		}
		if len(atts) > 1 {
			return fmt.Sprintf("%d attachments", len(atts))
		}
		return "Message"
	}
	r := []rune(text)
	if len(r) > 120 {
		return string(r[:117]) + "…"
	}
	return text
}

func promptPreview(body string) string {
	text, atts := splitAttachments(body)
	text = strings.TrimSpace(text)
	if text == "" {
		return promptSummary(body)
	}
	if len(atts) > 0 {
		text += fmt.Sprintf("\n%d %s", len(atts), plural(len(atts), "attachment", "attachments"))
	}
	r := []rune(text)
	if len(r) > 280 {
		return string(r[:277]) + "…"
	}
	return text
}

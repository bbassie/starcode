package views

import (
	"fmt"
	"net/url"
	"starcode/internal/agent"
	"starcode/internal/domain"
	"starcode/internal/keys"
	"starcode/internal/store"
	"strconv"
	"strings"
	"time"
)

type ThreadData struct {
	Thread    store.Thread
	Project   store.Project
	Items     []store.Item
	Queued    []store.QueuedPrompt
	// Steering are the prompts handed to the running turn that the agent
	// has not taken yet.
	Steering  []store.QueuedPrompt
	Approvals []store.Approval // every approval of the thread, oldest first
	Rules     []string
	Settings  SettingsData
	Branch    string
	// PR is the polled state of the linked pull request; Number is 0
	// when the thread has none. Repo is the PR's repository when it is
	// one of the project's remotes, so the panel can show the PR; empty
	// otherwise.
	PR   store.PRState
	Repo string
	// Limits is the thread's instance's plan windows, for the context
	// card; empty until the first read.
	Limits []agent.LimitWindow
	// Stashed is how many prompts the stash holds, for the stash button.
	Stashed int
	// Parent is the thread whose agent spawned this one; ID is empty when
	// the reader opened it.
	Parent store.Thread
	// Scheduled are the thread's schedules (send later, cron), shown with
	// the queue.
	Scheduled []store.Schedule
	// Notify is what the thread pushes to the reader's devices
	// (store.NotifyAll, NotifyInput, NotifyOff).
	Notify string
	// Full renders every item. Otherwise the transcript starts at its
	// last stretch (see SplitTail) with a button that loads the rest, so
	// a long thread does not cost its whole history on every open and
	// every reconnect, which a phone does often.
	Full bool
}

// tailKeep is how many items the transcript shows before the reader asks
// for the rest; the cut moves back to the prompt that started that
// stretch, so it always opens on a turn's beginning.
const tailKeep = 40

// SplitTail cuts items into the part the page leaves out and the part it
// shows. The shown part holds at least tailKeep items and starts at a
// user prompt when one is near enough; a short transcript is all tail.
func SplitTail(items []store.Item) (head, tail []store.Item) {
	if len(items) <= tailKeep {
		return nil, items
	}
	cut := len(items) - tailKeep
	// Walk back to the prompt that began this stretch, but not past
	// another tailKeep items: a very long turn still gets a bounded page.
	for i := cut; i >= 0 && i > cut-tailKeep; i-- {
		if items[i].Kind == domain.KindUser {
			cut = i
			break
		}
	}
	return items[:cut], items[cut:]
}

func busy(t store.Thread) bool {
	return t.Status == domain.StatusRunning || t.Status == domain.StatusAwaitingApproval
}

// Block is one row of the transcript: either a single item or a run of
// agent activity (thinking, tools, notices) folded into a "worked for"
// section.
type Block struct {
	Item *store.Item
	Work []store.Item
}

// IsWork is whether an item is agent activity, which folds into "worked
// for" blocks. A question to the human is conversation and stays out.
func IsWork(it store.Item) bool {
	switch it.Kind {
	case domain.KindThinking, domain.KindSystem:
		return true
	case domain.KindTool:
		return QuestionsOf(it) == nil
	}
	return false
}

// GroupItems folds consecutive work items into blocks. A subagent's
// items (those with a parent) are left out: they render under their Task.
func GroupItems(items []store.Item) []Block {
	items, _ = Nest(items)
	var out []Block
	for i := range items {
		it := items[i]
		if IsWork(it) && len(out) > 0 && out[len(out)-1].Item == nil {
			out[len(out)-1].Work = append(out[len(out)-1].Work, it)
			continue
		}
		if IsWork(it) {
			out = append(out, Block{Work: []store.Item{it}})
			continue
		}
		out = append(out, Block{Item: &items[i]})
	}
	return out
}

// first is the block's first item.
func (b Block) first() store.Item {
	if b.Item != nil {
		return *b.Item
	}
	return b.Work[0]
}

// Turn is a prompt and what the agent did with it: the rows from a user
// message up to the next one. Rows before the first prompt (a branch
// notice, or the start of a cut transcript) make a turn of their own.
type Turn struct {
	ID   string // the first item's id
	Rows []Block
}

// GroupTurns splits items into turns of blocks (see GroupItems).
func GroupTurns(items []store.Item) []Turn {
	var out []Turn
	for _, b := range GroupItems(items) {
		if len(out) == 0 || (b.Item != nil && b.Item.Kind == domain.KindUser) {
			out = append(out, Turn{ID: b.first().ID})
		}
		out[len(out)-1].Rows = append(out[len(out)-1].Rows, b)
	}
	return out
}

// PageTurn is the id of the last turn a thread page draws: the page
// shows the tail of items (SplitTail) unless full.
func PageTurn(items []store.Item, full bool) string {
	if !full {
		_, items = SplitTail(items)
	}
	turns := GroupTurns(items)
	if len(turns) == 0 {
		return ""
	}
	return turns[len(turns)-1].ID
}

// Fold splits a turn for display into the prompt, the rows folded under
// one "Worked for" header, and the rest in order. A turn folds once it
// ended on its own with a reply: what came between the prompt and the
// last reply goes under the header, along with the work after that
// reply, so the prompt, the reply and the result stay in view. A turn
// still running, stopped or failed is shown whole, to see where it got
// to, and so is one with a single row to fold, which reads as well on
// its own.
func (t Turn) Fold() (head, folded, rest []Block) {
	rows := t.Rows
	start := 0
	if rows[0].Item != nil && rows[0].Item.Kind == domain.KindUser {
		start = 1
	}
	head, rest = rows[:start], rows[start:]
	end := len(rows) - 1
	if res := rows[end].Item; res == nil || res.Kind != domain.KindResult || res.Status != domain.ItemDone {
		return head, nil, rest
	}
	final := -1
	for i := end - 1; i >= start; i-- {
		if it := rows[i].Item; it != nil && it.Kind == domain.KindAssistant && ParentOf(*it) == "" {
			final = i
			break
		}
	}
	if final < 0 {
		return head, nil, rest
	}
	folded = append(folded, rows[start:final]...)
	after := []Block{rows[final]}
	for _, b := range rows[final+1 : end] {
		if b.Item == nil {
			folded = append(folded, b)
		} else {
			after = append(after, b)
		}
	}
	if len(folded) < 2 {
		return head, nil, rest
	}
	return head, folded, append(after, rows[end])
}

// blockItems is the top-level items of blocks, in order.
func blockItems(bs []Block) []store.Item {
	var out []store.Item
	for _, b := range bs {
		if b.Item != nil {
			out = append(out, *b.Item)
		} else {
			out = append(out, b.Work...)
		}
	}
	return out
}

// pendingApprovals is the subset that still wants an answer.
func pendingApprovals(aps []store.Approval) []store.Approval {
	var out []store.Approval
	for _, a := range aps {
		if a.Decision == "" {
			out = append(out, a)
		}
	}
	return out
}

// WorkState sums up a work block: whether it is still going, how many
// tool calls it holds, and how long the agent spent on it. Time the turn
// stood still waiting for an approval is left out, since nothing was
// being worked on then.
func WorkState(items []store.Item, aps []store.Approval) (running bool, steps int, dur time.Duration) {
	first, last := items[0].CreatedAt, items[0].UpdatedAt
	for _, it := range items {
		if it.Status == domain.ItemRunning {
			running = true
		}
		if it.Kind == domain.KindTool {
			steps++
		}
		if it.UpdatedAt.After(last) {
			last = it.UpdatedAt
		}
	}
	if running {
		last = time.Now()
	}
	return running, steps, last.Sub(first) - waited(first, last, aps)
}

// waited is how much of the span from..to went by with an approval open.
// An approval still pending counts up to now; one answered before the
// store recorded answer times (or never, in a thread that ended without
// one) counts for nothing.
func waited(from, to time.Time, aps []store.Approval) time.Duration {
	var total time.Duration
	for _, a := range aps {
		start, end := a.CreatedAt, a.ResolvedAt
		if a.Decision == "" {
			end = time.Now()
		} else if end.IsZero() {
			continue
		}
		if start.Before(from) {
			start = from
		}
		if end.After(to) {
			end = to
		}
		if end.After(start) {
			total += end.Sub(start)
		}
	}
	return total
}

templ Thread(d ThreadData) {
	<main id="main" class="thread">
		@MainHead(d)
		@MessageRail(d.Items)
		{{ head, tail := SplitTail(d.Items) }}
		if d.Full {
			{{ head, tail = nil, d.Items }}
		}
		<div id="items" class="items">
			<div class="items-inner">
				if len(head) > 0 {
					@LoadEarlier(d.Thread.ID, len(head), tail[0].Seq)
				}
				@Blocks(tail, d.Approvals)
				// The cards waiting for an answer stay last; a new turn
				// goes in before them.
				<div id="approvals" class="approvals">
					for _, a := range pendingApprovals(d.Approvals) {
						@Approval(a)
					}
				</div>
			</div>
		</div>
		@BusyBar(d)
		// Shown by the layout's scroll script once the reader has scrolled
		// up; the transcript stops following the stream at that point.
		<div class="jump-wrap">
			<button class="btn round jump" type="button" title="Jump to latest" aria-label="Jump to latest" onclick="document.getElementById('items').scrollTo({ top: 1e9, behavior: 'smooth' })">@Icon("arrow-down", "ui-icon")</button>
		</div>
		@Composer(d)
	</main>
}

// Blocks renders items as transcript rows, turn by turn.
templ Blocks(items []store.Item, aps []store.Approval) {
	{{ _, kids := Nest(items) }}
	for _, t := range GroupTurns(items) {
		@TurnView(t, aps, kids)
	}
}

// TurnView is one turn, folded when it is finished (see Turn.Fold). The
// stream appends to it while the turn runs and redraws it once at the
// end, when it folds.
templ TurnView(t Turn, aps []store.Approval, kids map[string][]store.Item) {
	{{ head, folded, rest := t.Fold() }}
	<div id={ "turn-" + t.ID } class="turn">
		@rows(head, aps, kids)
		if len(folded) > 0 {
			@TurnFold(t.ID, folded, aps, kids)
		}
		@rows(rest, aps, kids)
	</div>
}

templ rows(bs []Block, aps []store.Approval, kids map[string][]store.Item) {
	for _, b := range bs {
		if b.Item != nil {
			@ItemWith(*b.Item, kids)
		} else {
			@Work(b.Work, aps, kids)
		}
	}
}

// TurnFold holds what a finished turn did before its reply, under one
// header with the time it took and what it did.
templ TurnFold(id string, bs []Block, aps []store.Approval, kids map[string][]store.Item) {
	{{ items := blockItems(bs) }}
	{{ _, steps, dur := WorkState(items, aps) }}
	<details id={ "fold-" + id } class="work turn-fold" data-preserve-attr="open">
		<summary class="work-head">
			<span class="work-took">Worked for { elapsedText(dur) }</span>
			if sum := workSummary(ctx, items); sum != "" {
				<span class="dim ellipsis work-sum">· { sum }</span>
			} else if steps > 0 {
				<span class="dim">· { fmt.Sprintf("%d %s", steps, plural(steps, "step", "steps")) }</span>
			}
			<span class="dim tiny-text row-ts" data-ts={ items[0].CreatedAt.UTC().Format(time.RFC3339) }></span>
		</summary>
		<div class="work-body">
			@rows(bs, aps, kids)
		</div>
	</details>
}

// LoadEarlier is the button at the top of a cut transcript. The fetch
// prepends the rows before seq and removes the button; $full keeps a
// reconnect from cutting the transcript again, and the layout's scroll
// script (loadEarlier) holds the reader's place while the rows land.
templ LoadEarlier(threadID string, n int, seq int64) {
	<button id="load-earlier" type="button" class="btn ghost load-earlier" data-on:click={ "$full = true; loadEarlier(el); @query('/api/threads/" + threadID + "/items?before=" + strconv.FormatInt(seq, 10) + "')" }>@Icon("chevrons-up", "ui-icon") <span>{ strconv.Itoa(n) } earlier { plural(n, "item", "items") }</span></button>
}

// Earlier wraps the rows the button fetched in one element, so a prepend
// keeps their order; display: contents leaves the layout to the list.
templ Earlier(items []store.Item, aps []store.Approval) {
	<div class="earlier">
		@Blocks(items, aps)
	</div>
}

// BusyBar sits between the transcript and the composer while a turn runs.
// Streaming already shows movement; this covers the quiet stretches (the
// model thinking, a long tool call) with a shimmering word that the
// layout's clock script rotates, and the time the turn has been working.
// The bar hides while an approval is open, and the time it shows leaves
// those waits out: it counts from the turn's start moved forward by the
// time spent waiting, so the clock script can keep ticking from one
// timestamp. The header carries a moving line along its foot for the same
// turn, so a phone that has scrolled the bar away still shows work.
templ BusyBar(d ThreadData) {
	<div id="busybar" class={ "busybar", templ.KV("on", d.Thread.Status == domain.StatusRunning) }>
		if d.Thread.Status == domain.StatusRunning {
			{{ since := workingSince(d) }}
			@Icon("loader-circle", "ui-icon spin-icon busy-spin")
			<span class="shimmer" data-busy-word>Working…</span>
			<span class="dim tiny-text" data-since={ since.UTC().Format(time.RFC3339) }>{ elapsedText(time.Since(since)) }</span>
			if n := AgentsRunning(d.Items); n > 0 {
				<span class="dim tiny-text">@Icon("bot", "ui-icon") <span>{ fmt.Sprintf("%d %s", n, plural(n, "agent", "agents")) }</span></span>
			}
		}
	</div>
}

// workingSince is the moment the running turn would have started had it
// never waited for an approval.
func workingSince(d ThreadData) time.Time {
	start := turnStartedAt(d)
	return start.Add(waited(start, time.Now(), d.Approvals))
}

// elapsedText matches the clock script's format: "12s", "1m 05s",
// "1h 02m 05s".
func elapsedText(d time.Duration) string {
	s := int(d.Round(time.Second).Seconds())
	if s < 0 {
		s = 0
	}
	switch {
	case s < 60:
		return fmt.Sprintf("%ds", s)
	case s < 3600:
		return fmt.Sprintf("%dm %02ds", s/60, s%60)
	}
	return fmt.Sprintf("%dh %02dm %02ds", s/3600, s%3600/60, s%60)
}

// turnStartedAt is when the running turn began: the last prompt's time,
// or the thread's last change when the transcript is empty.
func turnStartedAt(d ThreadData) time.Time {
	for i := len(d.Items) - 1; i >= 0; i-- {
		if d.Items[i].Kind == domain.KindUser {
			return d.Items[i].CreatedAt
		}
	}
	return d.Thread.UpdatedAt
}

// TabTitle is the browser tab text: the thread title with a marker in
// front while a turn runs or waits for an approval, so a thread left in
// another tab (or on the phone's home screen) shows when it needs a look.
func TabTitle(t store.Thread) string {
	switch t.Status {
	case domain.StatusAwaitingApproval:
		return "[!] " + t.Title
	case domain.StatusRunning:
		return "● " + t.Title
	}
	return t.Title
}

// MessageRail is a compact map of the prompts in this thread. Hovering a
// marker previews the message; activating it jumps to the corresponding row.
templ MessageRail(items []store.Item) {
	<nav id="message-rail" class="message-rail" aria-label="Sent messages">
		for _, it := range items {
			if it.Kind == domain.KindUser {
				{{ preview := promptPreview(it.Body) }}
				<a class="message-marker" href={ templ.SafeURL("#it-" + it.ID) } aria-label={ "Jump to message: " + promptSummary(it.Body) }>
					<span class="message-tick"></span>
					<span class="message-preview">{ preview }</span>
				</a>
			}
		}
	</nav>
}

// MainHead is the breadcrumb row; patched on rename and status change.
templ MainHead(d ThreadData) {
	<header id="mainhead" class={ "mainhead", templ.KV("running", d.Thread.Status == domain.StatusRunning) }>
		<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
		<nav class="crumbs ellipsis">
			// On a phone the title gets the whole row; the project is one
			// tap away in the thread list.
			<a class="hide-sm" href="/">{ d.Project.Name }</a>
			<span class="dim hide-sm">/</span>
			// A spawned thread leads back to the thread that spawned it.
			if d.Parent.ID != "" {
				<a class="hide-sm ellipsis crumb-parent" href={ templ.SafeURL("/threads/" + d.Parent.ID) } title="The thread whose agent started this one">{ d.Parent.Title }</a>
				<span class="dim hide-sm">/</span>
			}
			// The title is a button that swaps in the rename box; Enter or
			// the save button posts, Escape and blur put the title back.
			<button type="button" class="crumb-title ellipsis" title="Rename thread" data-show="!$rename" data-preserve-attr="style" data-on:click={ "$title = " + jsq(d.Thread.Title) + "; $rename = true; renameFocus()" }>{ d.Thread.Title }</button>
			<form class="rename" data-show="$rename" data-preserve-attr="style" style="display: none" data-on:submit={ "evt.preventDefault(); @post('/api/threads/" + d.Thread.ID + "/rename')" }>
				<input class="in" type="text" data-bind:title autocomplete="off" spellcheck="false" enterkeyhint="done" maxlength="200" data-on:keydown="evt.key === 'Escape' && (evt.preventDefault(), $rename = false)" data-on:blur="!el.form.contains(evt.relatedTarget) && ($rename = false)"/>
				// mousedown is stopped so the click does not blur the input
				// before the submit lands.
				<button class="btn icon tiny" type="submit" title="Save title" aria-label="Save title" data-on:mousedown="evt.preventDefault()">@Icon("check", "ui-icon")</button>
				// The agent's small model reads the conversation and names
				// it; a few seconds and a fraction of a cent.
				<button class="btn icon tiny ghost retitle" type="button" title="Write a title from the conversation" aria-label="Write a title from the conversation" data-indicator:_retitling data-attr:disabled="$_retitling" data-class:busy="$_retitling" data-on:mousedown="evt.preventDefault()" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/retitle')" }>@Icon("sparkles", "ui-icon")</button>
			</form>
		</nav>
		if d.Thread.Archived {
			<span class="status-pill st-idle" title="Settled: sending a message brings the thread back">@Icon("archive", "ui-icon") <span>settled</span></span>
		}
		if d.Notify == store.NotifyOff {
			<span class="status-pill st-idle" title="This thread sends no notifications (change it in the menu)">@Icon("bell-off", "ui-icon")</span>
		} else if d.Notify == store.NotifyInput {
			<span class="status-pill st-idle" title="This thread notifies only when it needs you (change it in the menu)">@Icon("bell-dot", "ui-icon")</span>
		}
		if d.Thread.Snoozed() {
			<button type="button" class="status-pill st-idle" title={ snoozeTitle(d.Thread) } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/wake')" }>@Icon("alarm-clock", "ui-icon") <span class="hide-sm">until </span><time data-local={ d.Thread.SnoozedUntil.UTC().Format(time.RFC3339) }>{ d.Thread.SnoozedUntil.UTC().Format("Jan 2 15:04") }</time></button>
		}
		// With a reason behind the status (an error, what the agent is
		// waiting on) the pill is a button that shows it under the header;
		// a title attribute alone never shows on a phone. A plain running
		// turn gets no pill: the busy bar and the sweep along the header's
		// foot already say so, and a spinner here would be a third one.
		if d.Thread.StatusDetail != "" {
			<button type="button" class={ "status-pill", "st-" + d.Thread.Status } title={ d.Thread.StatusDetail } data-on:click="$stat = !$stat">@StatusIcon(d.Thread.Status) <span>{ statusLabel(d.Thread.Status) }</span></button>
			<div class="status-detail" data-show="$stat" data-preserve-attr="style" style="display: none" data-on:click__outside="$stat && !evt.target.closest('.status-pill') && ($stat = false)">{ d.Thread.StatusDetail }</div>
		} else if d.Thread.Status != domain.StatusRunning {
			<span class={ "status-pill", "st-" + d.Thread.Status }>@StatusIcon(d.Thread.Status) <span>{ statusLabel(d.Thread.Status) }</span></span>
		}
		if d.Thread.Status == "error" && authFailure(d.Thread.StatusDetail) {
			// The CLI lost its sign-in; the providers page can get it back
			// without a terminal, and the next prompt here runs on it.
			<a class="btn tiny primary" href={ templ.SafeURL("/settings/providers?sel=" + d.Thread.Agent) } title={ d.Thread.StatusDetail }>@Icon("log-in", "ui-icon") sign in</a>
		}
		if pr := prOf(d.Thread, map[store.PR]store.PRState{d.PR.PR: d.PR}); pr.Number > 0 {
			// The chip opens the panel on the PR when it is in the project's
			// repository; a PR elsewhere opens on GitHub. The unlink button
			// sits next to it since the panel cannot show every PR.
			if pr.Repo == d.Repo {
				<button type="button" class="pr-chip-btn" data-on:click={ "$git = true; $panelTab = 'prs'; @query('/api/projects/" + d.Project.ID + "/prs/" + strconv.Itoa(pr.Number) + "?thread=" + d.Thread.ID + "')" } title={ prChipTitle(pr) + ". Open it in the panel" }>
					@PRChip(pr, prWord(pr))
				</button>
			} else {
				<a class="pr-chip-btn" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener" title={ prChipTitle(pr) + " in " + pr.Repo + ". Open on GitHub" }>
					@PRChip(pr, prWord(pr))
				</a>
			}
			<button class="btn icon ghost tiny dim pr-unlink" data-on:click={ "confirm('Unlink pull request #" + strconv.Itoa(pr.Number) + " from this thread?') && @post('/api/threads/" + d.Thread.ID + "/pr/unlink')" } title="Unlink the pull request from this thread" aria-label="Unlink the pull request">@Icon("unlink", "ui-icon")</button>
			// The watch wakes the agent when the PR changes (app.PRWatch).
			if d.Thread.PRWatch != "" {
				<button class="btn ghost tiny pr-watch on" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/pr/unwatch')" } title={ "Watching #" + strconv.Itoa(pr.Number) + ": " + prWatchWhat + " Click to stop." } aria-label="Stop watching the pull request">@Icon("eye", "ui-icon") <span class="hide-sm">watching</span></button>
			} else if pr.State == "" || pr.State == "open" {
				<button class="btn ghost tiny dim pr-watch" data-indicator:_watching data-attr:disabled="$_watching" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/pr/watch')" } title={ "Watch #" + strconv.Itoa(pr.Number) + ": " + prWatchWhat } aria-label="Watch the pull request">@Icon("eye", "ui-icon") <span class="hide-sm">watch</span></button>
			}
		}
		<span class="spacer"></span>
		if d.Branch != "" {
			<span class="dim tiny-text hide-sm" title={ "Branch " + d.Branch }>
				@Icon("git-branch", "ui-icon")
				<span>{ MidTrunc(d.Branch, 36) }</span>
			</span>
		}
		// The thread's folder in VS Code on the reader's machine; the
		// layout's vscodeOpen builds the link. Left out on a phone, which
		// has no VS Code to hand it to.
		{{ dir := d.Project.Path }}
		// Icons only, like the panel toggles of an editor; the one whose
		// panel is open is lit.
		<button class="btn icon ghost vscode-open" type="button" data-on:click={ VSCodeOpen(dir) } title={ "Open " + dir + " in VS Code" } aria-label="Open in VS Code">@Icon("brand-vscode", "ui-icon")</button>
		<button class="btn icon ghost termtoggle" data-on:click="$term = !$term" data-class:on="$term" title="Toggle terminal" aria-label="Toggle terminal">@Icon("terminal", "ui-icon")</button>
		<button class="btn icon ghost gittoggle" data-on:click="$git = !$git" data-class:on="$git" title="Toggle changes panel" aria-label="Toggle changes panel">@Icon("git-compare-arrows", "ui-icon")</button>
		// Pin, branch, hand off, settle and delete live behind this
		// button on every screen; terminal and changes stay in the row.
		<button class="btn icon ghost more-toggle" type="button" data-on:click="$more = !$more" title="More" aria-label="More actions">@Icon("ellipsis-vertical", "ui-icon")</button>
		<div class="head-more" data-class:open="$more" data-on:click__outside="$more && !evt.target.closest('.more-toggle') && ($more = false)" data-on:click="evt.target.closest('.snooze-at') || ($more = false)">
			if d.Thread.Snoozed() {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/wake')" } title="Bring the thread back into the list now">@Icon("sunrise", "ui-icon") <span class="hide-sm">wake</span></button>
			}
			// Snooze: the browser works the time out, in its own zone.
			<div class="head-more-group">
				<span class="dim tiny-text head-more-label">@Icon("alarm-clock", "ui-icon") <span>snooze until</span></span>
				<div class="snooze-opts">
					@snoozeButton(d.Thread.ID, "1h", "in 1 hour")
					@snoozeButton(d.Thread.ID, "3h", "in 3 hours")
					@snoozeButton(d.Thread.ID, "tomorrow", "tomorrow 9:00")
					@snoozeButton(d.Thread.ID, "week", "Monday 9:00")
				</div>
				<label class="snooze-at dim tiny-text">
					<span>or at</span>
					<input class="in" type="datetime-local" data-on:change={ "el.value && (@post('/api/threads/" + d.Thread.ID + "/snooze?until=' + encodeURIComponent(snoozeAt('at', el.value))), $more = false)" }/>
				</label>
			</div>
			<div class="head-more-group">
				<span class="dim tiny-text head-more-label">@Icon("bell", "ui-icon") <span>notify me</span></span>
				<div class="snooze-opts">
					@notifyButton(d, store.NotifyAll, "always", "When a turn ends, and when it needs you")
					@notifyButton(d, store.NotifyInput, "when it needs me", "Only for approvals, questions and the agent asking for you")
					@notifyButton(d, store.NotifyOff, "never", "No notifications from this thread")
				</div>
			</div>
			<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/unread?leave=1')" } title="Mark unread and leave it for later">@Icon("mail", "ui-icon") <span class="hide-sm">mark unread</span></button>
			if d.Thread.Pinned {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/unpin')" } title="Unpin: back into date order">@Icon("pin-off", "ui-icon") <span class="hide-sm">unpin</span></button>
			} else {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/pin')" } title="Pin to the top of the project's list">@Icon("pin", "ui-icon") <span class="hide-sm">pin</span></button>
			}
			if len(d.Items) > 0 {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/branch')" } title={ branchHint }>@Icon("git-fork", "ui-icon") <span class="hide-sm">branch</span></button>
				for _, name := range d.Settings.Agents {
					if name != d.Thread.Agent {
						<button class="btn ghost dim" data-on:click={ "confirm(" + jsq(handoffAsk(d, name)) + ") && @post('/api/threads/" + d.Thread.ID + "/handoff?agent=" + url.QueryEscape(name) + "')" } title={ "A new thread on " + instanceLabel(d.Settings, name) + " takes the work over from here, with this conversation to read" }>@Icon("arrow-right-left", "ui-icon") <span class="hide-sm">hand off to { instanceLabel(d.Settings, name) }</span></button>
					}
				}
			}
			if d.Thread.Archived {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/unarchive')" } title="Bring this thread back into the list">@Icon("archive-restore", "ui-icon") <span class="hide-sm">unsettle</span></button>
			} else {
				<button class="btn ghost dim" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/archive')" } title="Settle: move the thread to the Settled section, kept in full">@Icon("archive", "ui-icon") <span class="hide-sm">settle</span></button>
			}
			<button class="btn ghost dim" data-on:click={ "confirm('Delete this thread?') && @post('/api/threads/" + d.Thread.ID + "/delete')" } title="Delete thread">@Icon("trash-2", "ui-icon") <span class="hide-sm">delete</span></button>
		</div>
	</header>
}

// prWatchWhat says what a watch on a pull request does.
const prWatchWhat = "starcode checks it every minute and tells the agent when a check fails or they all pass, someone else comments or reviews, or the branch starts to conflict. It stops when the PR merges or closes."

// snoozeTitle is the tooltip on the header's snooze pill.
func snoozeTitle(t store.Thread) string {
	if t.SnoozeResume {
		return "Waiting for the usage limit to reset: the turn resumes then. Click to wake it now, which cancels that."
	}
	return "Snoozed: it comes back into the list then. Click to wake it now."
}

// branchHint is the header's tooltip on branch.
const branchHint = "Branch: a new thread that carries on from here with a fork of this conversation, while this one stays as it is. Both work in the project's checkout."

// handoffAsk is the question before a handoff to agent name.
func handoffAsk(d ThreadData, name string) string {
	msg := "Hand this work over to " + instanceLabel(d.Settings, name) + "?\n\nA new thread on it gets this conversation as a file, reads it and the changes, and tells you where things stand before it changes anything."
	return msg + " This thread stays as it is."
}

// instanceLabel is the display name of agent instance name.
func instanceLabel(sd SettingsData, name string) string {
	if l := sd.Looks[name].Label; l != "" {
		return l
	}
	return name
}

// VSCodeOpen is the expression that opens dir in VS Code (vscodeOpen in
// the layout script).
func VSCodeOpen(dir string) string {
	return "vscodeOpen(" + jsq(dir) + ")"
}

func modelShown(t store.Thread) string {
	if t.ResolvedModel != "" {
		return t.ResolvedModel
	}
	if t.Model != "" {
		return t.Model
	}
	return "default model"
}

// authFailure is whether a turn's error is the CLI having lost its
// sign-in (an expired or revoked OAuth session), which the providers
// page can fix.
func authFailure(detail string) bool {
	d := strings.ToLower(detail)
	return strings.Contains(d, "oauth") || strings.Contains(d, "failed to authenticate") || strings.Contains(d, "not logged in")
}

func statusLabel(s string) string {
	switch s {
	case domain.StatusAwaitingApproval:
		return "needs approval"
	}
	return s
}

// Work is a run of agent activity. Two steps or more fold under a header,
// folded while they run too: the header says what the agent is doing
// (see WorkSummary), and a tap opens it, which morphs keep.
templ Work(items []store.Item, aps []store.Approval, kids map[string][]store.Item) {
	if len(items) == 1 {
		// One step reads as itself; a header over it would say the same.
		// The wrapper keeps the block's id for the stream, which turns it
		// into a folded block when a second step lands.
		<div id={ "work-" + items[0].ID } class="work-one">
			@ItemWith(items[0], kids)
		</div>
	} else {
		@workFolded(items, aps, kids)
	}
}

templ workFolded(items []store.Item, aps []store.Approval, kids map[string][]store.Item) {
	{{ running, _, _ := WorkState(items, aps) }}
	<details id={ "work-" + items[0].ID } class={ "work", templ.KV("running", running) } data-preserve-attr="open">
		@WorkSummary(items, aps)
		<div class="work-body">
			for _, it := range items {
				@ItemWith(it, kids)
			}
		</div>
	</details>
}

templ WorkSummary(items []store.Item, aps []store.Approval) {
	{{ running, steps, dur := WorkState(items, aps) }}
	<summary id={ "wsum-" + items[0].ID } class="work-head">
		if running {
			{{ icon, text := liveStep(ctx, items) }}
			if text != "" {
				<span class="work-live">
					if icon != "" {
						@Icon(icon, "ui-icon")
					}
					<span class="shimmer ellipsis">{ text }</span>
				</span>
			} else {
				<span class="shimmer">Working…</span>
			}
		} else {
			<span class="work-took">Worked for { elapsedText(dur) }</span>
			if sum := workSummary(ctx, items); sum != "" {
				<span class="dim ellipsis work-sum">· { sum }</span>
			} else if steps > 0 {
				<span class="dim">· { fmt.Sprintf("%d %s", steps, plural(steps, "step", "steps")) }</span>
			}
		}
		<span class="dim tiny-text row-ts" data-ts={ items[0].CreatedAt.UTC().Format(time.RFC3339) }></span>
	</summary>
}

templ PromptQueue(d ThreadData) {
	<div id="prompt-queue" class={ "prompt-queue", templ.KV("empty", len(d.Queued) == 0 && len(d.Scheduled) == 0 && len(d.Steering) == 0) }>
		if len(d.Steering) > 0 {
			// Handed to the running turn: the agent reads them after the
			// step it is on, and they go into the transcript there.
			<div class="queue-head">
				<span>@Icon("corner-down-right", "ui-icon") <span>{ fmt.Sprintf("%s in after the current step", plural(len(d.Steering), "Goes", "Go")) }</span></span>
			</div>
			<div class="queue-list">
				for _, q := range d.Steering {
					<div class="queue-item steering" title="Sent into the running turn; the agent reads it when the current step is done">
						<span class="queue-position">@Icon("corner-down-right", "ui-icon")</span>
						<span class="ellipsis shimmer">{ promptSummary(q.Body) }</span>
					</div>
				}
			</div>
		}
		if len(d.Scheduled) > 0 {
			<div class="queue-list">
				for _, sc := range d.Scheduled {
					@scheduledRow(sc)
				}
			</div>
		}
		if len(d.Queued) > 0 {
			<div class="queue-head">
				<span>@Icon("list-end", "ui-icon") <span>{ fmt.Sprintf("%d %s queued", len(d.Queued), plural(len(d.Queued), "message", "messages")) }</span></span>
			</div>
			<div class="queue-list">
				for i, q := range d.Queued {
					<div class="queue-item" data-class:editing={ "$qedit == '" + q.ID + "'" }>
						<span class="queue-position">{ fmt.Sprintf("%d", i+1) }</span>
						<span class="ellipsis" title={ promptSummary(q.Body) } data-show={ "$qedit != '" + q.ID + "'" } data-preserve-attr="style">{ promptSummary(q.Body) }</span>
						// Editing happens in place, so the prompt keeps its turn.
						<form class="queue-edit" data-show={ "$qedit == '" + q.ID + "'" } data-preserve-attr="style" style="display: none" data-on:submit={ "evt.preventDefault(); @post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/edit', {filterSignals: {include: /^qbody$/}})" }>
							<textarea class="in" rows="3" data-bind:qbody data-on:keydown="evt.key === 'Escape' ? (evt.preventDefault(), $qedit = '') : sendKey(evt) && (evt.preventDefault(), el.form.requestSubmit())"></textarea>
							<button class="btn icon tiny" type="submit" title="Save">@Icon("check", "ui-icon")</button>
						</form>
						if busy(d.Thread) {
							// Into the running turn, after its current step.
							<button class="btn ghost tiny queue-now" type="button" title="Send now: into the running turn, after its current step" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/steer')" }>@Icon("corner-down-right", "ui-icon") <span>now</span></button>
						}
						if len(d.Queued) > 1 {
							<button class="btn icon ghost queue-move" type="button" title="Move up" disabled?={ i == 0 } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/move?by=-1')" }>@Icon("arrow-up", "ui-icon")</button>
							<button class="btn icon ghost queue-move" type="button" title="Move down" disabled?={ i == len(d.Queued)-1 } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/move?by=1')" }>@Icon("arrow-down", "ui-icon")</button>
						}
						<button class="btn icon ghost" type="button" title="Edit" data-on:click={ "$qbody = " + jsq(q.Body) + "; $qedit = '" + q.ID + "'; setTimeout(() => el.closest('.queue-item').querySelector('textarea')?.focus())" }>@Icon("pencil", "ui-icon")</button>
						<button class="btn icon ghost" type="button" title="Remove queued message" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/queue/" + q.ID + "/remove')" }>@Icon("x", "ui-icon")</button>
					</div>
				}
			</div>
		}
	</div>
}

// draftPost saves the composer text on a pause in typing. Only the prompt
// signal travels: the attachments ride the signals as base64 and have no
// place in a draft.
func draftPost(key string) string {
	return "@post('/api/drafts/" + key + "', {filterSignals: {include: /^prompt$/}})"
}

// SessionRules is the strip of "allow for session" rules above the
// composer, each with a button that revokes it.
templ SessionRules(d ThreadData) {
	<div id="session-rules">
		if len(d.Rules) > 0 {
			<div class="rules">
			<span class="dim tiny-text" title="Requests matching these are allowed without asking until revoked">@Icon("shield-check", "ui-icon") <span>allowed for session</span></span>
			for _, k := range d.Rules {
				<span class="rule-chip">
					<span class="mono">{ k }</span>
					<button type="button" class="rule-x" title={ "Revoke: ask again for " + k } aria-label={ "Revoke " + k } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/rules/revoke?key=" + urlQuery(k) + "')" }>@Icon("x", "ui-icon")</button>
				</span>
			}
		</div>
		}
	</div>
}

func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

// AttachButton is the composer's paperclip: a hidden file input whose picks
// land base64-encoded in the $_attach signal and ride along with the send.
templ AttachButton() {
	<label class="btn icon ghost attach-btn" title="Attach files to the message">
		<span class="hide-sm">@Icon("paperclip", "ui-icon")</span>
		<span class="show-sm">@Icon("plus", "ui-icon")</span>
		// The value resets when $_attach empties (clear button, sent turn) so
		// picking the same file again always fires a change event.
		<input type="file" multiple data-bind:_attach data-on:click="el.value = ''" data-effect="$_attach.length === 0 && (el.value = '')" style="display: none"/>
	</label>
}

// AttachStrip shows the picked files above the composer row. The layout's
// change listener renders one removable item per file into .attach-thumbs
// from the input, which is the source of truth; the strip hides when
// $_attach empties, so stale items never show.
templ AttachStrip() {
	<div class="attachments" data-show="$_attach.length > 0" data-preserve-attr="style" style="display: none">
		<div class="attach-thumbs"></div>
	</div>
}

// StashPick is the stash button and its menu, in the composer's top right
// corner. With text in the composer the button puts it aside; in an empty
// one it lists what is stashed, to bring one back. It only shows when it
// has one of those to do: n is how many prompts are stashed, kept in the
// stashn signal by the stash endpoints. key is the composer's draft key.
// The stash hotkey presses the button, shown or not.
templ StashPick(key string, n int) {
	<div class="pick pick-stash" data-signals:stashn={ strconv.Itoa(n) } data-show="$prompt.trim() != '' || $stashn > 0" data-preserve-attr="style" style={ hiddenUnless(n > 0) } data-on:click__outside="$pick == 'stash' && !evt.target.closest('.pick') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		<button type="button" class="btn icon ghost stash-btn" title={ "Stash: put the prompt aside, or bring a stashed one back (" + keys.Display(Key("stash")) + ")" } aria-label="Stash" data-on:click={ stashClick(key) } data-class:open="$pick == 'stash'">@Icon("bookmark", "ui-icon")</button>
		<div class="pick-menu pick-stash-menu" data-show="$pick == 'stash'" data-preserve-attr="style" style="display: none">
			<div class="pick-head">Stashed prompts</div>
			<div id="stash-list" class="stash-list"><p class="dim tiny-text pad">loading…</p></div>
		</div>
	</div>
}

// stashClick stashes the text, or opens the menu over an empty composer.
// Only the prompt travels; the attachments stay and the count says so.
func stashClick(key string) string {
	return "$prompt.trim() ? @post('/api/stash?key=" + key + "&att=' + $_attach.length, {filterSignals: {include: /^prompt$/}}) : ($pick = $pick == 'stash' ? '' : 'stash', $pick && @query('/api/stash?key=" + key + "'))"
}

// nudgeTokens and nudgeIdle are when the composer suggests compacting: a
// conversation this big, left this long, has lost the prompt cache, and
// the next prompt pays to read all of it again. They are Claude Code's
// own: its terminal offers a summary on resuming a conversation of 100K
// tokens or more that sat for 70 minutes, and T3 Code uses the same.
const (
	nudgeTokens = 100_000
	nudgeIdle   = 70 * time.Minute
)

// CompactNudge offers to compact a big conversation that has sat idle,
// above the composer: past nudgeIdle the prompt cache is gone and the
// next prompt pays to read every token again. While the chip is on, a
// send compacts first and the prompt goes out after the summary
// (sendQuery in the layout adds ?compact=1). Turning it off sends with
// the full history; this browser keeps that for this size of
// conversation. It hides while a turn runs.
templ CompactNudge(d ThreadData) {
	{{ t := d.Thread }}
	if t.ContextTokens >= nudgeTokens && time.Since(t.UpdatedAt) >= nudgeIdle && !busy(t) {
		{{ key := fmt.Sprintf("keepfull:%s:%d", t.ID, t.ContextTokens/10_000) }}
		<div class="compact-nudge" data-key={ key } data-show="!$locked" data-preserve-attr="style class" data-init={ "localStorage.getItem(" + jsq(key) + ") && (el.classList.add('off'), el.querySelector('.compact-chip').setAttribute('aria-pressed', 'false'))" }>
			@Icon("fold-vertical", "ui-icon")
			<span class="nudge-text">
				<strong>{ fmt.Sprintf("%dK tokens", (t.ContextTokens+500)/1000) }</strong>{ fmt.Sprintf(", idle for %s. ", idleWords(time.Since(t.UpdatedAt))) }
				<span class="nudge-on">Sending compacts them into a summary first.</span>
				<span class="nudge-off">The next prompt re-reads all of them uncached.</span>
			</span>
			<button type="button" class="chip compact-chip" aria-pressed="true" title="On: the next send compacts first. Off: it sends with the full history." data-on:click="compactToggle(el)">
				@Icon("check", "ui-icon chip-check")
				<span>{ fmt.Sprintf("compact %dK", (t.ContextTokens+500)/1000) }</span>
			</button>
		</div>
	}
}

// idleWords is a rough "3 hours", "2 days".
func idleWords(d time.Duration) string {
	switch {
	case d < 2*time.Hour:
		return "over an hour"
	case d < 48*time.Hour:
		return fmt.Sprintf("%d hours", int(d.Hours()))
	}
	return fmt.Sprintf("%d days", int(d.Hours()/24))
}

// ContextMeter is the gauge next to the setting chips: a ring showing how
// much of the model's context window this conversation already takes up.
// It reads the last number the agent sent, so it is empty until the first
// turn and moves while one runs. Clicking it opens a card with the
// numbers, a button that compacts the conversation, and one that opens
// the model picker, since a bigger window is the other way out of a full
// one. The card is a pick like the setting menus, so the same signal,
// keys and outside-click rules apply.
templ ContextMeter(d ThreadData) {
	{{ t := d.Thread }}
	{{ used, window := t.ContextTokens, contextWindow(d) }}
	{{ pct := contextPct(used, window) }}
	<div id="context-meter" class={ "pick", "ctx", templ.KV("empty", used <= 0) } data-on:click__outside="$pick == 'context' && !evt.target.closest('.pick') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		if used > 0 {
			<button type="button" class={ "chip", "ctx-chip", contextLevel(pct) } title="Context window" data-on:click={ pickToggle("context") } data-class:open="$pick == 'context'">
				if window > 0 {
					@ContextRing(pct)
					<span class="chip-label">{ fmt.Sprintf("%d%%", pct) }</span>
				} else {
					@Icon("gauge", "ui-icon")
					<span class="chip-label">{ formatTokens(used) }</span>
				}
			</button>
			<div class="pick-menu pick-context" data-show="$pick == 'context'" data-preserve-attr="style" style="display: none">
				<div class="ctx-card">
					<div class="pick-head">Context window</div>
					<div class="ctx-figures">
						<span class="ctx-big">{ formatTokens(used) }</span>
						if window > 0 {
							<span class="dim">{ fmt.Sprintf("of %s tokens · %d%%", windowLabel(window), pct) }</span>
						} else {
							<span class="dim">tokens; this agent does not say how big the window is</span>
						}
					</div>
					if window > 0 {
						<div class={ "ctx-track", contextLevel(pct) }><span class="ctx-fill" style={ barWidth(pct) }></span></div>
					}
					<p class="dim tiny-text">{ contextModelLine(d, window) }</p>
					<p class="dim tiny-text">The last request's size: the cached prefix, the new input and the reply. Compacting folds the conversation so far into a summary the agent goes on from.</p>
					if len(d.Limits) > 0 {
						<div class="pick-head ctx-limits-head">Plan limits</div>
						@LimitBars(d.Limits)
					}
					<div class="ctx-actions">
						<button type="button" class="btn" disabled?={ busy(t) } title={ compactTitle(t) } data-on:click={ "$pick = ''; @post('/api/threads/" + t.ID + "/compact')" }>@Icon("fold-vertical", "ui-icon") <span>Compact</span></button>
						<button type="button" class="btn ghost" title="Open the model picker" data-on:click="$pick = 'model'; pickFocus(el)">@Icon("bot", "ui-icon") <span>Switch model</span></button>
					</div>
				</div>
			</div>
		}
	</div>
}

// ContextRing is the donut in the chip: a track and an arc over pct of
// it. pathLength makes the dash lengths percentages, and the arc starts
// at the top.
templ ContextRing(pct int) {
	<svg class="ctx-ring" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
		<circle class="ctx-ring-track" cx="10" cy="10" r="7.5" pathLength="100"></circle>
		<circle class="ctx-ring-fill" cx="10" cy="10" r="7.5" pathLength="100" stroke-dasharray={ ringDash(pct) } transform="rotate(-90 10 10)"></circle>
	</svg>
}

// ringDash is the arc as a dash: pct long, then a gap that covers the
// rest. A sliver stays visible at the low end, as with the bar.
func ringDash(pct int) string {
	return fmt.Sprintf("%d 100", max(pct, 2))
}

// contextModelLine names the model the reading belongs to and its window.
func contextModelLine(d ThreadData, window int64) string {
	name := modelLabel(d.Settings.Caps[d.Thread.Agent], d.Thread.Model, d.Settings.CapsErrs[d.Thread.Agent])
	// The id the agent resolved the choice to, unless the label says it.
	if r := d.Thread.ResolvedModel; r != "" && r != d.Thread.Model && !strings.Contains(name, r) {
		name += " (" + r + ")"
	}
	if window > 0 {
		return name + " · " + windowLabel(window) + " window"
	}
	return name
}

func compactTitle(t store.Thread) string {
	if busy(t) {
		return "Wait for the current turn to finish"
	}
	return "Fold the conversation so far into a summary"
}

// contextWindow is what the thread is measured against: the limit the
// agent reported for the model that ran, or failing that the one the
// catalog gives the model now selected. 0 when neither knows.
func contextWindow(d ThreadData) int64 {
	if d.Thread.ContextWindow > 0 {
		return d.Thread.ContextWindow
	}
	return catalogWindow(d.Settings.Caps[d.Thread.Agent], d.Thread.Model)
}

// catalogWindow is a model's window as its agent's catalog states it. An
// empty id means the agent's default model.
func catalogWindow(c agent.Capabilities, id string) int64 {
	if id == "" {
		m, ok := defaultModel(c)
		if !ok {
			return 0
		}
		return m.ContextWindow
	}
	for _, m := range c.Models {
		if m.ID == id {
			return m.ContextWindow
		}
	}
	return 0
}

// contextPct rounds the fill up, so a window with anything in it never
// reads as 0% and a full one never as 99%.
func contextPct(used, window int64) int {
	if used <= 0 || window <= 0 {
		return 0
	}
	pct := int((used*100 + window - 1) / window)
	return min(pct, 100)
}

// contextLevel colours the bar. Agents start compacting somewhere past
// three quarters, so warn there and call it full close to the limit.
func contextLevel(pct int) string {
	switch {
	case pct >= 90:
		return "full"
	case pct >= 75:
		return "warn"
	}
	return ""
}

func barWidth(pct int) string {
	return fmt.Sprintf("width: %d%%", max(pct, 2))
}

// windowLabel writes a context size the way the model cards do: 200K, 1M.
// A size that is not round falls back to the usage page's format.
func windowLabel(n int64) string {
	switch {
	case n <= 0:
		return ""
	case n%1_000_000 == 0:
		return fmt.Sprintf("%dM", n/1_000_000)
	case n%1_000 == 0:
		return fmt.Sprintf("%dK", n/1_000)
	}
	return formatTokens(n)
}

// Composer is the prompt card. Its setting chips post on change, also
// while a turn runs: the permission mode reaches the running agent when it
// can take one, the rest applies from the next turn.
// What flips with the thread's status (the busy border, the placeholder,
// the stop button) is driven by the locked and placeholder signals and
// the #composer-actions element, so a status change costs a signal patch
// and a few buttons instead of the whole card with every model list in
// it (see conn.renderHead).
templ Composer(d ThreadData) {
	{{ t := d.Thread }}
	{{ locked := busy(t) }}
	<form
		id="composer"
		class={ "composer", templ.KV("busy", locked) }
		data-class:busy="$locked"
		data-signals={ signalsJSON(t.Agent, t.Model, t.Effort, t.PermissionMode, composerSignals(d)) }
		data-on:submit={ "evt.preventDefault(); @post('/api/threads/" + t.ID + "/send' + sendQuery(), " + withSignal("_attach") + ")" }
	>
		@SessionRules(d)
		@CompactNudge(d)
		@PromptQueue(d)
		// The slash command menu (static/slash.js) fills this above the prompt.
		<div class="slash-menu"></div>
		// The box holds the stash button in its corner, over the prompt.
		<div class="prompt-box">
			<textarea
				class="prompt"
				rows="1"
				placeholder={ promptPlaceholder(d) }
				data-attr:placeholder="$placeholder"
				data-bind:prompt
				data-on:keydown={ "sendKey(evt) && (evt.preventDefault(), @post('/api/threads/" + t.ID + "/send' + sendQuery(evt), " + withSignal("_attach") + "))" }
				data-on:input__debounce.600ms={ draftPost(t.ID) }
				data-effect="$prompt; autoGrow(el)"
				autocomplete="off"
				autocapitalize="sentences"
				enterkeyhint="enter"
			></textarea>
			@StashPick(t.ID, d.Stashed)
		</div>
		@AttachStrip()
		<div class="composer-row">
			@AttachButton()
			@Chips(d.Settings, "@post('/api/threads/"+t.ID+"/settings')", len(d.Items) > 0)
			@ContextMeter(d)
			<span class="spacer"></span>
			@ComposerActions(d)
		</div>
	</form>
}

// ComposerActions is the stop button while a turn runs and the send button.
templ ComposerActions(d ThreadData) {
	{{ locked := busy(d.Thread) }}
	<div id="composer-actions" class="composer-actions">
		if locked {
			// What a send does while the turn runs (sendQuery in
			// layout.templ): the browser's choice, flipped for one send
			// by a tap here or by Ctrl+Enter.
			<button class="chip busy-mode" type="button" data-init="busyModeShow(el)" data-preserve-attr="data-mode data-alt" data-on:click="el.dataset.alt = el.dataset.alt ? '' : '1'; busyModeShow(el)">
				<span class="m-steer" title="Sends into the running turn: the agent reads it after its current step. Tap to queue it for after the turn instead.">@Icon("corner-down-right", "ui-icon") <span>steer</span></span>
				<span class="m-queue" title="Queues it for after the turn. Tap to send it into the running turn instead.">@Icon("list-end", "ui-icon") <span>queue</span></span>
				<span class="m-stop" title="Stops the turn and sends it first. Tap to queue it for after the turn instead.">@Icon("square", "ui-icon") <span>stop + send</span></span>
			</button>
			<button class="btn round warn" type="button" data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/interrupt')" } title="Stop">@Icon("square", "ui-icon")</button>
		}
		@SendLater(d.Thread.ID)
		<button class="btn round primary" type="submit" title={ sendTitle(locked) }>@Icon("arrow-up", "ui-icon")</button>
	</div>
}

// composerSignals are the status-driven signals of the composer, as the
// extra part of its data-signals object and, in ComposerSignals, as the
// map a status change patches.
func composerSignals(d ThreadData) string {
	return fmt.Sprintf("locked: %t, placeholder: %q", busy(d.Thread), promptPlaceholder(d))
}

func ComposerSignals(d ThreadData) map[string]any {
	return map[string]any{"locked": busy(d.Thread), "placeholder": promptPlaceholder(d)}
}

func promptPlaceholder(d ThreadData) string {
	if d.Thread.Status == domain.StatusAwaitingApproval {
		return "Answer the approval above, or send a follow-up…"
	}
	if busy(d.Thread) {
		return "Add a follow-up…"
	}
	if len(d.Items) == 0 {
		return "Describe what " + d.Thread.Agent + " should do in " + d.Project.Name + "…"
	}
	if d.Thread.Archived {
		return "Reply… (this brings the thread back from Settled)"
	}
	return "Reply…"
}

// sendTitle is the send button's tooltip. The key hint is only true on a
// hardware keyboard (see sendKey in layout.templ), which is also the only
// place a tooltip shows.
func sendTitle(busy bool) string {
	if busy {
		return "Send as the chip beside says (Enter); Ctrl+Enter does the other"
	}
	return "Send (Enter, or Ctrl+Enter)"
}

func promptSummary(body string) string {
	text, atts := splitAttachments(body)
	text = strings.TrimSpace(firstLine(text))
	if text == "" {
		if len(atts) == 1 {
			return atts[0].Name
		}
		if len(atts) > 1 {
			return fmt.Sprintf("%d attachments", len(atts))
		}
		return "Message"
	}
	r := []rune(text)
	if len(r) > 120 {
		return string(r[:117]) + "…"
	}
	return text
}

func promptPreview(body string) string {
	text, atts := splitAttachments(body)
	text = strings.TrimSpace(text)
	if text == "" {
		return promptSummary(body)
	}
	if len(atts) > 0 {
		text += fmt.Sprintf("\n%d %s", len(atts), plural(len(atts), "attachment", "attachments"))
	}
	r := []rune(text)
	if len(r) > 280 {
		return string(r[:277]) + "…"
	}
	return text
}

// snoozeButton is one of the header menu's snooze times; kind is what
// the layout's snoozeAt turns into a time.
// notifyButton picks the thread's notify level; the current one is
// marked.
templ notifyButton(d ThreadData, level, label, title string) {
	<button class={ "btn", "ghost", "tiny", templ.KV("dim", d.Notify != level), templ.KV("sel", d.Notify == level) } type="button" title={ title } data-on:click={ "@post('/api/threads/" + d.Thread.ID + "/notify?level=" + level + "')" }>{ label }</button>
}

templ snoozeButton(threadID, kind, label string) {
	<button class="btn ghost dim tiny" type="button" data-on:click={ "@post('/api/threads/" + threadID + "/snooze?until=' + encodeURIComponent(snoozeAt('" + kind + "')))" }>{ label }</button>
}

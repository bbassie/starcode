package views

import (
	"fmt"
	"starcode/internal/store"
	"strings"
)

type HomeData struct {
	// Projects are the reader's own, in the sidebar's order.
	Projects []store.Project
	Settings SettingsData
	// Stashed is how many prompts the stash holds.
	Stashed int
}

// Home is a new thread, like an empty chat: a question with the project
// in it over the composer that starts the thread with its first prompt.
// The project is picked in the question; with none picked the thread
// gets a folder of its own (App.CreateScratchThread).
templ Home(d HomeData) {
	<main id="main" class="home">
		<header id="mainhead" class="mainhead">
			<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
			<nav class="crumbs"><span>New thread</span></nav>
		</header>
		<div id="items" class="items">
			// The signals sit on the wrapper: the question over the form
			// reads $project too.
			<div class="items-inner home-inner" data-signals={ signalsJSON(d.Settings.Agent, d.Settings.Model, d.Settings.Effort, d.Settings.Mode, fmt.Sprintf("project: %q", firstProject(d.Projects))) }>
				@HomeHero(d.Projects)
				<form class="composer start" data-on:submit={ "evt.preventDefault(); @post('/api/threads', " + withSignal("_attach") + ")" }>
						<div class="prompt-box">
							<textarea
								class="prompt"
								rows="1"
								placeholder="Describe the task, or send nothing to just open a thread."
								data-bind:prompt
								data-on:keydown={ "sendKey(evt) && (evt.preventDefault(), @post('/api/threads', " + withSignal("_attach") + "))" }
								data-on:input__debounce.600ms={ draftPost("home") }
								data-effect="$prompt; autoGrow(el)"
								data-preserve-attr="style"
								autocomplete="off"
								autocapitalize="sentences"
								enterkeyhint="enter"
							></textarea>
							@StashPick("home", d.Stashed)
						</div>
						@AttachStrip()
						<div class="composer-row">
							@AttachButton()
							@Chips(d.Settings, "", false)
							<span class="spacer"></span>
							<button class="btn round primary" type="submit" title="Start thread">@Icon("arrow-up", "ui-icon")</button>
						</div>
				</form>
			</div>
		</div>
	</main>
}

// firstProject is the project the home composer starts on: the first in
// the sidebar's order, or none.
func firstProject(ps []store.Project) string {
	if len(ps) == 0 {
		return ""
	}
	return ps[0].ID
}

// HomeHero is the question over the home composer. With a project it
// asks what to build in it, the name a button that opens the project
// menu, and offers to start without one; with none it says so, and that
// opens the menu too. One .pick holds both, so the menu and pickLabel
// are shared.
templ HomeHero(projects []store.Project) {
	{{ first := firstProject(projects) }}
	// ?project= (the sidebar's new-thread button) picks that project the
	// way a click on its row would, defaults and all.
	<div class="pick home-hero" data-init="(id => id !== null && [...el.querySelectorAll('.opt[data-value]')].find((o) => o.dataset.value === id)?.click())(new URLSearchParams(location.search).get('project'))" data-on:click__outside="$pick == 'project' && !evt.target.closest('.home-hero') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		<h1 class="hero-title">
			<span data-show="$project != ''" data-preserve-attr="style" style={ hiddenUnless(first != "") }>What should we build in <button type="button" class="hero-proj" title="Pick the project" data-on:click={ pickToggle("project") } data-text="pickLabel(el, $project)">{ projectName(projects, first) }</button>?</span>
			<span data-show="$project == ''" data-preserve-attr="style" style={ hiddenUnless(first == "") }>What should we work on?</span>
		</h1>
		<p class="hero-sub">
			<button type="button" class="hero-link" data-show="$project != ''" data-preserve-attr="style" style={ hiddenUnless(first != "") } data-on:click="$project = ''; $pick = ''">or start without a project</button>
			<button type="button" class="hero-link strong" data-show="$project == ''" data-preserve-attr="style" style={ hiddenUnless(first == "") } data-on:click={ pickToggle("project") }>No project</button>
		</p>
		<div class="pick-menu hero-menu" data-show="$pick == 'project'" data-preserve-attr="style" style="display: none">
			<label class="pick-search">
				@Icon("search", "ui-icon")
				<input type="text" placeholder="Search projects…" data-bind:pickq autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off" enterkeyhint="done"/>
			</label>
			<div class="pick-list" role="listbox">
				<button type="button" class={ "opt", templ.KV("sel", first == "") } role="option" data-value="" data-short="No project" data-show="$pickq == ''" data-preserve-attr="style" data-class:sel="$project == ''" data-on:click={ pickSet("project", "", "") }>
					<span class="proj-init scratch">@Icon("message-square-dashed", "ui-icon")</span>
					<span class="opt-text"><span class="opt-name"><span class="ellipsis">No project</span></span></span>
					@Icon("check", "ui-icon opt-check")
				</button>
				for _, p := range projects {
					<button type="button" class={ "opt", templ.KV("sel", p.ID == first) } role="option" data-value={ p.ID } data-k={ strings.ToLower(p.Name + " " + p.Path) } data-show="$pickq == '' || el.dataset.k.includes($pickq.toLowerCase())" data-preserve-attr="style" data-class:sel={ "$project == " + jsq(p.ID) } data-on:click={ pickSet("project", p.ID, projectPicked(p)) } title={ p.Path }>
						@ProjMark(p, "")
						<span class="opt-text"><span class="opt-name"><span class="ellipsis">{ p.Name }</span></span></span>
						@Icon("check", "ui-icon opt-check")
					</button>
				}
				<button type="button" class="opt opt-custom" data-on:click="$pick = ''; $addproj = true; $nav = true">
					@Icon("folder-plus", "ui-icon opt-icon")
					<span class="opt-text"><span class="opt-name">Add project</span></span>
				</button>
			</div>
		</div>
	</div>
}

// FirstOr picks the default agent for new threads: the fake one when it
// is registered (that is a UI development run, and a real agent costs
// money), else claude, else the first.
func FirstOr(xs []string, def string) string {
	for _, want := range []string{"fake", "claude"} {
		for _, x := range xs {
			if x == want {
				return x
			}
		}
	}
	if len(xs) > 0 {
		return xs[0]
	}
	return def
}

// projectPicked is what picking a project in the home composer does
// besides naming it: a project with defaults of its own (Settings >
// Projects) sets the chips to them.
func projectPicked(p store.Project) string {
	if !p.HasDefaults() {
		return ""
	}
	return "$agent = " + jsq(p.Agent) + "; $model = " + jsq(p.Model) + "; $effort = " + jsq(p.Effort) + "; $mode = " + jsq(p.Mode)
}

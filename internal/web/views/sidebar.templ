package views

import (
	"fmt"
	"starcode/internal/domain"
	"starcode/internal/store"
	"strings"
	"time"
)

type SidebarData struct {
	Projects []store.Project
	Threads  []store.Thread // all threads, newest first
	Current  string         // current thread id
	Agents   []string
	Settings bool
	// Updates is how many agent CLIs have a newer release; shown as a
	// badge on the settings link.
	Updates int
	// Looks maps agent instance names to their driver and tag colour
	// (Settings > Providers) for the mark on thread rows.
	Looks map[string]AgentLook
	// Seen is when each thread was last on a screen; a thread with newer
	// activity is marked unread. Shared by every browser.
	Seen map[string]time.Time
}

// unread is whether t has activity since it was last looked at. A
// running thread is not marked: its row already shows movement. A thread
// never opened counts as unread, which is what a thread started from
// another device should look like.
func unread(t store.Thread, current string, seen map[string]time.Time) bool {
	if t.ID == current || active(t) {
		return false
	}
	at, ok := seen[t.ID]
	return !ok || t.UpdatedAt.After(at)
}

// AgentLook is what a row needs to draw an instance's mark.
type AgentLook struct {
	Driver string
	Color  string
	Label  string // display name, for the model picker's rail
}

// ago renders a compact relative age: 9m, 2d, 3w. The layout's clock
// script keeps it current with the same rules (see [data-ago]).
func ago(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return fmt.Sprintf("%dm", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh", int(d.Hours()))
	case d < 14*24*time.Hour:
		return fmt.Sprintf("%dd", int(d.Hours()/24))
	default:
		return fmt.Sprintf("%dw", int(d.Hours()/24/7))
	}
}

func active(t store.Thread) bool {
	return t.Status == domain.StatusRunning || t.Status == domain.StatusAwaitingApproval
}

// listed is whether a thread belongs in its project's list: archived
// threads move to the Archived section unless a turn is still running,
// which keeps them under Running until it ends.
func listed(t store.Thread) bool {
	return !t.Archived || active(t)
}

func searchKey(t store.Thread, p store.Project) string {
	return strings.ToLower(t.Title + " " + p.Name + " " + t.Agent)
}

templ Sidebar(d SidebarData) {
	{{ byID := map[string]store.Project{} }}
	for _, p := range d.Projects {
		{{ byID[p.ID] = p }}
	}
	<aside id="sidebar" data-class:open="$nav">
		<div class="side-brand">
			<a class="brand" href="/" title="Projects overview">@Icon("star", "brand-mark") starcode</a>
			<span class="spacer"></span>
			<button class="btn icon ghost" data-on:click="$nav = false" aria-label="Close navigation">@Icon("x", "ui-icon")</button>
		</div>
		<div class="side-search">
			<input class="in" type="search" placeholder="Filter threads" data-bind:q autocomplete="off"/>
			<button class="btn icon ghost" type="button" title="Search threads and messages, run a command (Ctrl+K)" aria-label="Search and commands" data-on:click="runHotkey('mod+k')">@Icon("command", "ui-icon")</button>
		</div>
		<div class="side-section">
			<span>All projects</span>
			<span class="spacer"></span>
			<button class="btn icon ghost" data-on:click="$addproj = !$addproj" title="Add project folder" aria-label="Add project folder">@Icon("folder-plus", "ui-icon")</button>
		</div>
		<form class="side-add" data-show="$addproj" data-preserve-attr="style" style="display: none" data-on:submit="evt.preventDefault(); @post('/api/projects'); $addproj = false">
			<input class="in project-path" type="text" placeholder="~/project or /absolute/path" data-bind:path list="project-paths" spellcheck="false"/>
			<button class="btn" type="submit">add</button>
		</form>
		<nav class="side-scroll">
			{{ hasActive := false }}
			for _, t := range d.Threads {
				if active(t) {
					{{ hasActive = true }}
				}
			}
			if hasActive {
				<div class="side-label">Running</div>
				<ul class="threads">
					for _, t := range d.Threads {
						if active(t) {
							@ThreadRow(t, byID[t.ProjectID], t.ID == d.Current, true, d.Looks[t.Agent], unread(t, d.Current, d.Seen))
						}
					}
				</ul>
			}
			for _, p := range d.Projects {
				<details class="project" open>
					<summary class="project-head">
						<span class="ellipsis" title={ p.Path }>{ p.Name }</span>
						<span class="spacer"></span>
						<button class="btn icon ghost tiny" data-on:click={ "evt.preventDefault(); @post('/api/projects/" + p.ID + "/threads')" } title="New thread">@Icon("plus", "ui-icon")</button>
						<button class="btn icon ghost tiny dim" data-on:click={ "evt.preventDefault(); confirm('Remove project " + p.Name + " from starcode? Files are not touched.') && @post('/api/projects/" + p.ID + "/remove')" } title="Remove project">@Icon("x", "ui-icon")</button>
					</summary>
					<ul class="threads">
						for _, t := range d.Threads {
							if t.ProjectID == p.ID && !active(t) && listed(t) {
								@ThreadRow(t, p, t.ID == d.Current, false, d.Looks[t.Agent], unread(t, d.Current, d.Seen))
							}
						}
					</ul>
				</details>
			}
			if len(d.Projects) == 0 {
				<p class="dim pad">No projects yet. Add a folder with the + above.</p>
			}
			{{ archived := 0 }}
			for _, t := range d.Threads {
				if t.Archived && !active(t) {
					{{ archived++ }}
				}
			}
			if archived > 0 {
				// Starts open when the reader is on one of these threads and
				// opens while they filter, so a match is never hidden; a morph
				// keeps whatever they set by clicking.
				<details class="project archived" open?={ currentArchived(d) } data-preserve-attr="open" data-effect="$q != '' && (el.open = true)">
					<summary class="project-head">
						<span class="ellipsis">Archived</span>
						<span class="dim tiny-text">{ fmt.Sprintf("%d", archived) }</span>
						<span class="spacer"></span>
					</summary>
					<ul class="threads">
						for _, t := range d.Threads {
							if t.Archived && !active(t) {
								@ThreadRow(t, byID[t.ProjectID], t.ID == d.Current, true, d.Looks[t.Agent], unread(t, d.Current, d.Seen))
							}
						}
					</ul>
				</details>
			}
		</nav>
		<div class="side-foot">
			<a class={ "side-settings", templ.KV("current", d.Settings) } href="/settings" data-on:click="$nav = false">
				@Icon("settings", "ui-icon")
				<span>Settings</span>
				if d.Updates > 0 {
					<span class="badge" title={ fmt.Sprintf("%d %s with an update available", d.Updates, plural(d.Updates, "provider", "providers")) }>{ fmt.Sprintf("%d", d.Updates) }</span>
				}
			</a>
		</div>
	</aside>
}

templ ThreadRow(t store.Thread, p store.Project, current bool, showProject bool, look AgentLook, isUnread bool) {
	<li
		class={ "thread-row", "st-" + t.Status, templ.KV("current", current), templ.KV("unread", isUnread) }
		data-id={ t.ID }
		data-k={ searchKey(t, p) }
		data-show="$q == '' || el.dataset.k.includes($q.toLowerCase())"
	>
		<a href={ templ.SafeURL("/threads/" + t.ID) } data-on:click="$nav = false">
			<span class={ "glyph", "st-" + t.Status }>@StatusIcon(t.Status)</span>
			<span class="thread-text">
				if showProject {
					<span class="dim tiny-text">{ p.Name }</span>
				}
				<span class="ellipsis">{ t.Title }</span>
			</span>
			<span class="dim tiny-text"><span class="agent-mark" style={ agentMarkStyle(look.Color) } title={ t.Agent }>@Brand(look.Driver, "ui-icon")</span> <span data-ago={ t.UpdatedAt.UTC().Format(time.RFC3339) }>{ ago(t.UpdatedAt) }</span></span>
		</a>
	</li>
}

// currentArchived is whether the thread on screen is in the Archived
// section, which then starts open.
func currentArchived(d SidebarData) bool {
	for _, t := range d.Threads {
		if t.ID == d.Current {
			return t.Archived && !active(t)
		}
	}
	return false
}

// agentMarkStyle colours the agent glyph with the instance's tag colour;
// untagged instances keep the dim text colour.
func agentMarkStyle(color string) string {
	if color == "" {
		return ""
	}
	return "color: " + color
}

package views

import (
	"fmt"
	"slices"
	"starcode/internal/agent"
	"strings"
)

// SettingsData feeds the model, effort and mode pickers. Caps is keyed by
// agent name; pickers for every agent are rendered (in Agents order, so a
// morph never swaps two agents' menus) and the ones for the selected agent
// are shown, so switching agents needs no round trip.
type SettingsData struct {
	Agents   []string
	Looks    map[string]AgentLook // driver, colour and name per agent, for the model picker
	Caps     map[string]agent.Capabilities
	CapsErrs map[string]error
	// Current values. They are rendered as the selected options so a morph
	// of the composer keeps the pickers in sync, and a model outside the
	// catalog still shows up.
	Agent, Model, Effort, Mode string
}

// Chips renders the setting pickers as a row of pills: model (with the
// agent rail inside its menu), reasoning effort and permission mode. Each
// is a button that opens a menu drawn in the page's own style; the page
// signal pick names the open menu and pickq holds the model search text
// (see pickKey and pickLabel in layout.templ). onChange is a Datastar
// action run after a choice (empty for none). The surrounding form owns
// the signals agent, model, effort and mode. The chips stay usable while a
// turn runs: the app applies what it can to the running turn and the rest
// to the next one.
templ Chips(d SettingsData, onChange string, agentLocked bool) {
	<div class="chips">
		for _, name := range d.Agents {
			{{ c, ok := d.Caps[name] }}
			@ModelPick(d, name, c, d.CapsErrs[name], onChange, agentLocked)
			if ok {
				@EffortPick(d, name, c, onChange)
				@ModePick(d, name, c, onChange)
			}
		}
	</div>
}

// pickAttrs are shared by every picker: shown for its agent, closed by a
// click elsewhere or Escape. A click inside any picker is left alone: the
// hidden pickers of the other agents see every click as outside, and the
// rail switches agents by making one of them the visible one.
func pickAttrs(d SettingsData, name, kind string) templ.Attributes {
	return templ.Attributes{
		"class":                  "pick pick-" + kind,
		"data-agent":             name,
		"data-show":              "$agent == " + jsq(name),
		"data-preserve-attr":     "style",
		"style":                  hiddenUnless(name == d.Agent),
		"data-on:click__outside": "$pick == '" + kind + "' && !evt.target.closest('.pick') && ($pick = '')",
		"data-on:keydown":        "pickKey(evt, el) && ($pick = '')",
	}
}

// pickToggle opens a menu (closing any other) and focuses its search box
// or selected entry; a second click closes it.
func pickToggle(kind string) string {
	return "$pickq = ''; $pick = $pick == '" + kind + "' ? '' : '" + kind + "'; $pick && pickFocus(el)"
}

// pickSet is an option's click: set the signal, close the menu, then run
// the form's action.
func pickSet(signal, value, onChange string) string {
	expr := "$" + signal + " = " + jsq(value) + "; $pick = ''"
	if onChange != "" {
		expr += "; " + onChange
	}
	return expr
}

// jsq quotes s for use inside a Datastar expression.
func jsq(s string) string { return fmt.Sprintf("%q", s) }

// JSQ is jsq for other packages.
func JSQ(s string) string { return jsq(s) }

// ModelPick is the model chip and its menu: a search box, the agent rail
// (when there is a choice to make) and the catalog of the agent shown,
// with the default first, the groups after, and a row that takes the
// typed text as a model id for anything outside the catalog. On a phone
// the effort and mode chips leave the composer row (CSS hides them) and
// two rows at the foot of this sheet open their menus instead, so the
// row under the prompt holds one chip, as T3 Code does it.
templ ModelPick(d SettingsData, name string, c agent.Capabilities, capsErr error, onChange string, agentLocked bool) {
	{{ look := d.Looks[name] }}
	<div { pickAttrs(d, name, "model")... }>
		<button type="button" class="chip" title="Model" data-on:click={ pickToggle("model") } data-class:open="$pick == 'model'">
			<span class="chip-icon" style={ agentMarkStyle(look.Color) }>@Brand(look.Driver, "ui-icon")</span>
			<span class="chip-label" data-text="pickLabel(el, $model)">{ modelLabel(c, d.Model, capsErr) }</span>
			@Icon("chevron-down", "ui-icon chip-caret")
		</button>
		<div class="pick-menu pick-models" data-show="$pick == 'model'" data-preserve-attr="style" style="display: none">
			<label class="pick-search">
				@Icon("search", "ui-icon")
				<input type="text" placeholder="Search models…" data-bind:pickq autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off" enterkeyhint="done"/>
			</label>
			<div class="pick-body">
				if !agentLocked && len(d.Agents) > 1 {
					<div class="pick-rail">
						for _, a := range d.Agents {
							<button type="button" class={ "pick-agent", templ.KV("sel", a == name) } title={ d.Looks[a].Label } style={ agentMarkStyle(d.Looks[a].Color) } data-on:click={ agentSet(a, DefaultMode(d.Caps[a]), onChange) }>@Brand(d.Looks[a].Driver, "ui-icon")</button>
						}
					</div>
				}
				<div class="pick-list" role="listbox">
					<div class="pick-head" data-show="$pickq == ''" data-preserve-attr="style">{ look.Label }</div>
					if capsErr != nil {
						<p class="pick-err">Catalog unavailable: { capsErr.Error() }</p>
					} else {
						@ModelOption(agent.Model{ID: "", DisplayName: "Default", Description: defaultModelDesc(c), ContextWindow: catalogWindow(c, "")}, defaultModelLabel(c), d.Model == "", onChange)
						for _, m := range c.Models {
							if m.ID != "" && m.ID != "default" && m.Group == "" {
								@ModelOption(m, "", m.ID == d.Model, onChange)
							}
						}
						if d.Model != "" && !hasModel(c, d.Model) {
							@ModelOption(agent.Model{ID: d.Model, DisplayName: d.Model, Description: "Typed in by hand"}, "", true, onChange)
						}
						for _, g := range modelGroups(c) {
							<div class="pick-group" data-show="$pickq == ''" data-preserve-attr="style">{ g }</div>
							for _, m := range c.Models {
								if m.Group == g {
									@ModelOption(m, "", m.ID == d.Model, onChange)
								}
							}
						}
					}
					<button type="button" class="opt opt-custom" data-show="$pickq.trim() != ''" data-preserve-attr="style" style="display: none" data-on:click={ customModelSet(onChange) }>
						@Icon("pencil", "ui-icon opt-icon")
						<span class="opt-text">
							<span class="opt-name"><span class="ellipsis">Use &quot;<span data-text="$pickq.trim()"></span>&quot; as the model id</span></span>
							<span class="opt-desc">Anything the CLI accepts, for example claude-fable-5</span>
						</span>
					</button>
				</div>
			</div>
			if _, ok := d.Caps[name]; ok {
				<div class="pick-more" data-show="$pickq == ''" data-preserve-attr="style">
					<button type="button" class="opt" data-on:click="$pick = 'effort'">
						@Icon("brain", "ui-icon opt-icon")
						<span class="opt-text"><span class="opt-name"><span>Reasoning effort</span></span></span>
						<span class="opt-desc" data-text="pickLabel(pickOf(el, 'effort', $agent), $effort)">{ effortShort(d.Effort) }</span>
						@Icon("chevron-right", "ui-icon opt-icon")
					</button>
					<button type="button" class="opt" data-on:click="$pick = 'mode'">
						@Icon("shield-check", "ui-icon opt-icon")
						<span class="opt-text"><span class="opt-name"><span>Permission mode</span></span></span>
						<span class="opt-desc" data-text="pickLabel(pickOf(el, 'mode', $agent), $mode)">{ modeShort(d.Mode) }</span>
						@Icon("chevron-right", "ui-icon opt-icon")
					</button>
				</div>
			}
		</div>
	</div>
}

// agentSet switches the rail: the other agent's menu takes over (it is
// shown for the same pick signal) with its own defaults, and the focus
// moves into it. mode is that agent's default permission mode.
func agentSet(name, mode, onChange string) string {
	expr := "$agent = " + jsq(name) + "; $model = ''; $effort = ''; $mode = " + jsq(mode) + "; $pickq = ''; pickFocus(el)"
	if onChange != "" {
		expr += "; " + onChange
	}
	return expr
}

func customModelSet(onChange string) string {
	expr := "$model = $pickq.trim(); $pick = ''"
	if onChange != "" {
		expr += "; " + onChange
	}
	return expr
}

// ModelOption is one catalog row. short, when set, is what the chip shows
// for it instead of the name. The row hides while the search text matches
// neither name, id nor description.
templ ModelOption(m agent.Model, short string, selected bool, onChange string) {
	<button
		type="button"
		class={ "opt", templ.KV("sel", selected) }
		role="option"
		data-value={ m.ID }
		if short != "" {
			data-short={ short }
		}
		data-k={ strings.ToLower(m.DisplayName + " " + m.ID + " " + m.Description) }
		data-show="$pickq == '' || el.dataset.k.includes($pickq.toLowerCase())"
		data-preserve-attr="style"
		data-class:sel={ "$model == " + jsq(m.ID) }
		data-on:click={ pickSet("model", m.ID, onChange) }
	>
		<span class="opt-text">
			<span class="opt-name">
				<span class="ellipsis">{ m.DisplayName }</span>
				if m.Default && m.ID != "" {
					<span class="opt-badge">default</span>
				}
			</span>
			if m.Description != "" {
				<span class="opt-desc" title={ m.Description }>{ m.Description }</span>
			}
		</span>
		if m.ContextWindow > 0 {
			<span class="opt-ctx" title={ windowLabel(m.ContextWindow) + " token context window" }>{ windowLabel(m.ContextWindow) }</span>
		}
		@Icon("check", "ui-icon opt-check")
	</button>
}

// EffortPick is the reasoning effort chip and its menu.
templ EffortPick(d SettingsData, name string, c agent.Capabilities, onChange string) {
	<div { pickAttrs(d, name, "effort")... }>
		<button type="button" class="chip" title="Reasoning effort" data-on:click={ pickToggle("effort") } data-class:open="$pick == 'effort'">
			<span class="chip-icon">@Icon("brain", "ui-icon")</span>
			<span class="chip-label" data-text="pickLabel(el, $effort)">{ effortShort(d.Effort) }</span>
			@Icon("chevron-down", "ui-icon chip-caret")
		</button>
		<div class="pick-menu" data-show="$pick == 'effort'" data-preserve-attr="style" style="display: none">
			<div class="pick-list" role="listbox">
				<div class="pick-head">Reasoning effort</div>
				for _, e := range c.Efforts {
					<button type="button" class={ "opt", templ.KV("sel", e.ID == d.Effort) } role="option" data-value={ e.ID } data-short={ effortShort(e.ID) } data-class:sel={ "$effort == " + jsq(e.ID) } data-on:click={ pickSet("effort", e.ID, onChange) }>
						<span class="opt-text"><span class="opt-name"><span>{ effortName(e) }</span></span></span>
						@Icon("check", "ui-icon opt-check")
					</button>
				}
			</div>
		</div>
	</div>
}

// ModePick is the permission mode chip and its menu; each row carries the
// agent's own explanation of the mode.
templ ModePick(d SettingsData, name string, c agent.Capabilities, onChange string) {
	<div { pickAttrs(d, name, "mode")... }>
		<button type="button" class="chip" title="Permission mode" data-on:click={ pickToggle("mode") } data-class:open="$pick == 'mode'" data-class:loose={ looseModes(c) }>
			<span class="chip-icon">@Icon("shield-check", "ui-icon")</span>
			<span class="chip-label" data-text="pickLabel(el, $mode)">{ modeShort(d.Mode) }</span>
			@Icon("chevron-down", "ui-icon chip-caret")
		</button>
		<div class="pick-menu pick-modes" data-show="$pick == 'mode'" data-preserve-attr="style" style="display: none">
			<div class="pick-list" role="listbox">
				<div class="pick-head">Permission mode</div>
				for _, m := range c.PermissionModes {
					<button type="button" class={ "opt", templ.KV("sel", m.ID == d.Mode) } role="option" data-value={ m.ID } data-short={ modeShort(m.ID) } data-class:sel={ "$mode == " + jsq(m.ID) } data-on:click={ pickSet("mode", m.ID, onChange) }>
						@Icon(modeIcon(m.ID), "ui-icon opt-icon")
						<span class="opt-text">
							<span class="opt-name"><span>{ modeName(m.ID) }</span></span>
							if desc := modeDesc(m); desc != "" {
								<span class="opt-desc">{ desc }</span>
							}
						</span>
						@Icon("check", "ui-icon opt-check")
					</button>
				}
			</div>
		</div>
	</div>
}

// hiddenUnless is the initial inline style for a data-show element: the
// server paints the state the signals will have, so Datastar finds nothing
// to change when it loads and the page does not jump. data-preserve-attr
// keeps the client's later decisions across morphs.
func hiddenUnless(shown bool) string {
	if shown {
		return ""
	}
	return "display: none"
}

func hasModel(c agent.Capabilities, id string) bool {
	for _, m := range c.Models {
		if m.ID == id {
			return true
		}
	}
	return false
}

// modelGroups lists the picker headings in first-seen order.
func modelGroups(c agent.Capabilities) []string {
	var groups []string
	for _, m := range c.Models {
		if m.Group != "" && !slices.Contains(groups, m.Group) {
			groups = append(groups, m.Group)
		}
	}
	return groups
}

// modelLabel is the chip text for the current model: its catalog name,
// the id itself for one typed in, or the default with what it resolves to.
func modelLabel(c agent.Capabilities, id string, capsErr error) string {
	if capsErr != nil {
		return "Catalog unavailable"
	}
	if id == "" {
		return defaultModelLabel(c)
	}
	for _, m := range c.Models {
		if m.ID == id {
			return m.DisplayName
		}
	}
	return id
}

func defaultModel(c agent.Capabilities) (agent.Model, bool) {
	for _, m := range c.Models {
		if m.Default {
			return m, true
		}
	}
	return agent.Model{}, false
}

func defaultModelLabel(c agent.Capabilities) string {
	m, ok := defaultModel(c)
	if !ok {
		return "Default model"
	}
	if m.ID == "default" || m.ID == "" {
		return "Default (" + firstSentence(m.Description) + ")"
	}
	return "Default (" + m.DisplayName + ")"
}

// defaultModelDesc explains the default row: what the agent picks when no
// model is set.
func defaultModelDesc(c agent.Capabilities) string {
	m, ok := defaultModel(c)
	if !ok {
		return "Whatever the agent picks when no model is set"
	}
	if m.ID == "default" || m.ID == "" {
		return m.Description
	}
	if m.Description == "" {
		return m.DisplayName
	}
	return m.DisplayName + " · " + m.Description
}

// effortName is the menu row for an effort level; effortShort the chip.
func effortName(e agent.Choice) string {
	switch e.ID {
	case "":
		return "Default"
	case "xhigh":
		return "Extra high"
	}
	return capitalize(e.Label)
}

func effortShort(id string) string {
	if id == "" {
		return "Default effort"
	}
	return effortName(agent.Choice{ID: id, Label: id})
}

// Permission modes come from the agents as ids with a one-line label of
// the form "id (explanation)". The rows show a readable name and the
// explanation; the chip shows the name.
func modeName(id string) string {
	switch id {
	case "":
		return "Default"
	case "acceptEdits":
		return "Accept edits"
	case "plan":
		return "Plan"
	case "dontAsk":
		return "Don't ask"
	case "bypassPermissions":
		return "Bypass permissions"
	case "untrusted":
		return "Untrusted"
	case "read-only":
		return "Read only"
	case "full-access":
		return "Full access"
	}
	return id
}

func modeShort(id string) string {
	if id == "" {
		return "Default mode"
	}
	return modeName(id)
}

func modeDesc(m agent.Choice) string {
	if i := strings.Index(m.Label, "("); i >= 0 {
		return capitalize(strings.TrimSuffix(strings.TrimSpace(m.Label[i+1:]), ")"))
	}
	if m.Label != m.ID && m.Label != "" && m.ID != "" {
		return m.Label
	}
	return ""
}

func modeIcon(id string) string {
	switch id {
	case "acceptEdits":
		return "file-pen"
	case "plan", "read-only":
		return "eye"
	case "dontAsk":
		return "shield-off"
	case "bypassPermissions", "full-access":
		return "lock-open"
	case "untrusted":
		return "shield-question"
	}
	return "shield-check"
}

// looseMode says whether a permission mode never asks. The ids are the
// agents' own: Claude's bypassPermissions, Codex's full-access, and the
// fake agent's yolo.
func looseMode(id string) bool {
	return id == "bypassPermissions" || id == "full-access" || id == "yolo"
}

// DefaultMode is the permission mode a new thread starts in: the agent's
// mode that never asks, when it has one. A console that runs coding agents
// unattended is the wrong place for a prompt on every edit; anyone who
// wants the prompts picks a stricter mode on the chip.
func DefaultMode(c agent.Capabilities) string {
	for _, m := range c.PermissionModes {
		if looseMode(m.ID) {
			return m.ID
		}
	}
	return ""
}

// looseModes is the chip's expression for the modes that never ask; the
// chip's icon takes the warning colour on them.
func looseModes(c agent.Capabilities) string {
	var parts []string
	for _, m := range c.PermissionModes {
		if looseMode(m.ID) {
			parts = append(parts, "$mode == "+jsq(m.ID))
		}
	}
	if len(parts) == 0 {
		return "false"
	}
	return strings.Join(parts, " || ")
}

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// firstSentence shortens "Opus 5 with 1M context · Best for…" to "Opus 5 1M".
func firstSentence(s string) string {
	for i, r := range s {
		if r == '·' || r == '.' {
			s = s[:i]
			break
		}
	}
	return strings.TrimSpace(strings.NewReplacer(" with ", " ", " context", "").Replace(s))
}

// signalsJSON builds the data-signals object for a settings form.
func signalsJSON(agentName, model, effort, mode string, extra string) string {
	s := fmt.Sprintf("{agent: %q, model: %q, effort: %q, mode: %q", agentName, model, effort, mode)
	if extra != "" {
		s += ", " + extra
	}
	return s + "}"
}

type SettingsPageData struct {
	Theme  string
	Themes []string
	// PairURL is a link that signs a phone in (the address with the
	// token in the query) and PairQR the same as a PNG data URL; both
	// empty when the instance has no token.
	PairURL string
	PairQR  string
	// Sidebar is this browser's list order ("inbox" or "project");
	// SettleMerged and SettleDays are the instance's settle settings.
	Sidebar      string
	SettleMerged bool
	SettleDays   int
}

// ThemeName is the display name of a theme id.
func ThemeName(theme string) string { return themeName(theme) }

func themeName(theme string) string {
	switch theme {
	case "ocean":
		return "Ocean"
	case "amber":
		return "Dusk"
	case "green":
		return "Forest"
	case "light":
		return "Light"
	default:
		return "Dark"
	}
}

// SettingsPage is General: how threads are listed and settled, this
// device's notifications, and the phone pairing link. The theme has a
// page of its own (AppearancePage), the way T3 Code splits them.
templ SettingsPage(d SettingsPageData) {
	<main id="main" class="settings-page">
		<header id="mainhead" class="mainhead">
			<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
			<nav class="crumbs"><span>Settings</span><span class="dim">/</span><span class="dim">General</span></nav>
		</header>
		<div class="settings-scroll">
			<div class="settings-shell">
				@SettingsNav("general")
				<div class="settings-content">
					<section id="threads" class="settings-section" data-signals={ fmt.Sprintf("{sidebar: %q, settleMerged: %t, settleDays: %d}", d.Sidebar, d.SettleMerged, d.SettleDays) }>
						<header>
							<h1>Threads</h1>
							<p class="dim">How the sidebar lists threads and when they settle.</p>
						</header>
						<div class="settings-card">
							<div class="setting-row">
								<div>
									<label for="sidebar-select">Sidebar</label>
									<p class="dim">Inbox is one list with the newest activity on top. By project groups threads under their project. Saved for this browser.</p>
								</div>
								<select id="sidebar-select" class="in" data-bind:sidebar data-on:change="@post('/api/sidebar')">
									<option value="inbox" selected?={ d.Sidebar != "project" }>Inbox</option>
									<option value="project" selected?={ d.Sidebar == "project" }>By project</option>
								</select>
							</div>
							<div class="setting-row">
								<div>
									<label for="settle-merged">Settle merged threads</label>
									<p class="dim">A thread settles when its pull request merges.</p>
								</div>
								<input id="settle-merged" type="checkbox" data-bind:settle-merged data-on:change="@post('/api/settle')"/>
							</div>
							<div class="setting-row">
								<div>
									<label for="settle-days">Settle inactive threads after</label>
									<p class="dim">Days without activity before a thread settles on its own; 0 keeps them. Any new activity brings a thread back.</p>
								</div>
								<span class="num-unit"><input id="settle-days" class="in num" type="number" min="0" max="365" step="1" inputmode="numeric" data-bind:settle-days data-on:change__debounce.500ms="@post('/api/settle')"/> <span class="dim">days</span></span>
							</div>
						</div>
					</section>
					<section id="device" class="settings-section">
						<header>
							<h1>This device</h1>
							<p class="dim">Notifications and VS Code on this browser, and signing a phone in.</p>
						</header>
						<div class="settings-card">
							<div class="setting-row">
								<div>
									<label for="notify-btn">Notifications</label>
									<p class="dim">A turn that ends or asks for an approval while starcode is out of sight posts a notification on this device. Needs the certificate installed (see the login page) or another secure context.</p>
								</div>
								// The state word comes from the layout's notify helpers;
								// the button asks for permission, then toggles.
								<button id="notify-btn" class="btn" type="button" data-init="el.dataset.state = notifyState(); el.textContent = notifyWord(el.dataset.state)" data-on:click="(el.dataset.state === 'on' ? Promise.resolve(notifyDisable()) : notifyEnable()).then((st) => { el.dataset.state = st; el.textContent = notifyWord(st) })">notifications</button>
							</div>
							<div class="setting-row">
								<div>
									<label for="vscode-host">VS Code SSH host</label>
									<p class="dim">The VS Code button on a thread opens its folder over Remote-SSH on this host, named the way this computer's ssh config knows it (user@host works). Empty means the account starcode runs as at the address in the browser, or a local folder when that address is localhost. Saved for this browser.</p>
								</div>
								<input id="vscode-host" class="in" type="text" autocomplete="off" spellcheck="false" autocapitalize="off" data-init="el.value = vscodeHost(); el.placeholder = vscodeLocal() ? 'opens locally' : vscodeDefaultHost()" data-preserve-attr="placeholder" data-on:input="vscodeHostSet(el.value)"/>
							</div>
							if d.PairURL != "" {
								<div class="setting-row pair-row">
									<div>
										<label>Pair a phone</label>
										<p class="dim">Scan this on the phone: the link carries the token, so there is nothing to type. Anyone with the link is signed in, so keep it to yourself.</p>
										<button class="btn" type="button" data-on:click={ "copyText(" + jsq(d.PairURL) + ", el)" }>@Icon("link", "ui-icon") copy the link</button>
									</div>
									<img class="pair-qr" src={ d.PairQR } alt="QR code of the sign-in link" width="180" height="180"/>
								</div>
							}
						</div>
					</section>
				</div>
			</div>
		</div>
	</main>
}

// AppearancePage is the theme, with a preview.
templ AppearancePage(d SettingsPageData) {
	<main id="main" class="settings-page">
		<header id="mainhead" class="mainhead">
			<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
			<nav class="crumbs"><span>Settings</span><span class="dim">/</span><span class="dim">Appearance</span></nav>
		</header>
		<div class="settings-scroll">
			<div class="settings-shell">
				@SettingsNav("appearance")
				<div class="settings-content">
					<section id="appearance" class="settings-section">
						<header>
							<h1>Appearance</h1>
							<p class="dim">Choose how Starcode looks on this browser.</p>
						</header>
						<div class="settings-card">
							<div class="setting-row">
								<div>
									<label for="theme-select">Theme</label>
									<p class="dim">Changes apply immediately and are saved for your next visit.</p>
								</div>
								<select id="theme-select" class="in theme-select" data-bind:theme data-on:change="@post('/api/theme')">
									for _, theme := range d.Themes {
										<option value={ theme } selected?={ theme == d.Theme }>{ themeName(theme) }</option>
									}
								</select>
							</div>
							<div class="appearance-preview" aria-hidden="true">
								<div class="appearance-preview-side">
									<span class="preview-dot"></span>
									<span></span><span></span><span></span>
								</div>
								<div class="appearance-preview-main">
									<div class="preview-line long"></div>
									<div class="preview-line"></div>
									<div class="preview-message"></div>
									<div class="preview-input"><span></span><i></i></div>
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>
		</div>
	</main>
}

// SettingsSidebar is the settings section list as a column of its own,
// next to the thread list. It sits outside the page content so it stays
// in place when one settings page is wider than the next. Narrow windows
// get SettingsNav instead, inside the content.
templ SettingsSidebar(current string) {
	<aside id="settingsnav">
		<div class="settingsnav-head">Settings</div>
		<nav class="settingsnav-list" aria-label="Settings sections">
			@settingsLinks(current)
		</nav>
	</aside>
}

// SettingsNav is the same links as a scrolling row above the content,
// shown when the window is too narrow for the settings column.
templ SettingsNav(current string) {
	<nav class="settings-menu" aria-label="Settings sections">
		@settingsLinks(current)
	</nav>
}

templ settingsLinks(current string) {
	<a class={ templ.KV("current", current == "general") } href="/settings">@Icon("settings", "ui-icon") General</a>
	<a class={ templ.KV("current", current == "appearance") } href="/settings/appearance">@Icon("palette", "ui-icon") Appearance</a>
	<a class={ templ.KV("current", current == "usage") } href="/settings/usage">@Icon("chart-no-axes-combined", "ui-icon") Usage</a>
	<a class={ templ.KV("current", current == "providers") } href="/settings/providers">@Icon("plug", "ui-icon") Providers</a>
	<a class={ templ.KV("current", current == "keys") } href="/settings/keys">@Icon("keyboard", "ui-icon") Keys</a>
}

// settingsSection maps a page view to the settings link that should be
// marked current; empty for pages outside settings.
func settingsSection(view string) string {
	switch view {
	case "settings":
		return "general"
	case "appearance", "usage", "providers", "keys":
		return view
	}
	return ""
}

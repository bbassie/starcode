package views

// Brand marks for the drivers: the Claude sunburst and the OpenAI flower,
// as published by Simple Icons (CC0), on the same 24-unit grid as the
// lucide icons so they sit in the same slots. The paths live in the
// sprite (sprite.go); anything else gets the generic bot.
templ Brand(driver string, class string) {
	switch driver {
		case "claude":
			<svg class={ "i", "b", class, "brand-claude" } width="16" height="16" viewBox="0 0 24 24" role="img" aria-label="Claude"><use href={ spriteRef("brand-claude") }></use></svg>
		case "codex":
			<svg class={ "i", "b", class, "brand-codex" } width="16" height="16" viewBox="0 0 24 24" role="img" aria-label="OpenAI"><use href={ spriteRef("brand-codex") }></use></svg>
		default:
			@Icon("bot", class)
	}
}

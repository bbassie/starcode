package views

import (
	"fmt"
	"net/url"
	"starcode/internal/agent"
	"time"
)

// LimitsRow is one instance's subscription windows for the Usage page.
type LimitsRow struct {
	Agent     string
	Look      AgentLook
	Windows   []agent.LimitWindow
	CheckedAt time.Time
	// Pending is a first read still under way; Unsupported an agent (or
	// an API-key account) with no windows to report; Err the last read's
	// failure, with the previous windows still shown.
	Pending     bool
	Unsupported bool
	Err         string
	// Resets is the plan's banked resets, nil when there are none.
	Resets *agent.ResetCredits
}

// LimitsSection heads the Usage page: how much of each plan's windows
// is used and when they reset, which answers "can I start another task"
// before the reset, where the cost chart cannot.
templ LimitsSection(rows []LimitsRow) {
	<section class="limits">
		<header class="limits-head">
			<h2>Plan limits</h2>
			<button class="btn icon ghost tiny" type="button" data-on:click="@post('/api/limits/refresh')" title="Read the limits again" aria-label="Refresh limits">@Icon("refresh-cw", "ui-icon")</button>
		</header>
		<div class="limits-grid">
			for _, r := range rows {
				<div class="limits-card">
					<div class="limits-name"><span class="agent-mark" style={ agentMarkStyle(r.Look.Color) }>@Brand(r.Look.Driver, "ui-icon")</span> <span>{ agentLabel(r) }</span></div>
					if len(r.Windows) > 0 {
						@LimitBars(r.Windows)
						if r.Resets != nil && r.Resets.Available > 0 {
							@bankedResets(r)
						}
						if r.Err != "" {
							<p class="dim tiny-text">last read failed: { r.Err }</p>
						}
					} else if r.Pending {
						<p class="dim tiny-text">reading…</p>
					} else if r.Unsupported {
						<p class="dim tiny-text">no plan windows to show</p>
					} else if r.Err != "" {
						<p class="err tiny-text">{ r.Err }</p>
					} else {
						<p class="dim tiny-text">no windows reported</p>
					}
				</div>
			}
		</div>
	</section>
}

// bankedResets is the line under a plan's bars when it holds banked
// resets, with the button that redeems the next one. Redeeming clears
// the windows at once, so it asks first.
templ bankedResets(r LimitsRow) {
	<div class="limit-resets">
		@Icon("rotate-ccw", "ui-icon")
		<span>{ fmt.Sprintf("%d banked %s", r.Resets.Available, plural(r.Resets.Available, "reset", "resets")) }</span>
		if !r.Resets.Expires.IsZero() {
			<span class="dim">· next lapses <time data-local={ r.Resets.Expires.UTC().Format(time.RFC3339) }>{ r.Resets.Expires.UTC().Format("Jan 2 15:04") }</time></span>
		}
		<span class="spacer"></span>
		<button class="btn tiny" type="button" data-indicator:_redeeming data-attr:disabled="$_redeeming" title="Use one banked reset: the plan's usage windows start over now" data-on:click={ "confirm(" + jsq("Use one of "+agentLabel(r)+"'s banked resets now? The usage windows start over, and the reset is spent.") + ") && @post('/api/limits/" + url.PathEscape(r.Agent) + "/redeem')" }>use one</button>
	</div>
}

func agentLabel(r LimitsRow) string {
	if r.Look.Label != "" {
		return r.Look.Label
	}
	return r.Agent
}

// LimitBars draws the windows: a label, a bar in the context meter's
// colours, the percentage and the reset. A tick on the bar marks the
// even pace, how much a steady rate would have used by now, when the
// window's length is known.
templ LimitBars(ws []agent.LimitWindow) {
	{{ now := time.Now() }}
	<div class="limit-bars">
		for _, w := range ws {
			{{ pct := int(w.Percent + 0.5) }}
			{{ pace, hasPace := w.Elapsed(now) }}
			<div class="limit-row" title={ limitTitle(w.Label, pct, pace, hasPace) }>
				<span class="limit-label ellipsis">{ w.Label }</span>
				<span class={ "ctx-track", "limit-track", contextLevel(pct) }>
					<span class="ctx-fill" style={ barWidth(pct) }></span>
					if hasPace {
						<span class="limit-pace" style={ fmt.Sprintf("left: %.1f%%", pace*100) }></span>
					}
				</span>
				<span class="limit-pct">{ fmt.Sprintf("%d%%", pct) }</span>
				<span class="dim limit-reset">{ resetsText(w.ResetsAt) }</span>
			</div>
		}
	</div>
}

// limitTitle is a bar's tooltip: the share used and, when known, how
// that compares with an even pace (within 5 points counts as on pace).
func limitTitle(label string, pct int, pace float64, hasPace bool) string {
	t := fmt.Sprintf("%s: %d%% used", label, pct)
	if !hasPace {
		return t
	}
	even := int(pace*100 + 0.5)
	switch gap := pct - even; {
	case gap > 5:
		return fmt.Sprintf("%s, ahead of the even pace (%d%%)", t, even)
	case gap < -5:
		return fmt.Sprintf("%s, under the even pace (%d%%)", t, even)
	}
	return fmt.Sprintf("%s, on the even pace (%d%%)", t, even)
}

// resetsText says when a window resets: "resets in 2h 10m" within a day,
// the weekday and time beyond that, nothing when unknown.
func resetsText(at time.Time) string {
	if at.IsZero() {
		return ""
	}
	d := time.Until(at)
	switch {
	case d <= 0:
		return "resetting"
	case d < time.Hour:
		return fmt.Sprintf("resets in %dm", int(d.Minutes())+1)
	case d < 24*time.Hour:
		return fmt.Sprintf("resets in %dh %02dm", int(d.Hours()), int(d.Minutes())%60)
	}
	return "resets " + at.Local().Format("Mon 15:04")
}

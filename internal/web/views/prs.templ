package views

import (
	"fmt"
	"sort"
	"starcode/internal/gitx"
	"starcode/internal/store"
	"strconv"
	"strings"
	"time"
)

// PRsPageData is the pull requests page: the signed-in user's pull
// requests and the others that concern them or sit in the repositories
// of their projects (gitx.PRBoard), the project each repository is added
// as (if it is), and the threads linked to each PR.
type PRsPageData struct {
	Board  gitx.PRBoard
	Err    string
	At     time.Time
	Loaded bool
	// Repos maps "owner/name" to the project whose origin points at it.
	Repos map[string]store.Project
	// Threads lists the threads linked to each PR, newest first.
	Threads map[store.PR][]store.Thread
}

// PRsPage lists the pull requests in two groups, Authored and Others,
// under a search box and Sort and Filters menus, like T3 Code's. A row
// opens the PR beside the list (over it on a phone). The filters and the
// order are the browser's (prsApply in the layout), over every row the
// page has, open and done.
templ PRsPage(d PRsPageData) {
	<main id="main" class="prs-page">
		<header id="mainhead" class="mainhead">
			<button class="btn icon ghost navtoggle" data-on:click="$nav = !$nav" aria-label="Toggle navigation">@Icon("menu", "ui-icon")</button>
			<nav class="crumbs"><span>Pull requests</span></nav>
			<span class="spacer"></span>
			if !d.At.IsZero() {
				<span class="dim tiny-text hide-sm" title="When the lists were last read from GitHub">updated <span data-ago={ d.At.UTC().Format(time.RFC3339) }>{ ago(d.At) }</span></span>
			}
		</header>
		<div class="prs-split" data-class:open="$prsel">
			<section class="prs-listpane">
				<div class="prs-inner">
					<div class="prs-toolbar">
						<label class="prs-search">
							@Icon("search", "ui-icon")
							<input type="search" placeholder="Search pull requests, or label:bug" data-bind:prq autocomplete="off" spellcheck="false" autocapitalize="off" enterkeyhint="search"/>
						</label>
						@prSortMenu()
						@PRFilterMenu(d)
						<button class="btn icon prs-tool" data-on:click="@query('/api/prs')" title="Read the lists again, and the state of every linked pull request" aria-label="Refresh">@Icon("refresh-cw", "ui-icon")</button>
					</div>
					@PRsList(d)
				</div>
			</section>
			<section class="prs-detailpane">
				@PRPageDetail(PRDetailData{Page: true})
			</section>
		</div>
	</main>
}

// prSorts are the orders the Sort menu offers, as T3 Code's.
var prSorts = []struct{ Value, Label, Icon string }{
	{"ready", "Merge readiness", "list-checks"},
	{"blocked", "Blocked on me", "user"},
	{"updated", "Recently updated", "clock"},
	{"newest", "Newest shown", "calendar-arrow-down"},
	{"oldest", "Oldest shown", "calendar-arrow-up"},
	{"largest", "Largest shown", "maximize-2"},
	{"smallest", "Smallest shown", "minimize-2"},
}

templ prSortMenu() {
	<div class="pick prs-pick" data-on:click__outside="$pick == 'prsort' && !evt.target.closest('.pick') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		<button type="button" class="btn prs-tool chip" data-on:click={ pickToggle("prsort") } data-class:open="$pick == 'prsort'" title="Order the list">@Icon("arrow-down-up", "ui-icon") <span class="hide-xs">Sort</span></button>
		<div class="pick-menu prs-menu" data-show="$pick == 'prsort'" data-preserve-attr="style" style="display: none">
			<div class="pick-list" role="listbox">
				for _, o := range prSorts {
					<button type="button" class={ "opt", templ.KV("sel", o.Value == "ready") } role="option" data-value={ o.Value } data-class:sel={ "$prsort == " + jsq(o.Value) } data-on:click={ pickSet("prsort", o.Value, "") }>
						@Icon(o.Icon, "ui-icon opt-icon")
						<span class="opt-text"><span class="opt-name">{ o.Label }</span></span>
						@Icon("check", "ui-icon opt-check")
					</button>
				}
			</div>
		</div>
	</div>
}

// prChoice is one value of a filter: what the signal holds and the label.
type prChoice struct{ Value, Label string }

// prFilter is one row of the Filters menu: its signal, icon and values,
// the first being "no filter".
type prFilter struct {
	Key, Label, Icon string
	Choices          []prChoice
}

func prFilters(d PRsPageData) []prFilter {
	fs := []prFilter{
		{"prstate", "State", "git-pull-request", []prChoice{{"open", "Open"}, {"merged", "Merged"}, {"closed", "Closed"}, {"all", "All"}}},
		{"prinv", "Involvement", "layers", []prChoice{{"", "All"}, {"review", "Review requested"}, {"assigned", "Assigned"}, {"involved", "Commented or mentioned"}, {"repo", "In my projects"}}},
	}
	authors := []prChoice{{"", "Anyone"}}
	for _, a := range prCounted(d, func(p gitx.BoardPR) []string { return []string{p.Author} }) {
		authors = append(authors, prChoice{a, a})
	}
	labels := []prChoice{{"", "Any"}}
	for _, l := range prCounted(d, func(p gitx.BoardPR) []string { return p.Labels }) {
		labels = append(labels, prChoice{l, l})
	}
	fs = append(fs,
		prFilter{"prauthor", "Author", "user", authors},
		prFilter{"prlabel", "Labels", "tag", labels},
		prFilter{"prdraft", "Draft", "git-pull-request-draft", []prChoice{{"", "All"}, {"draft", "Drafts"}, {"ready", "Ready for review"}}},
		prFilter{"prreview", "Review", "eye", []prChoice{{"", "All"}, {"approved", "Approved"}, {"changes_requested", "Changes requested"}, {"rereview_requested", "Re-review requested"}, {"review_required", "Review required"}, {"none", "No review"}}},
		prFilter{"prchecks", "Checks", "circle-check", []prChoice{{"", "All"}, {"success", "Passing"}, {"failure", "Failing"}, {"pending", "Running"}, {"none", "None"}}},
	)
	projects := []prChoice{{"", "All projects"}}
	seen := map[string]bool{}
	for _, p := range d.Repos {
		if !seen[p.ID] {
			seen[p.ID] = true
			projects = append(projects, prChoice{p.ID, p.Name})
		}
	}
	sort.Slice(projects[1:], func(i, j int) bool { return projects[i+1].Label < projects[j+1].Label })
	projects = append(projects, prChoice{"none", "Not a project"})
	return append(fs, prFilter{"prfproj", "Project", "folder", projects})
}

// prCounted is every value of(p) over the page's PRs, most frequent
// first, for the author and label filters.
func prCounted(d PRsPageData, of func(gitx.BoardPR) []string) []string {
	n := map[string]int{}
	for _, p := range d.Board.PRs {
		for _, v := range of(p) {
			if v != "" {
				n[v]++
			}
		}
	}
	out := make([]string, 0, len(n))
	for v := range n {
		out = append(out, v)
	}
	sort.Slice(out, func(i, j int) bool {
		if n[out[i]] != n[out[j]] {
			return n[out[i]] > n[out[j]]
		}
		return strings.ToLower(out[i]) < strings.ToLower(out[j])
	})
	return out
}

// prChoiceLabels is a JS object from value to label, for the menu row
// that names the filter's current value.
func prChoiceLabels(f prFilter) string {
	var b strings.Builder
	b.WriteString("({")
	for i, c := range f.Choices {
		if i > 0 {
			b.WriteString(", ")
		}
		b.WriteString(jsq(c.Value) + ": " + jsq(c.Label))
	}
	b.WriteString("})[$" + f.Key + "] ?? $" + f.Key)
	return b.String()
}

// PRFilterMenu is the Filters button: a list of the filters, each with
// its current value, that opens on its values in place (prfmenu names
// the open one). It is redrawn with the list, since the authors and
// labels come from the rows.
templ PRFilterMenu(d PRsPageData) {
	<div id="prs-filters" class="pick prs-pick" data-on:click__outside="$pick == 'prfilter' && !evt.target.closest('.pick') && ($pick = '')" data-on:keydown="pickKey(evt, el) && ($pick = '')">
		<button type="button" class="btn prs-tool chip" data-on:click={ "$prfmenu = ''; " + pickToggle("prfilter") } data-class:open="$pick == 'prfilter'" data-class:on="prsFiltered($prinv, $prauthor, $prlabel, $prdraft, $prreview, $prchecks, $prfproj, $prstate)" title="Filter the list">@Icon("list-filter", "ui-icon") <span class="hide-xs">Filters</span></button>
		<div class="pick-menu prs-menu prs-filter-menu" data-show="$pick == 'prfilter'" data-preserve-attr="style" style="display: none">
			<div class="pick-list" role="listbox" data-show="$prfmenu == ''" data-preserve-attr="style">
				for i, f := range prFilters(d) {
					if i == 2 || i == len(prFilters(d))-1 {
						<div class="prs-menu-rule"></div>
					}
					<button type="button" class="opt" data-on:click={ "$prfmenu = " + jsq(f.Key) }>
						@Icon(f.Icon, "ui-icon opt-icon")
						<span class="opt-text"><span class="opt-name">{ f.Label }</span></span>
						<span class="opt-ctx ellipsis" data-text={ prChoiceLabels(f) }>{ f.Choices[0].Label }</span>
						@Icon("chevron-right", "ui-icon opt-icon")
					</button>
				}
			</div>
			for _, f := range prFilters(d) {
				<div class="pick-list" role="listbox" data-show={ "$prfmenu == " + jsq(f.Key) } data-preserve-attr="style" style="display: none">
					<button type="button" class="opt prs-menu-back" data-on:click="$prfmenu = ''">
						@Icon("arrow-left", "ui-icon opt-icon")
						<span class="opt-text"><span class="opt-name">{ f.Label }</span></span>
					</button>
					for _, c := range f.Choices {
						<button type="button" class="opt" role="option" data-value={ c.Value } data-class:sel={ "$" + f.Key + " == " + jsq(c.Value) } data-on:click={ "$" + f.Key + " = " + jsq(c.Value) + "; $prfmenu = ''" }>
							if f.Key == "prauthor" && c.Value != "" {
								@prAvatar(prAvatarOf(d, c.Value))
							}
							<span class="opt-text"><span class="opt-name ellipsis">{ c.Label }</span></span>
							@Icon("check", "ui-icon opt-check")
						</button>
					}
				</div>
			}
		</div>
	</div>
}

// prAvatarOf is the avatar of an author on the page.
func prAvatarOf(d PRsPageData, login string) string {
	for _, p := range d.Board.PRs {
		if p.Author == login && p.Avatar != "" {
			return p.Avatar
		}
	}
	return ""
}

templ prAvatar(url string) {
	if url != "" {
		<img class="pr-avatar" src={ url } alt="" loading="lazy"/>
	} else {
		<span class="pr-avatar">@Icon("user", "ui-icon")</span>
	}
}

// PRsList is the two groups; patched on its own so a redraw does not
// close a PR that is open in the detail.
templ PRsList(d PRsPageData) {
	<div id="prpage-list" class="prpage-list" data-effect="$prv; $mainv; prsApply(el, $prq, $prstate, $prinv, $prauthor, $prlabel, $prdraft, $prreview, $prchecks, $prfproj, $prsort)">
		if d.Err != "" {
			<p class="dim pad">{ d.Err }</p>
			<p class="dim pad tiny-text">Reading the pull requests from GitHub failed; the refresh button tries again. The page needs the GitHub CLI (gh) on PATH and signed in.</p>
		} else if !d.Loaded {
			@prSkeleton()
		} else {
			@prGroup("Authored", "pencil", true, d)
			@prGroup("Others", "users", false, d)
			<p class="dim prs-none" hidden>No pull requests match.</p>
		}
	</div>
}

// prSkeleton stands in for the list while GitHub is read: a group head
// and rows the shape of real ones, so the page is there at once and the
// list lands in place.
templ prSkeleton() {
	<div class="prs-skeleton" aria-busy="true" aria-label="Loading pull requests">
		<header class="prs-group-head">@Icon("pencil", "ui-icon") <span>Authored</span></header>
		for _, w := range []int{62, 48, 70, 40, 56, 66, 44, 58} {
			<div class="prb-main">
				<span class="sk sk-dot"></span>
				<span class="prb-text">
					<span class="sk" style={ fmt.Sprintf("width: %d%%", w) }></span>
					<span class="sk sk-sub" style={ fmt.Sprintf("width: %d%%", w/2+10) }></span>
				</span>
				<span class="prb-side"><span class="sk sk-side"></span><span class="sk sk-side short"></span></span>
			</div>
		}
	</div>
}

templ prGroup(title, icon string, mine bool, d PRsPageData) {
	<section class="prs-group">
		<header class="prs-group-head">@Icon(icon, "ui-icon") <span>{ title }</span> <span class="prs-count"></span></header>
		<ul class="prs prs-rows">
			for _, pr := range d.Board.PRs {
				if pr.Mine() == mine {
					@prRow(pr, d)
				}
			}
		</ul>
	</section>
}

// prRow is one PR: its state, number, title and checks, then the
// author and repository; its size and age on the right. The data
// attributes are what prsApply filters and sorts on.
templ prRow(pr gitx.BoardPR, d PRsPageData) {
	{{ p, known := d.Repos[pr.Repo] }}
	{{ key := pr.Repo + "#" + strconv.Itoa(pr.Number) }}
	<li
		class="prb-row"
		data-k={ strings.ToLower(pr.Repo + " #" + strconv.Itoa(pr.Number) + " " + pr.Title + " " + pr.Author + " " + pr.Head) }
		data-state={ pr.State }
		data-inv={ pr.Involve }
		data-author={ pr.Author }
		data-repo={ strings.ToLower(pr.Repo) }
		data-labels={ strings.ToLower("," + strings.Join(pr.Labels, ",") + ",") }
		data-draft={ prDraftWord(pr) }
		data-review={ prReviewWord(pr) }
		data-checks={ prChecksWord(pr) }
		data-proj={ prProjectOf(p, known) }
		data-ready={ strconv.Itoa(prReadiness(pr)) }
		data-blocked={ strconv.FormatBool(prBlocksMe(pr)) }
		data-updated={ strconv.FormatInt(pr.UpdatedAt.Unix(), 10) }
		data-created={ strconv.FormatInt(pr.CreatedAt.Unix(), 10) }
		data-size={ strconv.Itoa(pr.Additions + pr.Deletions) }
		data-class:current={ "$prsel && $prkey == " + jsq(key) }
	>
		<a class="prb-main" href={ templ.SafeURL(pr.URL) } title={ pr.Head + " → " + pr.Base } data-on:click={ "evt.preventDefault(); $prkey = " + jsq(key) + "; @query('/api/prs/" + pr.Repo + "/" + strconv.Itoa(pr.Number) + "')" }>
			<span class={ "pr-mark", prStateClass(pr) } title={ prStateTitle(pr) }>@Icon(prStateIcon(pr), "ui-icon")</span>
			<span class="prb-text">
				<span class="prb-line">
					<span class="mono dim prb-num">#{ strconv.Itoa(pr.Number) }</span>
					<span class="prb-title ellipsis">{ pr.Title }</span>
					@prChecksMark(pr.Checks)
					if pr.Involve == "review" {
						<span class="prb-flag warn" title="A review is asked of you">@Icon("eye", "ui-icon")</span>
					}
				</span>
				<span class="prb-line dim tiny-text">
					@prAvatar(pr.Avatar)
					<span class="prb-author">{ pr.Author }</span>
					<span class="ellipsis">{ pr.Repo }</span>
					if pr.Comments > 0 {
						<span class="prb-comments" title={ fmt.Sprintf("%d %s", pr.Comments, plural(pr.Comments, "comment", "comments")) }>@Icon("message-square", "ui-icon") <span>{ strconv.Itoa(pr.Comments) }</span></span>
					}
				</span>
			</span>
			<span class="prb-side">
				<span class="mono prb-size"><span class="ok">+{ prCount(pr.Additions) }</span> <span class="err">-{ prCount(pr.Deletions) }</span></span>
				<span class="dim prb-age" data-ago={ pr.UpdatedAt.UTC().Format(time.RFC3339) }>{ ago(pr.UpdatedAt) }</span>
			</span>
		</a>
	</li>
}

templ prChecksMark(checks string) {
	switch checks {
		case "success":
			<span class="prb-check ok" title="Checks passed">@Icon("circle-check", "ui-icon")</span>
		case "failure":
			<span class="prb-check err" title="Checks failed">@Icon("circle-x", "ui-icon")</span>
		case "pending":
			<span class="prb-check warn" title="Checks running">@Icon("circle-dot", "ui-icon")</span>
	}
}

// prCount writes a line count with a thin separator per thousand.
func prCount(n int) string {
	s := strconv.Itoa(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "." + s[i:]
	}
	return s
}

func prStateIcon(pr gitx.BoardPR) string {
	switch {
	case pr.State == "merged":
		return "git-merge"
	case pr.State == "closed":
		return "git-pull-request-closed"
	case pr.Draft:
		return "git-pull-request-draft"
	}
	return "git-pull-request"
}

func prStateClass(pr gitx.BoardPR) string {
	switch {
	case pr.State == "merged":
		return "merged"
	case pr.State == "closed":
		return "err"
	case pr.Draft:
		return "dim"
	}
	return "ok"
}

func prStateTitle(pr gitx.BoardPR) string {
	if pr.State == "open" && pr.Draft {
		return "Draft"
	}
	return strings.ToUpper(pr.State[:1]) + pr.State[1:]
}

func prDraftWord(pr gitx.BoardPR) string {
	if pr.Draft {
		return "draft"
	}
	return "ready"
}

func prReviewWord(pr gitx.BoardPR) string {
	if pr.Review == "" {
		return "none"
	}
	return pr.Review
}

func prChecksWord(pr gitx.BoardPR) string {
	if pr.Checks == "" {
		return "none"
	}
	return pr.Checks
}

func prProjectOf(p store.Project, known bool) string {
	if !known {
		return "none"
	}
	return p.ID
}

// prReadiness ranks a PR for the "Merge readiness" order, lowest first:
// open and ready to merge, then waiting on a review or on checks, then
// with failing checks or changes asked for, then drafts, then done.
func prReadiness(pr gitx.BoardPR) int {
	switch {
	case pr.State != "open":
		return 5
	case pr.Draft:
		return 4
	case pr.Checks == "failure" || pr.Review == "changes_requested":
		return 3
	case pr.Review == "approved" && pr.Checks != "pending":
		return 0
	case pr.Review == "approved":
		return 1
	}
	return 2
}

// prBlocksMe is whether an open PR waits on the signed-in user: a review
// asked of them, or on one of theirs changes asked for, checks failing,
// or everything green and nothing left but the merge.
func prBlocksMe(pr gitx.BoardPR) bool {
	if pr.State != "open" {
		return false
	}
	if pr.Involve == "review" {
		return true
	}
	return pr.Mine() && (pr.Review == "changes_requested" || pr.Checks == "failure" || (!pr.Draft && pr.Review == "approved" && pr.Checks != "pending"))
}

// PRPageDetail is one PR opened from the list, in the same shape as the
// panel's detail with T3 Code's head: the repository and number, the
// title, who and when, the branches and the size, then Summary and
// Timeline tabs (PRDetailBody, Page set).
templ PRPageDetail(d PRDetailData) {
	<div id="prpage-detail" class="pr-detail prpage-detail" data-show="$prsel" data-preserve-attr="style" style="display: none">
		<div class="prd-bar">
			<button class="btn icon ghost" data-on:click="$prsel = 0; $prkey = ''" title="Close" aria-label="Close the pull request">@Icon("x", "ui-icon")</button>
			if d.Loaded {
				if d.Detail.URL != "" {
					<a class="dim ellipsis prd-repo" href={ templ.SafeURL(d.Detail.URL) } target="_blank" rel="noopener" title="Open on GitHub">{ d.Repo } <span class="mono">#{ strconv.Itoa(d.Detail.Number) }</span> @Icon("external-link", "ui-icon")</a>
				} else {
					<span class="dim ellipsis prd-repo">{ d.Repo } <span class="mono">#{ strconv.Itoa(d.Detail.Number) }</span></span>
				}
				<span class="spacer"></span>
				for _, t := range d.Threads {
					<a class="pr-thread" href={ templ.SafeURL("/threads/" + t.ID) } title={ "Thread linked to this pull request: " + t.Title }>
						<span class={ "glyph", "st-" + t.Status }>@StatusIcon(t.Status)</span>
						<span class="ellipsis">{ t.Title }</span>
					</a>
				}
				<button class="btn icon ghost" data-on:click={ "@query('" + d.Base + "?refresh=1')" } title="Refresh" aria-label="Refresh">@Icon("refresh-cw", "ui-icon")</button>
			}
		</div>
		@PRDetailBody(d)
	</div>
}

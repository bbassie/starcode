package views

import (
	"strconv"
	"starcode/internal/gitx"
	"starcode/internal/store"
	"strings"
)

type GitData struct {
	Project  store.Project
	Status   gitx.Status
	Selected string // path whose diff is shown
	Diff     string
	ThreadID string
}

templ GitPanel(d GitData) {
	<aside id="gitpanel" data-class:open="$git">
		@GitHeader(d)
		@GitFiles(d)
		@GitDetail(d)
	</aside>
}

templ GitHeader(d GitData) {
	<div id="git-head" class="side-head">
		<span>Changes</span>
		<span class="spacer"></span>
		if d.Status.IsRepo {
			<span class="dim">@Icon("git-branch", "ui-icon") { d.Status.Branch }</span>
			if d.Status.Summary != "" {
				<span class="mono">{ d.Status.Summary }</span>
			}
		}
		if d.Project.ID != "" {
			<button class="btn icon ghost tiny" data-on:click={ "@get('/api/git/" + d.Project.ID + "/refresh')" } title="Refresh">@Icon("refresh-cw", "ui-icon")</button>
		}
		<button class="btn icon ghost tiny" data-on:click="$git = false" title="Close" aria-label="Close changes panel">@Icon("x", "ui-icon")</button>
	</div>
}

templ GitFiles(d GitData) {
	<div id="git-files">
		if d.Project.ID == "" {
			<p class="dim pad">open a thread to see its project's changes.</p>
		} else if !d.Status.IsRepo {
			<p class="dim pad">{ d.Project.Path } is not a git repository.</p>
		} else if len(d.Status.Files) == 0 {
			<p class="dim pad">working tree clean.</p>
		} else {
			<ul class="files">
				for _, f := range d.Status.Files {
					<li data-class:current={ "$gitPath === " + strconv.Quote(f.Path) }>
						<a href="#" data-on:click={ "evt.preventDefault(); $gitPath = " + strconv.Quote(f.Path) + "; $gitEdit = false; @get('/api/git/" + d.Project.ID + "/diff?path=" + urlQuery(f.Path) + "')" }>
							<span class={ "code", statusClass(f.Status) }>{ strings.TrimSpace(f.Status) }</span>
							<span class="ellipsis">{ f.Path }</span>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

templ GitDetail(d GitData) {
	<div id="git-detail">
		if d.Selected != "" {
			<div class="diff-head mono ellipsis">{ d.Selected }</div>
			<div class="git-detail-actions">
				<button class="btn tiny" data-show="!$gitEdit" data-on:click={ "@get('/api/git/" + d.Project.ID + "/file?path=" + urlQuery(d.Selected) + "')" }>@Icon("pencil", "ui-icon") edit</button>
			</div>
			<form class="git-editor" data-show="$gitEdit" data-on:submit={ "evt.preventDefault(); @post('/api/git/" + d.Project.ID + "/file?path=" + urlQuery(d.Selected) + "')" }>
				<textarea class="file-editor" data-bind:file spellcheck="false"></textarea>
				<div class="git-editor-actions">
					<button class="btn primary" type="submit">@Icon("save", "ui-icon") save</button>
					<button class="btn" type="button" data-on:click="$gitEdit = false; $file = ''">cancel</button>
				</div>
			</form>
			if d.Diff != "" {
				<pre class="diff" data-show="!$gitEdit">
					for _, line := range strings.Split(strings.TrimRight(d.Diff, "\n"), "\n") {
						<span class={ diffClass(line) }>{ line }</span>
						{ "\n" }
					}
				</pre>
			} else {
				<p class="dim pad" data-show="!$gitEdit">no diff to show.</p>
			}
		}
	</div>
}

func statusClass(s string) string {
	switch strings.TrimSpace(s) {
	case "??", "A":
		return "ok"
	case "D":
		return "err"
	}
	return "warn"
}

func diffClass(line string) string {
	switch {
	case strings.HasPrefix(line, "+++"), strings.HasPrefix(line, "---"):
		return "dim"
	case strings.HasPrefix(line, "+"):
		return "add"
	case strings.HasPrefix(line, "-"):
		return "del"
	case strings.HasPrefix(line, "@@"):
		return "hunk"
	case strings.HasPrefix(line, "diff "), strings.HasPrefix(line, "index "):
		return "dim"
	}
	return ""
}

func urlQuery(s string) string {
	r := strings.NewReplacer("%", "%25", "&", "%26", "#", "%23", "+", "%2B", " ", "%20", "'", "%27", "?", "%3F")
	return r.Replace(s)
}
